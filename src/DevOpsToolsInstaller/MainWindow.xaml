<Window
    x:Class="DevOpsToolsInstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:customControls="using:DevOpsToolsInstaller.Controls">

    <!-- No Background set: the Mica backdrop shows through. -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="CommandPalette_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Built-in WinUI TitleBar control (Windows App SDK 2.x): handles the
             icon, title, drag regions and caption-button spacing automatically. -->
        <controls:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="DevOps Tools Installer" Subtitle="v3.0.2">
            <controls:TitleBar.IconSource>
                <controls:ImageIconSource x:Name="AppTitleBarIconSource" ImageSource="ms-appx:///Assets/app.png" />
            </controls:TitleBar.IconSource>
            <controls:TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <AutoSuggestBox x:Name="NavSearchBox"
                                    Width="300"
                                    QueryIcon="Find"
                                    PlaceholderText="Search tools... (Ctrl+K)"
                                    QuerySubmitted="NavSearchBox_QuerySubmitted"
                                    TextChanged="NavSearchBox_TextChanged"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Global tool search" />
                    <Button x:Name="LogDrawerToggleBtn"
                            Click="LogDrawerToggleBtn_Click"
                            ToolTipService.ToolTip="Toggle live log drawer (Ctrl+`)"
                            AutomationProperties.Name="Toggle live activity log drawer"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                            <TextBlock Text="Logs" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:TitleBar.Content>
        </controls:TitleBar>

        <!-- Navigation + content -->
        <controls:NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTabStop="False"
            SelectionChanged="NavView_SelectionChanged"
            OpenPaneLength="250">

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="Home" Tag="Home">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Tool Catalog" Tag="Catalog">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Stacks" Tag="Stacks">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="InstalledNavItem" Content="Installed" Tag="Installed">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Doctor" Tag="Doctor">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Downloads" Tag="Downloads">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem Content="Settings" Tag="Settings">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="About" Tag="About">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>

            <!-- Content host: a rounded, layered surface over the Mica backdrop -->
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="10,0,0,0"
                Margin="0,0,0,0">
                <Grid x:Name="ContentHostGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame x:Name="ContentFrame" Grid.Row="0" Background="Transparent">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                    </Frame>
                    <customControls:LogDrawerControl x:Name="BottomLogDrawer" Grid.Row="1" />
                </Grid>
            </Border>
        </controls:NavigationView>
    </Grid>
</Window>
