<Page
    x:Class="DevOpsToolsInstaller.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="32,28,32,36">
        <StackPanel Spacing="22" MaxWidth="920">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Header -->
            <StackPanel Spacing="3">
                <TextBlock Text="About DevOps Tools Installer" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Purpose-built for DevOps engineers, cloud architects, and developers on Windows."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Update Feedback InfoBar -->
            <controls:InfoBar
                x:Name="AboutInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />

            <!-- Tool Hero Card -->
            <Border Style="{StaticResource HeroCardStyle}" Padding="26">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image x:Name="ToolLogoImage" Source="ms-appx:///Assets/app.png"
                               Width="44" Height="44" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="DevOps Tools Installer" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="v2.0.0" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="WinUI 3 • .NET 8" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="A native, high-performance catalog installer designed to eliminate friction when provisioning cloud and DevOps CLIs on Windows. Official vendor binaries, automatic PATH configuration, and zero telemetry." />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                        <Button x:Name="AboutCheckUpdatesButton" Style="{StaticResource AccentButtonStyle}" Click="CheckForUpdates_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="AboutCheckRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                                <FontIcon x:Name="AboutCheckIcon" Glyph="&#xE895;" FontSize="13" />
                                <TextBlock x:Name="AboutCheckText" Text="Check for Updates" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="ToolGitHub_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="14" />
                                <TextBlock Text="GitHub Repo" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Author Card Spotlight -->
            <TextBlock Text="Creator &amp; Maintainer" Style="{StaticResource CardTitleStyle}" Margin="4,4,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="22">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Author Avatar (GitHub Avatar) -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <controls:PersonPicture
                            x:Name="AuthorPicture"
                            DisplayName="HARSHHAA"
                            Initials="H"
                            Width="60"
                            Height="60" />
                    </Border>

                    <!-- Author Details -->
                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="HARSHHAA" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="Lead Maintainer" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <HyperlinkButton Click="AuthorGitHub_Click" Padding="0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="12" />
                                <TextBlock Text="https://github.com/NotHarshhaa" FontSize="13" />
                            </StackPanel>
                        </HyperlinkButton>

                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Crafted by HARSHHAA to empower engineers with clean, dependable, and reproducible developer environments on Windows without third-party package manager bloat." />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                        <Button Click="AuthorGitHub_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE77B;" FontSize="13" />
                                <TextBlock Text="@NotHarshhaa" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="ReportIssue_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE939;" FontSize="13" />
                                <TextBlock Text="File an Issue" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Mission & Overview -->
            <TextBlock Text="Why DevOps Tools Installer?" Style="{StaticResource CardTitleStyle}" Margin="4,4,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Solving the Windows DevOps Workstation Challenge" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="20"
                               Text="While Linux and macOS benefit from native package workflows, setting up a Windows DevOps workstation historically required navigating dozens of disparate vendor download pages, MSI installers, zip extractions, and manual Windows Environment Variable edits. DevOps Tools Installer provides a centralized, transparent hub where all tools are cataloged with verified direct vendor download URLs, silent install configurations, and automated PATH deployment into Tools\bin." />

                    <Grid ColumnSpacing="16" RowSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🔒 100% Transparent &amp; Safe" FontWeight="SemiBold" />
                                <TextBlock Text="Only downloads official binaries directly from vendor releases. No custom mirrors or repackaged executables."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="⚡ User PATH Automation" FontWeight="SemiBold" />
                                <TextBlock Text="Extracted portable CLIs are linked into Tools\bin. Configure PATH in 1 click without needing administrator privileges."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="📦 Stack Presets" FontWeight="SemiBold" />
                                <TextBlock Text="Quickly filter and batch-download entire curated toolchains: Kubernetes, Multi-Cloud, IaC, Security, and CLI utilities."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🛡️ Clean Uninstallation" FontWeight="SemiBold" />
                                <TextBlock Text="Precise word-boundary registry uninstaller integration prevents accidental uninstalls of unrelated system software."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Key Use Cases -->
            <TextBlock Text="Primary Use Cases" Style="{StaticResource CardTitleStyle}" Margin="4,4,0,0" />
            <Grid ColumnSpacing="16" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Use Case 1 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Machine Onboarding" FontWeight="SemiBold" />
                        <TextBlock Text="Bootstrap a fresh Windows workstation with all essential developer tools in under 5 minutes without opening a browser."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Use Case 2 -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE909;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Kubernetes Engineering" FontWeight="SemiBold" />
                        <TextBlock Text="Manage and update kubectl, Helm, k9s, Minikube, kind, and Cilium CLI side-by-side with zero PATH conflicts."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Use Case 3 -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE753;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Multi-Cloud Operations" FontWeight="SemiBold" />
                        <TextBlock Text="Maintain AWS CLI, Azure CLI, Google Cloud SDK, and doctl with automated installer arguments and updates."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Use Case 4 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE943;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Infrastructure as Code" FontWeight="SemiBold" />
                        <TextBlock Text="Provision HashiCorp Terraform, Terragrunt, Pulumi, Ansible, and Packer portable binaries instantly into your shell."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Use Case 5 -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="DevSecOps &amp; Scanning" FontWeight="SemiBold" />
                        <TextBlock Text="Equip security teams with Trivy, Snyk, Grype, Syft, and Cosign for image vulnerability scans and SBOM generation."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Use Case 6 -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE756;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Shell Modernization" FontWeight="SemiBold" />
                        <TextBlock Text="Supercharge Windows Terminal and PowerShell with GitHub CLI (gh), jq, yq, fzf, ripgrep, and bat."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Community & Open Source -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Open Source &amp; Community-Driven" FontWeight="SemiBold" />
                        <TextBlock Text="DevOps Tools Installer is free, open source, and welcoming to contributions. Star the repo, submit tool requests, or propose improvements on GitHub."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Click="ToolGitHub_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="13" />
                                <TextBlock Text="Star on GitHub" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
