<Page
    x:Class="DevOpsToolsInstaller.Views.StacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models"
    xmlns:controls="using:DevOpsToolsInstaller.Controls">

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  HEADER                            -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Curated Tool Stacks" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderCountBadge" Text="12 Presets"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="1-click pre-configured toolsets. Install complete workflows at once, or customize them in the catalog."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Button Grid.Column="1" Click="BrowseCatalog_Click"
                    CornerRadius="4" Padding="14,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                    <TextBlock Text="Explore All 90 Tools" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  COMMAND BAR                       -->
        <!-- ══════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    Grid.Column="0"
                    x:Name="SearchBox"
                    PlaceholderText="Filter stacks by name, tool (e.g. kubectl, terraform), or role…"
                    QueryIcon="Find"
                    MaxWidth="450"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    TextChanged="SearchBox_TextChanged" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════ -->
        <!--  STACKS LIST                       -->
        <!-- ══════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" Padding="0,0,0,24">
            <ItemsControl x:Name="StacksList">
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Icon, Info, Actions -->
                                <Grid Grid.Row="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Stack Icon -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title, tags, description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Border Style="{StaticResource BadgeStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8F1;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding TotalCount}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="tools" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource BadgeStyle}">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Clear, Actionable Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Customize in Catalog button -->
                                        <Button Click="CustomizeInCatalog_Click" Tag="{Binding Id}"
                                                Padding="14,8" CornerRadius="4"
                                                ToolTipService.ToolTip="Filter catalog to show only this stack's tools">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                                <TextBlock Text="Customize in Catalog" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Direct Install Stack button -->
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                Click="InstallStack_Click" Tag="{Binding Id}"
                                                Padding="16,8" CornerRadius="4"
                                                IsEnabled="{Binding CanDownload}"
                                                ToolTipService.ToolTip="Batch download and install all tools in this stack">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="{Binding DownloadButtonGlyph}" FontSize="13" />
                                                <TextBlock Text="{Binding DownloadButtonText}" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Row: Individual Tool Badges with Status -->
                                <Border Grid.Row="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Tools included in this stack:" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding ToolItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BadgeStyle}" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                            <FontIcon Glyph="&#xE73E;" FontSize="11"
                                                                      Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                                                                      Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
