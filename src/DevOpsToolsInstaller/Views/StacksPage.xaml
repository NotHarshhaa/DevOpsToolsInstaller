<Page
    x:Class="DevOpsToolsInstaller.Views.StacksPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models"
    xmlns:viewmodels="using:DevOpsToolsInstaller.ViewModels"
    xmlns:appControls="using:DevOpsToolsInstaller.Controls"
    xmlns:helpers="using:DevOpsToolsInstaller.Helpers"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <appControls:PageContainer>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════ -->
            <!--  HEADER                            -->
            <!-- ══════════════════════════════════ -->
            <appControls:PageHeader Grid.Row="0" x:Name="Header"
                                    Title="Stacks &amp; Bundles"
                                    BadgeText="12 Presets"
                                    Subtitle="Pre-configured toolsets for common DevOps workflows. Install entire stacks in 1-click, or build your own custom stack.">
                <appControls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Mode Switcher: Presets vs Custom Stack Builder -->
                        <tk:Segmented x:Name="ViewModeSegmented"
                                      AutomationProperties.Name="View mode switcher">
                            <tk:SegmentedItem Content="Presets" Tag="Presets" IsSelected="True" ToolTipService.ToolTip="Browse pre-configured workflow stacks" />
                            <tk:SegmentedItem Content="Stack Builder" Tag="Builder" ToolTipService.ToolTip="Create and customize tool stacks" />
                        </tk:Segmented>

                        <Button Click="BrowseCatalog_Click"
                                CornerRadius="4" Padding="14,7" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Explore full tool catalog">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                <TextBlock Text="Explore Catalog" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </appControls:PageHeader.ActionsContent>
            </appControls:PageHeader>

            <!-- Right-hand stack detail pane: every tool in the stack with version,
                 size and install state, plus per-tool checkboxes to pick exactly
                 what gets queued. Inline, and scoped to the content row so the
                 page header never reflows when the pane opens. -->
            <SplitView Grid.Row="1" x:Name="StackDetailSplitView"
                       PanePlacement="Right"
                       DisplayMode="Inline"
                       IsPaneOpen="False"
                       OpenPaneLength="420"
                       CompactPaneLength="0"
                       BorderThickness="0"
                       PaneBackground="Transparent"
                       Background="Transparent"
                       PaneClosed="StackDetailSplitView_PaneClosed">

                <SplitView.Pane>
                    <Border x:Name="StackDetailPaneRoot"
                            Margin="12,0,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Translation="0,0,32">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Pane header -->
                            <Grid Grid.Row="0" Padding="16,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" VerticalAlignment="Center">
                                    <FontIcon x:Name="DetailGlyph" Glyph="&#xE71D;" FontSize="20"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailNameText" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DetailCategoryText" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                        Padding="6,5" CornerRadius="4"
                                        VerticalAlignment="Top"
                                        Click="DetailClose_Click"
                                        ToolTipService.ToolTip="Close stack details"
                                        AutomationProperties.Name="Close stack details">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Progress + size summary -->
                            <StackPanel Grid.Row="1" Padding="16,0,16,12" Spacing="8">
                                <TextBlock x:Name="DetailDescriptionText" TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="DetailProgressText"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="DetailEstSizeText"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ProgressBar x:Name="DetailProgressBar"
                                             Minimum="0" Maximum="1" Value="0" />
                            </StackPanel>

                            <!-- Per-tool list -->
                            <Grid Grid.Row="2">
                                <ListView x:Name="DetailToolsList"
                                          SelectionMode="None"
                                          IsItemClickEnabled="True"
                                          ItemClick="DetailToolRow_Click"
                                          Padding="8,0,8,8"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Tools in this stack">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,2" />
                                            <Setter Property="Margin" Value="0,1" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" Padding="4"
                                                  ToolTipService.ToolTip="{Binding StatusText}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" MinWidth="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanSelect}"
                                                          Click="DetailToolCheck_Click"
                                                          ToolTipService.ToolTip="Include this tool when installing"
                                                          AutomationProperties.Name="Include this tool when installing" />

                                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="15"
                                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                        <Image Width="20" Height="20" Stretch="Uniform"
                                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                               ImageFailed="ToolLogo_ImageFailed" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding VersionText}" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="•" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="10"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{Binding IsInstalledOrDownloaded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock x:Name="DetailEmptyText"
                                           Text="This stack does not list any tools yet."
                                           Visibility="Collapsed"
                                           Margin="16"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <!-- Pane actions -->
                            <Border Grid.Row="3" Padding="16,12"
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <Button x:Name="DetailInstallButton"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="DetailInstall_Click"
                                            AutomationProperties.Name="Install selected tools">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                                            <TextBlock x:Name="DetailInstallText" Text="Install selected" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <HyperlinkButton Grid.Column="0" x:Name="DetailSelectAllButton"
                                                         Content="Select all" Padding="0"
                                                         HorizontalAlignment="Left"
                                                         Click="DetailSelectAll_Click" />
                                        <HyperlinkButton Grid.Column="1"
                                                         Content="Customize in catalog" Padding="0"
                                                         Click="DetailOpenCatalog_Click"
                                                         AutomationProperties.Name="Customize this stack in the catalog" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </SplitView.Pane>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!--  MAIN CONTENT: PRESETS VIEW vs. CUSTOM STACK BUILDER VIEW      -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <Grid>
                    <!-- ────────────────────────────────────────────────────────── -->
                    <!--  PRESETS VIEW CONTAINER                                    -->
                    <!-- ────────────────────────────────────────────────────────── -->
                    <Grid x:Name="PresetsContainerGrid" RowSpacing="12" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Loading overlay while the catalog hydrates -->
                        <Grid x:Name="StacksLoading" Grid.Row="0" Grid.RowSpan="4"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed" Margin="0,24">
                            <StackPanel Spacing="14" HorizontalAlignment="Center">
                                <ProgressRing x:Name="StacksLoadingRing" Width="32" Height="32" IsActive="True" />
                                <TextBlock Text="Loading stacks…"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- ROW 0: Search & Status -->
                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <AutoSuggestBox
                                Grid.Column="0"
                                x:Name="SearchBox"
                                Width="380"
                                HorizontalAlignment="Left"
                                PlaceholderText="Search stacks, included tools (e.g. docker, terraform, k8s), or workflows…"
                                QueryIcon="Find"
                                VerticalAlignment="Center"
                                TextChanged="SearchBox_TextChanged" />

                            <TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- ROW 1: Category Filter Chips -->
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Scroll Left Button -->
                            <Button Grid.Column="0" x:Name="ScrollLeftButton" Click="ScrollLeft_Click"
                                    CornerRadius="4" Padding="6,6" VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="Scroll left">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            </Button>

                            <!-- Scrollable Chips Container -->
                            <ScrollViewer Grid.Column="1" x:Name="ChipsScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled"
                                          ViewChanged="ChipsScrollViewer_ViewChanged"
                                          SizeChanged="ChipsScrollViewer_SizeChanged">
                                <tk:Segmented x:Name="CategorySegmented" Padding="0,2,0,2"
                                              AutomationProperties.Name="Stack category filter">
                                    <tk:SegmentedItem Content="All Stacks" Tag="All" IsSelected="True" />
                                    <tk:SegmentedItem Content="Containerization" Tag="Containerization" />
                                    <tk:SegmentedItem Content="CI/CD" Tag="CI/CD" />
                                    <tk:SegmentedItem Content="Cloud" Tag="Cloud" />
                                    <tk:SegmentedItem Content="Security" Tag="Security" />
                                    <tk:SegmentedItem Content="Monitoring" Tag="Monitoring" />
                                    <tk:SegmentedItem Content="IaC" Tag="IaC" />
                                    <tk:SegmentedItem Content="Terminal" Tag="Terminal" />
                                    <tk:SegmentedItem Content="Workstation" Tag="Workstation" />
                                    <tk:SegmentedItem Content="Networking" Tag="Networking" />
                                </tk:Segmented>
                            </ScrollViewer>

                            <!-- Scroll Right Button -->
                            <Button Grid.Column="2" x:Name="ScrollRightButton" Click="ScrollRight_Click"
                                    CornerRadius="4" Padding="6,6" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Scroll right">
                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- ROW 2: Stacks GridView. Cards size to their content
                             (the cell height is measured from the tallest card) so
                             there is no dead space, while the trailing "*" row keeps
                             the install action pinned to the bottom. -->
                        <GridView
                            x:Name="StacksGridView"
                            Grid.Row="2"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="StacksGridView_ItemClick"
                            Padding="0,6,0,8"
                            HorizontalAlignment="Stretch"
                            SizeChanged="StacksGridView_SizeChanged">
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid x:Name="StacksWrapGrid" Orientation="Horizontal" ItemWidth="360" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="6" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <!-- Windows 11 Fluent Card: the whole card is a hit
                                         target for the detail pane (see
                                         StacksGridView_ItemClick); nested buttons handle
                                         their own clicks. -->
                                    <Border Style="{StaticResource CardStyle}" Padding="16,14"
                                            helpers:Motion.HoverLift="True"
                                            AutomationProperties.Name="{Binding Name}">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- ROW 0: Title & Tool Count Badge -->
                                            <Grid Grid.Row="0" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ToolsCountBadgeText}"
                                                               FontSize="11" FontWeight="Medium"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- ROW 1: Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top" />

                                            <!-- ROW 2: Included tools — icon + name + version, so
                                                 identical icons stay distinguishable. -->
                                            <StackPanel Grid.Row="2" Spacing="4">
                                                <ItemsControl ItemsSource="{Binding PreviewTools}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Vertical" Spacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="8"
                                                                  ToolTipService.ToolTip="{Binding TooltipText}"
                                                                  AutomationProperties.Name="{Binding TooltipText}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Center">
                                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="12"
                                                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                        <Image Width="16" Height="16" Stretch="Uniform"
                                                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                               ImageFailed="ToolLogo_ImageFailed" />
                                                                    </Grid>
                                                                </Border>

                                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />

                                                                <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="{Binding RemainingToolsText}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           ToolTipService.ToolTip="{Binding RemainingToolsTooltip}"
                                                           Visibility="{Binding HasRemainingTools, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!-- ROW 3: Install progress + estimated download size -->
                                            <StackPanel Grid.Row="3" Spacing="6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding EstimatedSizeText}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <ProgressBar Value="{Binding ProgressValue}"
                                                             Maximum="{Binding ProgressMax}"
                                                             Minimum="0" />
                                            </StackPanel>

                                            <!-- ROW 5: Bottom Action Buttons -->
                                            <Grid Grid.Row="5" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Install Stack SplitButton -->
                                                <SplitButton Grid.Column="0"
                                                             Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                             Click="InstallStack_Click" Tag="{Binding Id}"
                                                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                             Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             ToolTipService.ToolTip="Download every tool that is not installed yet"
                                                             AutomationProperties.Name="Install stack">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="2,0,6,0">
                                                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                        <TextBlock Text="{Binding DownloadButtonText}" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                    <SplitButton.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Open in Stack Builder" Click="OpenInStackBuilder_Click" Tag="{Binding Id}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE70F;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Customize in catalog" Click="CustomizeInCatalog_Click" Tag="{Binding Id}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8F1;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="View downloads" Click="MenuViewDownloads_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE896;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Export as DevContainer (.zip)…" Click="ExportStackDevContainer_Click" Tag="{Binding Id}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE7B8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </SplitButton.Flyout>
                                                </SplitButton>

                                                <!-- All Installed Button -->
                                                <Button Grid.Column="0"
                                                        HorizontalAlignment="Stretch"
                                                        Padding="14,8" CornerRadius="6"
                                                        IsEnabled="False"
                                                        Visibility="{Binding IsFullyInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                                        <TextBlock Text="All Installed" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- View tools -->
                                                <Button Grid.Column="1"
                                                        Click="ViewStackTools_Click"
                                                        Padding="10,8" CornerRadius="6"
                                                        ToolTipService.ToolTip="See every tool in this stack, with versions and sizes"
                                                        AutomationProperties.Name="View tools in this stack">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                                        <TextBlock Text="View tools" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- ROW 3: Footer Status Bar -->
                        <Grid Grid.Row="3" Margin="0,4,0,4" VerticalAlignment="Center">
                            <TextBlock x:Name="FooterStatusText"
                                       Text="Loading stacks…"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- ────────────────────────────────────────────────────────── -->
                    <!--  CUSTOM STACK BUILDER VIEW CONTAINER                       -->
                    <!-- ────────────────────────────────────────────────────────── -->
                    <Grid x:Name="BuilderContainerGrid" Visibility="Collapsed" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Searchable Catalog List (380px) -->
                            <ColumnDefinition Width="380" MinWidth="320" MaxWidth="440" />
                            <!-- Right: "My Stack" Drop Area & Management (*) -->
                            <ColumnDefinition Width="*" MinWidth="460" />
                        </Grid.ColumnDefinitions>

                        <!-- ══════════════════════════════════════════════════════ -->
                        <!--  LEFT COLUMN: SEARCHABLE TOOL CATALOG LIST            -->
                        <!-- ══════════════════════════════════════════════════════ -->
                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="16"
                                Margin="0,0,0,4">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header & Count Badge -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Catalog Tools" FontWeight="SemiBold" FontSize="15" />
                                        <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind BuilderViewModel.FilteredAvailableCount, Mode=OneWay}"
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Search AutoSuggestBox -->
                                <AutoSuggestBox Grid.Row="1"
                                                x:Name="BuilderSearchBox"
                                                PlaceholderText="Filter catalog (docker, k8s, git)…"
                                                QueryIcon="Find"
                                                Text="{x:Bind BuilderViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Filter catalog tools" />

                                <!-- Available Tools ListView with Drag Source & Keyboard '+ Add' Button -->
                                <ListView Grid.Row="2"
                                          x:Name="AvailableToolsListView"
                                          ItemsSource="{x:Bind BuilderViewModel.FilteredAvailableTools, Mode=OneWay}"
                                          SelectionMode="None"
                                          CanDragItems="True"
                                          DragItemsStarting="AvailableToolsListView_DragItemsStarting"
                                          Padding="0,2,0,0"
                                          AutomationProperties.Name="Catalog tools to add">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,3" />
                                            <Setter Property="Margin" Value="0,2" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ToolDefinition">
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    helpers:Motion.HoverLift="True">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Logo / Glyph -->
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15"
                                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                      Visibility="{x:Bind HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                            <Image Width="20" Height="20" Stretch="Uniform"
                                                                   Source="{x:Bind LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Tool Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <Border Style="{StaticResource BadgeStyle}" Padding="4,1">
                                                                <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Description}" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Keyboard-friendly '+ Add' button (Alternative to Drag) -->
                                                    <Button Grid.Column="2"
                                                            Click="AddToolButton_Click"
                                                            Tag="{x:Bind}"
                                                            Padding="8,5"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Add to stack"
                                                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                                            <TextBlock Text="Add" FontSize="11" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════ -->
                        <!--  RIGHT COLUMN: "MY STACK" DROP AREA & ACTIONS         -->
                        <!-- ══════════════════════════════════════════════════════ -->
                        <Border Grid.Column="1"
                                Style="{StaticResource CardStyle}"
                                Padding="18,16"
                                Margin="0,0,0,4">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <!-- Row 0: Name, Description, Metrics -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Row 1: Action Buttons (Install, Save, Export, Import, Clear) -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Row 2: InfoBar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Row 3: Stack Tools Header / Guidance -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Row 4: Drop Area & Reorderable List -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- ROW 0: Stack Name, Description & Metrics -->
                                <Grid Grid.Row="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 x:Name="StackNameBox"
                                                 Header="Stack Name"
                                                 PlaceholderText="e.g. Cloud Native DevOps, K8s Engineer"
                                                 Text="{x:Bind BuilderViewModel.StackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="14" FontWeight="SemiBold"
                                                 AutomationProperties.Name="Stack name" />

                                        <!-- Metrics Summary Badge -->
                                        <Border Grid.Column="1"
                                                Style="{StaticResource BadgeStyle}"
                                                Padding="12,6"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE8F1;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="{x:Bind BuilderViewModel.ToolsCountBadgeText, Mode=OneWay}"
                                                               FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="{x:Bind BuilderViewModel.EstimatedSizeFormatted, Mode=OneWay}"
                                                               FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="est." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBox Grid.Row="1"
                                             x:Name="StackDescBox"
                                             Header="Description"
                                             PlaceholderText="Short summary of this toolset and workflow purpose…"
                                             Text="{x:Bind BuilderViewModel.StackDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"
                                             AutomationProperties.Name="Stack description" />
                                </Grid>

                                <!-- ROW 1: Action Toolbar -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <!-- 1-Click Install This Stack -->
                                        <Button Click="InstallCustomStack_Click"
                                                IsEnabled="{x:Bind BuilderViewModel.CanInstall, Mode=OneWay}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Padding="16,8" CornerRadius="6"
                                                ToolTipService.ToolTip="Download and queue all tools in this stack"
                                                AutomationProperties.Name="Install this stack">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                <TextBlock Text="Install This Stack" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Save Button -->
                                        <Button Click="SaveCustomStack_Click"
                                                IsEnabled="{x:Bind BuilderViewModel.CanInstall, Mode=OneWay}"
                                                Padding="12,8" CornerRadius="6"
                                                ToolTipService.ToolTip="Save to custom presets for future 1-click use"
                                                AutomationProperties.Name="Save stack">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                                <TextBlock Text="Save" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Export (.json) Button -->
                                        <Button Click="ExportCustomStack_Click"
                                                IsEnabled="{x:Bind BuilderViewModel.CanInstall, Mode=OneWay}"
                                                Padding="12,8" CornerRadius="6"
                                                ToolTipService.ToolTip="Export stack definition as JSON"
                                                AutomationProperties.Name="Export stack as JSON">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                                                <TextBlock Text="Export (.json)" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Import (.json) Button -->
                                        <Button Click="ImportCustomStack_Click"
                                                Padding="12,8" CornerRadius="6"
                                                ToolTipService.ToolTip="Import stack definition from a JSON file"
                                                AutomationProperties.Name="Import stack from JSON">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                                                <TextBlock Text="Import (.json)" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Clear Button -->
                                    <Button Grid.Column="1"
                                            Click="ClearCustomStack_Click"
                                            IsEnabled="{x:Bind BuilderViewModel.HasTools, Mode=OneWay}"
                                            Padding="10,8" CornerRadius="6"
                                            ToolTipService.ToolTip="Clear all tools from current stack"
                                            AutomationProperties.Name="Clear stack">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="Clear" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- ROW 2: InfoBar for Validation & Feedback -->
                                <InfoBar Grid.Row="2"
                                         x:Name="BuilderInfoBar"
                                         IsOpen="False"
                                         IsClosable="True"
                                         Margin="0,0,0,0" />

                                <!-- ROW 3: Stack Tools Header / Guidance -->
                                <Grid Grid.Row="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Stack Tools" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="• Drag items to reorder, or use Delete key to remove"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 4: "My Stack" Drop Area & Reorderable List -->
                                <Grid Grid.Row="4"
                                      x:Name="MyStackDropArea"
                                      AllowDrop="True"
                                      DragOver="MyStackArea_DragOver"
                                      Drop="MyStackArea_Drop"
                                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                                      CornerRadius="8"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      Padding="10">

                                    <!-- Empty State View -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                                Visibility="{x:Bind BuilderViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border Width="56" Height="56" CornerRadius="28"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE71D;" FontSize="24"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Drop tool cards here"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Drag tool cards from the catalog on the left, or click '+ Add' on any tool."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Reorderable Tools ListView -->
                                    <ListView x:Name="MyStackListView"
                                              ItemsSource="{x:Bind BuilderViewModel.StackTools, Mode=OneWay}"
                                              AllowDrop="True"
                                              CanReorderItems="True"
                                              CanDragItems="True"
                                              SelectionMode="Single"
                                              KeyDown="MyStackListView_KeyDown"
                                              Visibility="{x:Bind BuilderViewModel.HasTools, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="My stack tools list">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0,3" />
                                                <Setter Property="Margin" Value="0,2" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:ToolDefinition">
                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        CornerRadius="6"
                                                        Padding="10,8">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Drag Grip Icon -->
                                                        <FontIcon Grid.Column="0" Glyph="&#xE700;" FontSize="13"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  VerticalAlignment="Center" Margin="2,0,2,0"
                                                                  ToolTipService.ToolTip="Drag to reorder" />

                                                        <!-- Logo / Glyph -->
                                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center">
                                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15"
                                                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                          Visibility="{x:Bind HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                <Image Width="20" Height="20" Stretch="Uniform"
                                                                       Source="{x:Bind LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- Name & Category -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                                <Border Style="{StaticResource BadgeStyle}" Padding="4,1">
                                                                    <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind Description}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Reorder (Up/Down) & Remove Buttons -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Button Click="MoveUp_Click" Tag="{x:Bind}"
                                                                    Padding="6,5" CornerRadius="4"
                                                                    ToolTipService.ToolTip="Move up"
                                                                    AutomationProperties.Name="Move up">
                                                                <FontIcon Glyph="&#xE74A;" FontSize="10" />
                                                            </Button>
                                                            <Button Click="MoveDown_Click" Tag="{x:Bind}"
                                                                    Padding="6,5" CornerRadius="4"
                                                                    ToolTipService.ToolTip="Move down"
                                                                    AutomationProperties.Name="Move down">
                                                                <FontIcon Glyph="&#xE74B;" FontSize="10" />
                                                            </Button>
                                                            <Button Click="RemoveToolButton_Click" Tag="{x:Bind}"
                                                                    Padding="6,5" CornerRadius="4"
                                                                    ToolTipService.ToolTip="Remove from stack (or press Delete)"
                                                                    AutomationProperties.Name="Remove from stack">
                                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </SplitView>
        </Grid>
    </appControls:PageContainer>
</Page>
