<Page
    x:Class="DevOpsToolsInstaller.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,28,32,36">
        <StackPanel Spacing="20" MaxWidth="840">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Header -->
            <StackPanel Spacing="2">
                <TextBlock Text="Settings &amp; Configuration" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Personalize appearance, manage directories, and view app details."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource CardTitleStyle}" Margin="4,4,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE790;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Application Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Choose Light, Dark, or follow the Windows system preference."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="ThemeComboBox" Width="170"
                              SelectionChanged="ThemeComboBox_SelectionChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="System default" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Storage & Paths -->
            <TextBlock Text="Directories &amp; Storage" Style="{StaticResource CardTitleStyle}" Margin="4,6,0,0" />

            <!-- Downloads folder -->
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Installer Downloads Folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="DownloadPathText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="OpenFolder_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Tools bin folder (PATH) -->
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE756;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="CLI Binaries Folder (PATH)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Style="{StaticResource AccentBadgeStyle}" Padding="6,1">
                                <TextBlock Text="PATH Target" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ToolsPathText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="OpenToolsFolder_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Clear downloads -->
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Cached Installer Files" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StorageText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ClearButton" Click="ClearDownloads_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Clear cache" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource CardTitleStyle}" Margin="4,6,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;" FontSize="24"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="DevOps Tools Installer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Version 1.2.0 • WinUI 3 + .NET 8 • x64/arm64" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="A modern catalog-based package and binary installer for DevOps and cloud engineers on Windows. Fetches official vendor artifacts, verifies hashes, and integrates CLI tools seamlessly into your PATH." />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="2" Click="GitHub_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                            <TextBlock Text="GitHub Repo" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
