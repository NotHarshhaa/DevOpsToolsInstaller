<Page
    x:Class="DevOpsToolsInstaller.Views.ProfilesPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:appControls="using:DevOpsToolsInstaller.Controls"
    xmlns:helpers="using:DevOpsToolsInstaller.Helpers">

    <appControls:PageContainer>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <appControls:PageHeader Grid.Row="0"
                                    Title="Profiles &amp; History"
                                    Subtitle="Capture named workstation profiles, snapshot your toolset, review install history, and sync across machines.">
                <appControls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <tk:Segmented x:Name="SectionSegmented"
                                      AutomationProperties.Name="Profiles and history sections">
                            <tk:SegmentedItem Content="Profiles" Tag="Profiles" IsSelected="True" />
                            <tk:SegmentedItem Content="Snapshots" Tag="Snapshots" />
                            <tk:SegmentedItem Content="History" Tag="History" />
                            <tk:SegmentedItem Content="Sync" Tag="Sync" />
                            <tk:SegmentedItem Content="New-PC Migration" Tag="Migration" />
                        </tk:Segmented>
                    </StackPanel>
                </appControls:PageHeader.ActionsContent>
            </appControls:PageHeader>

            <!-- STATUS BAR -->
            <controls:InfoBar x:Name="NoticeInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                              Margin="0,0,32,0"
                              Severity="Success" AutomationProperties.Name="Profiles status message" />

            <!-- CONTENT -->
            <Grid Grid.Row="2">
                <!-- Loading overlay while the catalog hydrates -->
                <Grid x:Name="ProfilesLoading" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <ProgressRing x:Name="ProfilesLoadingRing" Width="32" Height="32" IsActive="True" />
                        <TextBlock Text="Loading profiles…"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ── PROFILES ─────────────────────────────────────────── -->
                <Grid x:Name="ProfilesContainer" Visibility="Visible" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="ProfilesToolbar" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                        <Button Click="CaptureProfile_Click" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Capture current workstation as a profile">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE722;" FontSize="12" />
                                <TextBlock Text="Capture installed…" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="NewProfileFromSelection_Click"
                                AutomationProperties.Name="Create a profile from the catalog selection">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="From catalog selection" />
                            </StackPanel>
                        </Button>
                        <Button Click="ImportProfile_Click" AutomationProperties.Name="Import a profile from a JSON file">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                        <Button Click="RefreshProfiles_Click" AutomationProperties.Name="Refresh profiles">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <ListView x:Name="ProfilesList" Grid.Row="1" SelectionMode="None"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              Padding="0,0,32,12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListViewCardStyle}" helpers:Motion.HoverLift="True">
                                    <Grid Padding="16,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="18" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource CustomAccentPrimaryBrush}" />

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Apply" Click="ApplyProfile_Click"
                                                    AutomationProperties.Name="Select this profile in the catalog" />
                                            <Button Content="Install" Click="InstallProfile_Click"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    AutomationProperties.Name="Install every tool in this profile" />
                                            <Button Click="ExportProfile_Click" ToolTipService.ToolTip="Export profile as JSON"
                                                    AutomationProperties.Name="Export profile">
                                                <FontIcon Glyph="&#xE898;" FontSize="13" />
                                            </Button>
                                            <Button Click="DeleteProfile_Click" ToolTipService.ToolTip="Delete profile"
                                                    AutomationProperties.Name="Delete profile">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state: single capture CTA + 3 starter templates.
                         The toolbar is hidden while empty so the capture action
                         is never shown twice. -->
                    <ScrollViewer x:Name="ProfilesEmpty" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,8,32,16">
                        <StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Center">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="No profiles yet"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Capture what's installed on this machine, or start from a template."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button Click="CaptureProfile_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Capture current workstation as a profile">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE722;" FontSize="12" />
                                    <TextBlock Text="Capture installed tools…" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Start from a template"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           FontWeight="SemiBold" />
                                <ItemsControl x:Name="ProfilesTemplatesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="UseTemplate_Click" Tag="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="14,12"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                                              Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                                                              VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ToolCountText}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── SNAPSHOTS ────────────────────────────────────────── -->
                <Grid x:Name="SnapshotsContainer" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                        <Button Click="CaptureSnapshot_Click" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Capture a new workstation snapshot">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE722;" FontSize="12" />
                                <TextBlock Text="Capture snapshot…" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="RefreshSnapshots_Click" AutomationProperties.Name="Refresh snapshots">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                        <Button Click="OpenSnapshotsFolder_Click" AutomationProperties.Name="Open snapshots folder">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="13" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListView x:Name="SnapshotsList" Grid.Row="1" SelectionMode="None" Padding="0,0,32,12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListViewCardStyle}" helpers:Motion.HoverLift="True">
                                    <Grid Padding="16,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="18" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource CustomAccentPrimaryBrush}" />

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Diff" Click="DiffSnapshot_Click"
                                                    AutomationProperties.Name="Diff snapshot against workstation" />
                                            <Button Content="Restore" Click="RestoreSnapshot_Click"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    AutomationProperties.Name="Restore missing tools from snapshot" />
                                            <Button Click="DeleteSnapshot_Click" ToolTipService.ToolTip="Delete snapshot"
                                                    AutomationProperties.Name="Delete snapshot">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <appControls:EmptyStateControl x:Name="SnapshotsEmpty" Grid.Row="1"
                                                   Glyph="&#xE7C3;"
                                                   Title="No snapshots yet"
                                                   Message="Snapshots record the installed tools, versions and your User PATH so you can diff and restore them later."
                                                   ActionText="Capture snapshot…"
                                                   ActionClick="CaptureSnapshot_Click" />
                </Grid>

                <!-- ── HISTORY ──────────────────────────────────────────── -->
                <Grid x:Name="HistoryContainer" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                        <Button Click="RefreshHistory_Click" AutomationProperties.Name="Refresh history">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <Button Click="Rollback_Click"
                                AutomationProperties.Name="Roll a tool back to a previous version">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                                <TextBlock Text="Roll back a tool…" />
                            </StackPanel>
                        </Button>
                        <Button Click="ClearHistory_Click" AutomationProperties.Name="Clear history">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None" Padding="0,0,32,12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListViewCardStyle}" helpers:Motion.HoverLift="True">
                                    <Grid Padding="16,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="{Binding ActionGlyph}" FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ToolName}" Style="{StaticResource CardTitleStyle}"
                                                   VerticalAlignment="Center" MinWidth="160" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Style="{StaticResource BadgeStyle}" Padding="8,2">
                                                <TextBlock Text="{Binding Summary}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <appControls:EmptyStateControl x:Name="HistoryEmpty" Grid.Row="1"
                                                   Glyph="&#xE81C;"
                                                   Title="No history yet"
                                                   Message="Installs, updates, uninstalls and rollbacks are logged here automatically — install or update a tool and it will show up."
                                                   ActionText="Roll back a tool…"
                                                   ActionClick="Rollback_Click" />
                </Grid>

                <!-- ── SYNC ─────────────────────────────────────────────── -->
                <ScrollViewer x:Name="SyncContainer" Visibility="Collapsed" Padding="0,0,32,24">
                    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Cloud-synced profiles" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Choose a folder inside OneDrive, Dropbox, Google Drive, or a network share. The app merges profiles, custom tools, hooks, and snapshots by most-recent update — no account, no server, zero telemetry." />

                                <TextBlock x:Name="SyncFolderText" Text="No sync folder configured."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                                <TextBlock x:Name="SyncStatusText" Text="Last sync: never"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="ChooseSyncFolder_Click" Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.Name="Choose sync folder">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                            <TextBlock Text="Choose folder…" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="SyncNow_Click" AutomationProperties.Name="Sync now">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE895;" FontSize="13" />
                                            <TextBlock Text="Sync now" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Push (this machine wins)" Click="PushSync_Click" />
                                    <Button Content="Pull (remote wins)" Click="PullSync_Click" />
                                    <Button Click="ClearSyncFolder_Click" ToolTipService.ToolTip="Disable sync"
                                            AutomationProperties.Name="Clear sync folder">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Sync is opt-in and stores only the files this app already keeps locally. Nothing is uploaded to a third party by the app itself."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <!-- ── NEW-PC MIGRATION ─────────────────────────────── -->
                <ScrollViewer x:Name="MigrationContainer" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,32,12">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- EXPORT CARD -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource CustomAccentSubtleBrush}">
                                            <FontIcon Glyph="&#xE898;" FontSize="16" Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Export Migration Package" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <TextBlock Text="Set up your new laptop in minutes" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Capture tools and developer configs into a single portable migration file (.json). Private keys are never touched."
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <CheckBox x:Name="MigrateToolsCheck" Content="Installed Tools &amp; Stacks" IsChecked="True" />
                                        <CheckBox x:Name="MigrateGitCheck" Content="Git Configuration (.gitconfig)" IsChecked="True" />
                                        <CheckBox x:Name="MigratePwshCheck" Content="PowerShell Profile ($PROFILE aliases &amp; prompt)" IsChecked="True" />
                                        <CheckBox x:Name="MigrateTerminalCheck" Content="Windows Terminal Settings (color schemes &amp; fonts)" IsChecked="True" />
                                        <CheckBox x:Name="MigrateVsCodeCheck" Content="VS Code Extensions List (auto-reinstalls on new PC)" IsChecked="True" />
                                        <CheckBox x:Name="MigrateSshCheck" Content="SSH Config (~/.ssh/config — host shortcuts only, zero keys)" IsChecked="True" />
                                    </StackPanel>

                                    <controls:InfoBar IsOpen="True" IsClosable="False" Severity="Success"
                                                      Title="Zero Secret Guarantee"
                                                      Message="Private keys (*.pem, id_rsa, id_ed25519) and passwords are strictly excluded and never exported." />

                                    <Button x:Name="ExportMigrationBtn" Click="ExportMigration_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                                            <TextBlock Text="Export New-PC Package (.json)" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- RESTORE CARD -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource CustomAccentSubtleBrush}">
                                            <FontIcon Glyph="&#xE8B5;" FontSize="16" Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Restore on This Laptop" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <TextBlock Text="Apply package onto this workstation" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Select a migration package (.json) from your previous machine or shared drive to provision this PC."
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Button x:Name="BrowseMigrationBtn" Click="BrowseMigration_Click"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE838;" FontSize="12" />
                                            <TextBlock Text="Browse Migration Package..." />
                                        </StackPanel>
                                    </Button>

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="6" Padding="12,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="PACKAGE PREVIEW" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock x:Name="MigrationPreviewText"
                                                       Text="No package selected yet."
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <ProgressBar x:Name="MigrationProgress" Minimum="0" Maximum="100" Value="0"
                                                 Visibility="Collapsed" />
                                    <TextBlock x:Name="MigrationProgressStatus" Text="" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap" />

                                    <Button x:Name="ApplyMigrationBtn" Click="ApplyMigration_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                            <TextBlock Text="Apply Migration to This PC" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </appControls:PageContainer>
</Page>
