<Page
    x:Class="DevOpsToolsInstaller.Views.ToolDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appControls="using:DevOpsToolsInstaller.Controls"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <appControls:PageContainer>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <appControls:PageHeader Grid.Row="0" Title="Tool details">
                <appControls:PageHeader.ActionsContent>
                    <Button Click="Back_Click" Padding="10,6" CornerRadius="4"
                            ToolTipService.ToolTip="Back to catalog"
                            AutomationProperties.Name="Go back to tool catalog">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" />
                            <TextBlock Text="Back to catalog" FontSize="12" />
                        </StackPanel>
                    </Button>
                </appControls:PageHeader.ActionsContent>
            </appControls:PageHeader>

            <!-- Hero card (ConnectedAnimation target) -->
            <Border x:Name="HeroCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,32,0">
                <Grid ColumnSpacing="16" RowSpacing="12" x:Name="HeroGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeroLogoCol" Width="Auto" />
                        <ColumnDefinition x:Name="HeroNameCol" Width="*" />
                        <ColumnDefinition x:Name="HeroActionsCol" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeroMainRow" Height="Auto" />
                        <RowDefinition x:Name="HeroActionsRow" Height="0" />
                    </Grid.RowDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="HeroLayoutStates">
                            <!-- Narrow: actions drop onto their own row, full width. -->
                            <VisualState x:Name="Narrow">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HeroActionsCol.Width" Value="0" />
                                    <Setter Target="HeroActionsRow.Height" Value="Auto" />
                                    <Setter Target="HeroNamePanel.(Grid.ColumnSpan)" Value="2" />
                                    <Setter Target="HeroActionsPanel.(Grid.Row)" Value="1" />
                                    <Setter Target="HeroActionsPanel.(Grid.Column)" Value="0" />
                                    <Setter Target="HeroActionsPanel.(Grid.ColumnSpan)" Value="3" />
                                </VisualState.Setters>
                            </VisualState>
                            <!-- Wide: logo | name | actions on one row. -->
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="700" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HeroActionsCol.Width" Value="Auto" />
                                    <Setter Target="HeroActionsRow.Height" Value="0" />
                                    <Setter Target="HeroNamePanel.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="HeroActionsPanel.(Grid.Row)" Value="0" />
                                    <Setter Target="HeroActionsPanel.(Grid.Column)" Value="2" />
                                    <Setter Target="HeroActionsPanel.(Grid.ColumnSpan)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="HeroGlyph" Glyph="&#xE74C;" FontSize="24"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="HeroLogo" Width="36" Height="36" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="HeroNamePanel" Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="HeroName" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="19"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center"
                                    x:Name="HeroFavoriteBadge">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Favorite" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="HeroCategory" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="HeroKind" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="HeroVersion" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border x:Name="HeroCorporateBadge" Style="{StaticResource BadgeStyle}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="HeroCorporateText" Text="Company Approved" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Primary action: Install SplitButton (same options as the catalog card) -->
                    <StackPanel x:Name="HeroActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <SplitButton x:Name="HeroInstallButton"
                                     Style="{StaticResource AccentSplitButtonStyle}"
                                     Click="Install_Click" Padding="14,7"
                                     AutomationProperties.Name="Install tool">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,6,0">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock x:Name="HeroInstallButtonText" Text="Install" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Choose version..." Click="ChooseVersion_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8EC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Download only (skip install)" Click="DownloadOnly_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="BackendWingetItem" Text="Install via winget" Click="InstallViaWinget_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7B8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="BackendScoopItem" Text="Install via Scoop" Click="InstallViaScoop_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7B8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="BackendChocoItem" Text="Install via Chocolatey" Click="InstallViaChoco_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7B8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Open homepage" Click="OpenHomepage_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE774;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <ToggleButton x:Name="FavoriteButton" Click="ToggleFavorite_Click" Padding="10,7"
                                      ToolTipService.ToolTip="Toggle favorite"
                                      AutomationProperties.Name="Toggle favorite">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE735;" FontSize="12" />
                                <TextBlock x:Name="FavoriteText" Text="Favorite" FontSize="12" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Details -->
            <ScrollViewer Grid.Row="2" Padding="0,2,32,24">
                <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">

                    <tk:SettingsCard x:Name="DescriptionCard"
                                           Header="Description"
                                           IsClickEnabled="False">
                        <tk:SettingsCard.Description>
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </tk:SettingsCard.Description>
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="BackendCard"
                                     Header="Installation backend source"
                                     Description="Choose direct vendor download (default, zero package-manager bloat) or an alternative package manager.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7B8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="BackendCombo" SelectionChanged="BackendCombo_SelectionChanged" Width="260"
                                  AutomationProperties.Name="Select installation backend">
                            <ComboBoxItem Content="Direct Vendor Download (Default)" Tag="Direct" />
                            <ComboBoxItem x:Name="WingetComboItem" Content="winget (Windows Package Manager)" Tag="Winget" />
                            <ComboBoxItem x:Name="ScoopComboItem" Content="Scoop" Tag="Scoop" />
                            <ComboBoxItem x:Name="ChocoComboItem" Content="Chocolatey" Tag="Chocolatey" />
                        </ComboBox>
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="HomepageCard"
                                           Header="Homepage"
                                           Description="Official project page on the vendor's site.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </tk:SettingsCard.HeaderIcon>
                        <HyperlinkButton x:Name="HomepageLink" Click="HomepageLink_Click"
                                         AutomationProperties.Name="Open tool homepage">
                            <TextBlock x:Name="HomepageText" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </HyperlinkButton>
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="ShaCard"
                                           Header="SHA-256 checksum"
                                           Description="Every download is verified against this vendor-published digest before install.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ShaText" FontFamily="Consolas" FontSize="11"
                                       IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis"
                                       MaxWidth="300" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Click="CopySha_Click" Padding="8,4"
                                    ToolTipService.ToolTip="Copy SHA-256 to clipboard"
                                    AutomationProperties.Name="Copy SHA-256 checksum">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="DownloadUrlCard"
                                           Header="Direct download URL"
                                           Description="Direct vendor binary mirror link used for downloading this tool.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE896;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="DownloadUrlText" FontFamily="Consolas" FontSize="11"
                                       IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis"
                                       MaxWidth="300" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Click="CopyDownloadUrl_Click" Padding="8,4"
                                    ToolTipService.ToolTip="Copy direct download link to clipboard"
                                    AutomationProperties.Name="Copy download link">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>

                    <!-- Installation status -->
                    <tk:SettingsCard x:Name="StatusCard"
                                     Header="Installation status"
                                     Description="Whether this tool is present on this machine and which version was detected.">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE73E;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="StatusBadge" Style="{StaticResource BadgeStyle}" Padding="8,2">
                                <TextBlock x:Name="StatusBadgeText" Text="Not installed" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock x:Name="StatusDetailText" Text="" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </tk:SettingsCard>

                    <!-- Release notes -->
                    <tk:SettingsExpander x:Name="ReleaseNotesExpander"
                                         Header="What's new in this version"
                                         Description="Release notes from the vendor, when available."
                                         Visibility="Collapsed">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <StackPanel Spacing="8">
                            <ProgressRing x:Name="ReleaseNotesRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="ReleaseNotesText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </tk:SettingsExpander>

                    <!-- Related tools -->
                    <tk:SettingsCard x:Name="RelatedCard"
                                     Header="Related tools"
                                     Description="Other tools in the same category."
                                     Visibility="Collapsed">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71D;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ListView x:Name="RelatedList" SelectionMode="None" MaxHeight="76"
                                  ScrollViewer.HorizontalScrollMode="Auto"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Related tools in this category">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="RelatedTool_Click" Padding="10,5"
                                            AutomationProperties.Name="View related tool">
                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </tk:SettingsCard>

                    <tk:SettingsExpander x:Name="VersionsExpander"
                                               Header="Versions"
                                               Description="Currently pinned release and known previous versions.">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <TextBlock x:Name="CurrentVersionText" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard x:Name="NoPreviousVersionsCard"
                                                   Header="No previous versions recorded"
                                                   Description="Only the current catalog release is available for this tool."
                                                   IsClickEnabled="False"
                                                   Visibility="Collapsed" />
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>

                    <tk:SettingsExpander x:Name="LiveReleasesExpander"
                                               Header="Recent releases (live)"
                                               Description="The newest releases published on the vendor's GitHub repository — pick one to pin and install it exactly as shipped.">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressRing x:Name="LiveReleasesRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="LiveReleasesStatusText" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard x:Name="LiveReleasesEmptyCard"
                                                   Header="No releases fetched yet"
                                                   Description="Open this section while online to fetch the vendor's five newest GitHub releases."
                                                   IsClickEnabled="False" />
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>

                    <tk:SettingsExpander x:Name="HooksExpander"
                                               Header="Pre/post-install hooks"
                                               Description="Run your own shell commands before and after installing this tool. Requires hooks to be enabled in Settings; every command is written to the activity and audit log before it runs.">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE756;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard Header="Enable hooks for this tool"
                                             Description="Master switch for this tool's hooks, on top of the global setting in Settings.">
                                <ToggleSwitch x:Name="HookEnabledToggle" OnContent="" OffContent=""
                                              AutomationProperties.Name="Enable hooks for this tool" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Pre-install command" IsClickEnabled="False"
                                             Description="Runs before the artifact action. Supports {tool} {toolId} {version} {file} {downloadsFolder} {toolsBin} {toolsRoot}.">
                                <TextBox x:Name="PreHookBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         Width="360" Height="70" FontFamily="Consolas" FontSize="12"
                                         PlaceholderText="e.g. echo preparing {tool} {version}"
                                         AutomationProperties.Name="Pre-install hook command" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Post-install command" IsClickEnabled="False"
                                             Description="Runs after a successful install.">
                                <TextBox x:Name="PostHookBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         Width="360" Height="70" FontFamily="Consolas" FontSize="12"
                                         PlaceholderText="e.g. &quot;{toolsBin}\{toolId}&quot; --version"
                                         AutomationProperties.Name="Post-install hook command" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Timeout (seconds)"
                                             Description="Maximum time each command may run before it is terminated.">
                                <NumberBox x:Name="HookTimeoutBox" Width="130" Minimum="5" Maximum="3600"
                                           SpinButtonPlacementMode="Compact"
                                           AutomationProperties.Name="Hook timeout in seconds" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Save &amp; test">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="TestPreHook_Click"
                                            ToolTipService.ToolTip="Run the pre-install command now"
                                            AutomationProperties.Name="Test pre-install hook">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock Text="Test pre" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="TestPostHook_Click"
                                            ToolTipService.ToolTip="Run the post-install command now"
                                            AutomationProperties.Name="Test post-install hook">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock Text="Test post" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="SaveHooks_Click"
                                            AutomationProperties.Name="Save hooks">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                            <TextBlock Text="Save" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="DeleteHooks_Click" AutomationProperties.Name="Remove hooks">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            <TextBlock Text="Remove" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </tk:SettingsCard>
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>

                    <controls:InfoBar x:Name="HookStatusBar" IsOpen="False" IsClosable="True"
                                      Severity="Informational"
                                      AutomationProperties.Name="Hook status message" />

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </appControls:PageContainer>
</Page>
