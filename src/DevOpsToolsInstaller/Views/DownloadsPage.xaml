<Page
    x:Class="DevOpsToolsInstaller.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models">

    <Grid Padding="32,28,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  HEADER                            -->
        <!-- ══════════════════════════════════ -->
        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Downloads &amp; Deployments" Style="{StaticResource PageTitleStyle}" />
                <!-- Active count badge -->
                <Border Style="{StaticResource SuccessBadgeStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE896;" FontSize="10"
                                  Foreground="{ThemeResource CustomSuccessBadgeTextBrush}" />
                        <TextBlock x:Name="ActiveCountBadge" Text="Ready"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource CustomSuccessBadgeTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="Track progress, launch installers, and manage extracted CLI binaries."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- ══════════════════════════════════ -->
        <!--  COMMAND BAR                       -->
        <!-- ══════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Open folder button -->
                <Button Grid.Column="0" Click="OpenFolder_Click" CornerRadius="8" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Open downloads folder" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Height="22"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />

                <!-- Status text -->
                <TextBlock Grid.Column="2" x:Name="StatusText" VerticalAlignment="Center"
                           Margin="4,0,0,0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- ══════════════════════════════════ -->
        <!--  DOWNLOAD LIST                     -->
        <!-- ══════════════════════════════════ -->
        <ListView
            x:Name="DownloadsList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,4,0,28">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <ReorderThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Outer card: clipped to rounded corners -->
                    <Border Style="{StaticResource DownloadItemCardStyle}">
                        <Grid>
                            <!-- Colored left status stripe (using Progress binding for color approximation) -->
                            <Border Width="5" CornerRadius="12,0,0,12"
                                    Background="{ThemeResource DownloadStripeActiveBrush}"
                                    HorizontalAlignment="Left" />

                            <!-- Card content -->
                            <Grid ColumnSpacing="16" Margin="18,14,16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Tool icon -->
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="13"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CustomAccentBadgeBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Width="32" Height="32" Stretch="Uniform"
                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                    </Grid>
                                </Border>

                                <!-- Info + progress -->
                                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                    <!-- Top row: name + kind badge + status text -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NameWithVersion}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Border Style="{StaticResource AccentBadgeStyle}" Padding="8,2">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource CustomAccentBadgeTextBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Status label with color -->
                                        <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" Padding="8,2">
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource CustomNeutralBadgeTextBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Progress bar section -->
                                    <StackPanel Spacing="4">
                                        <!-- Progress % label -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Downloading…"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <Run Text="{Binding Progress, Mode=OneWay}" /><Run Text="%" />
                                            </TextBlock>
                                        </Grid>
                                        <!-- Thicker progress bar with accent color -->
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                     Height="8" CornerRadius="4" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="8"
                                            VerticalAlignment="Center">
                                    <!-- Run / Install button -->
                                    <Button Content="{Binding ActionLabel, Mode=OneWay}"
                                            Click="RunInstaller_Click"
                                            IsEnabled="{Binding IsDownloaded, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="16,8"
                                            MinWidth="120"
                                            HorizontalAlignment="Stretch" />

                                    <!-- Uninstall / Remove button -->
                                    <Button Click="Uninstall_Click"
                                            IsEnabled="{Binding IsInstalled, Mode=OneWay}"
                                            Visibility="{Binding SupportsUninstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{Binding UninstallLabel, Mode=OneWay}"
                                            CornerRadius="8" Padding="12,7"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="{Binding UninstallLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ══════════════════════════════════ -->
        <!--  PREMIUM EMPTY STATE               -->
        <!-- ══════════════════════════════════ -->
        <Grid
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            MaxWidth="420">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <Border CornerRadius="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="40,36">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <!-- Illustration-style icon -->
                    <Grid HorizontalAlignment="Center">
                        <!-- Outer glow ring -->
                        <Border Width="100" Height="100" CornerRadius="50"
                                Background="{ThemeResource CustomAccentBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource CustomAccentBadgeBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" />
                        <!-- Inner icon -->
                        <Border Width="80" Height="80" CornerRadius="40"
                                Background="{ThemeResource StatIconBlueBrush}"
                                BorderBrush="{ThemeResource CustomGlowBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="34"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Text -->
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="No downloads queued"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Head over to the Tool Catalog to pick the DevOps tools you want on your workstation."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="13" />
                    </StackPanel>

                    <!-- Feature hints -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Browse 40+ official DevOps tools"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71D;" FontSize="13"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Use presets to install a full stack"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="13"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Auto PATH setup — ready in minutes"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- CTA Button -->
                    <Button Content="Browse Tool Catalog"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="GoToCatalog_Click"
                            Padding="24,11" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
