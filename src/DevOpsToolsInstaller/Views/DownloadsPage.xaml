<Page
    x:Class="DevOpsToolsInstaller.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models">

    <Grid Padding="32,28,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <TextBlock Text="Downloads &amp; Deployments" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Track progress, launch installers, and manage extracted CLI binaries."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Command bar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OpenFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock Text="Open downloads folder" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Download list with fluid staggered transitions -->
        <ListView
            x:Name="DownloadsList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,4,0,28">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <ReorderThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListViewCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="20"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image Width="28" Height="28" Stretch="Uniform"
                                           Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NameWithVersion}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Border Style="{StaticResource BadgeStyle}" Padding="7,1">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                       Foreground="{ThemeResource CustomNeutralBadgeTextBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                             Height="5" CornerRadius="2.5" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Content="{Binding ActionLabel, Mode=OneWay}"
                                        Click="RunInstaller_Click"
                                        IsEnabled="{Binding IsDownloaded, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        FontWeight="SemiBold"
                                        MinWidth="120" />
                                <Button Click="Uninstall_Click"
                                        IsEnabled="{Binding IsInstalled, Mode=OneWay}"
                                        Visibility="{Binding SupportsUninstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="{Binding UninstallLabel, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock Text="{Binding UninstallLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            MaxWidth="380"
            Visibility="Collapsed">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <Border Width="64" Height="64" CornerRadius="16"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No downloads queued"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Explore the Tool Catalog to select tools for your workstation."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Browse Tool Catalog" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Click="GoToCatalog_Click" Margin="0,4,0,0" Padding="18,10" />
        </StackPanel>
    </Grid>
</Page>
