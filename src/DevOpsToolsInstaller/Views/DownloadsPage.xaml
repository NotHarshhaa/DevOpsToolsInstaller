<Page
    x:Class="DevOpsToolsInstaller.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models"
    xmlns:services="using:DevOpsToolsInstaller.Services">

    <Grid Padding="32,24,32,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  HEADER                            -->
        <!-- ══════════════════════════════════ -->
        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Downloads &amp; Deployments" Style="{StaticResource PageTitleStyle}" />
                <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center" Padding="8,2">
                    <TextBlock x:Name="ActiveCountBadge" Text="Ready"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Text="Track real-time transfers, verify digital signatures, launch installers, and manage extracted CLI binaries."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- ══════════════════════════════════ -->
        <!--  INTERACTIVE COMMAND & FILTER BAR  -->
        <!-- ══════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" x:Name="SearchBox"
                         PlaceholderText="Filter downloads…"
                         TextChanged="SearchBox_TextChanged"
                         VerticalAlignment="Center">
                    <TextBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </TextBox.Header>
                </TextBox>

                <!-- Status Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="FilterAllBtn" Content="All" Click="FilterTab_Click" Tag="All"
                            Style="{StaticResource SelectedCategoryChipStyle}" />
                    <Button x:Name="FilterDownloadingBtn" Content="Downloading" Click="FilterTab_Click" Tag="Downloading"
                            Style="{StaticResource CategoryChipStyle}" />
                    <Button x:Name="FilterReadyBtn" Content="Ready to Install" Click="FilterTab_Click" Tag="Ready"
                            Style="{StaticResource CategoryChipStyle}" />
                    <Button x:Name="FilterInstalledBtn" Content="Installed" Click="FilterTab_Click" Tag="Installed"
                            Style="{StaticResource CategoryChipStyle}" />
                </StackPanel>

                <!-- Middle Status / Message -->
                <TextBlock Grid.Column="2" x:Name="StatusText"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                <!-- Action Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Batch Install Button (Visible when ready items exist) -->
                    <Button x:Name="InstallAllReadyButton" Click="InstallAllReady_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Deploy all downloaded tools to workstation">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Install All Ready" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Open Downloads Folder -->
                    <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open downloads folder in Windows File Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="13" />
                            <TextBlock Text="Open Folder" />
                        </StackPanel>
                    </Button>

                    <!-- Clear Finished -->
                    <Button x:Name="ClearFinishedButton" Click="ClearFinished_Click"
                            ToolTipService.ToolTip="Remove installed tools from queue">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            <TextBlock Text="Clear Finished" />
                        </StackPanel>
                    </Button>

                    <!-- Toggle Activity Log -->
                    <ToggleButton x:Name="LogToggle" Click="LogToggle_Click"
                                  ToolTipService.ToolTip="Toggle diagnostic activity log">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" />
                            <TextBlock Text="Activity Log" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════ -->
        <!--  MAIN QUEUE & CONTENT AREA         -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="LogRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Download List -->
            <ListView
                x:Name="DownloadsList"
                Grid.Row="0"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Padding="0,2,0,12">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ContentThemeTransition />
                        <ReorderThemeTransition />
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DownloadItemCardStyle}" Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Tool Logo Plate -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Width="32" Height="32" Stretch="Uniform"
                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Column 1: Info & Progress -->
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <!-- Top Row: Name, Category, Kind, Digital Signature, Status Pill -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NameWithVersion}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                            <Border Style="{StaticResource BadgeStyle}">
                                                <TextBlock Text="{Binding Category}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Border Style="{StaticResource BadgeStyle}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <!-- Authenticode Signature Badge -->
                                            <Border Style="{StaticResource BadgeStyle}"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="{Binding SignatureSummary}">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{Binding SignatureResult.Glyph, FallbackValue='&#xE9CE;'}" FontSize="11"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding SignatureResult.StatusBadge, FallbackValue='Checking signature…'}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" Padding="8,2">
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Description / File details -->
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />

                                    <!-- Progress Bar Section -->
                                    <StackPanel Spacing="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Dynamic Throughput Speed / Status -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding FileName}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           FontSize="11" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding DownloadSpeed, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                                                           FontWeight="SemiBold" FontSize="11"
                                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!-- Progress Percentage -->
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontWeight="SemiBold" FontSize="11">
                                                <Run Text="{Binding ProgressPercent, Mode=OneWay}" /><Run Text="%" />
                                            </TextBlock>
                                        </Grid>

                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                     Height="5" CornerRadius="2.5" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 2: Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Show in Folder Button -->
                                    <Button Click="OpenFile_Click"
                                            IsEnabled="{Binding IsDownloaded, Mode=OneWay}"
                                            ToolTipService.ToolTip="Show downloaded file in File Explorer">
                                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                                    </Button>

                                    <!-- Primary Deployment Action Button -->
                                    <Button Content="{Binding ActionLabel, Mode=OneWay}"
                                            Click="RunInstaller_Click"
                                            IsEnabled="{Binding IsDownloaded, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="14,7"
                                            MinWidth="110"
                                            FontWeight="SemiBold" />

                                    <!-- Uninstall / Remove Button -->
                                    <Button Click="Uninstall_Click"
                                            IsEnabled="{Binding IsInstalled, Mode=OneWay}"
                                            Visibility="{Binding SupportsUninstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{Binding UninstallLabel, Mode=OneWay}"
                                            Padding="10,7">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            <TextBlock Text="{Binding UninstallLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- No Filter Results State (When queue has items but filter matched none) -->
            <StackPanel x:Name="NoFilterResultsPanel" Grid.Row="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No downloads match the active search or status filter"
                           Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Try clearing the search box or selecting 'All' in the filter tabs."
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ══════════════════════════════════ -->
            <!--  ACTIVITY LOG PANEL (Collapsible)  -->
            <!-- ══════════════════════════════════ -->
            <Border Grid.Row="1" x:Name="LogPanel"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="0"
                    Visibility="Collapsed">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Log Header -->
                    <Border Grid.Row="0" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            Padding="14,8" CornerRadius="8,8,0,0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="14"
                                      Foreground="{ThemeResource CustomAccentPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Activity &amp; Diagnostic Log"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                                <TextBlock Text="Live process and verification output"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Click="CopyLog_Click" Padding="8,4" ToolTipService.ToolTip="Copy log to clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                        <TextBlock Text="Copy Log" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ClearLog_Click" Padding="8,4" ToolTipService.ToolTip="Clear all log entries">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE894;" FontSize="11" />
                                        <TextBlock Text="Clear" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log Entries -->
                    <ListView Grid.Row="1" x:Name="LogList"
                              SelectionMode="None" IsItemClickEnabled="False"
                              MaxHeight="200"
                              Padding="6,4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="6,3" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1" Glyph="{Binding SeverityGlyph}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ToolName}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  EMPTY STATE                       -->
        <!-- ══════════════════════════════════ -->
        <Grid
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            MaxWidth="460">
            <StackPanel Spacing="18" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="28"
                              Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="No downloads queued"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Browse 90+ curated DevOps CLIs and developer tools in the catalog, or batch-install a complete curated workstation stack."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Content="Browse Tool Catalog"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="GoToCatalog_Click"
                            Padding="16,8" FontWeight="SemiBold" />
                    <Button Content="Explore Stacks"
                            Click="GoToStacks_Click"
                            Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
