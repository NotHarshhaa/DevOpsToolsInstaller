<Page
    x:Class="DevOpsToolsInstaller.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models"
    xmlns:services="using:DevOpsToolsInstaller.Services">

    <Grid Padding="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  HEADER                            -->
        <!-- ══════════════════════════════════ -->
        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Downloads &amp; Deployments" Style="{StaticResource PageTitleStyle}" />
                <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveCountBadge" Text="Ready"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Text="Track progress, launch installers, and manage extracted CLI binaries."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- ══════════════════════════════════ -->
        <!--  COMMAND BAR                       -->
        <!-- ══════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Open folder button -->
                <Button Grid.Column="0" Click="OpenFolder_Click" CornerRadius="4" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                        <TextBlock Text="Open downloads folder" />
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />

                <!-- Status text -->
                <TextBlock Grid.Column="2" x:Name="StatusText" VerticalAlignment="Center"
                           Margin="4,0,0,0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Toggle activity log button -->
                <ToggleButton Grid.Column="3" x:Name="LogToggle" Click="LogToggle_Click"
                              CornerRadius="4" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="13" />
                        <TextBlock Text="Activity Log" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════ -->
        <!--  MAIN CONTENT AREA                 -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="2" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="LogRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Download list -->
            <ListView
                x:Name="DownloadsList"
                Grid.Row="0"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Padding="0,2,0,10">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ContentThemeTransition />
                        <ReorderThemeTransition />
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DownloadItemCardStyle}">
                            <Grid ColumnSpacing="14" Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Tool icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="20"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Width="28" Height="28" Stretch="Uniform"
                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                    </Grid>
                                </Border>

                                <!-- Info + progress -->
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <!-- Top row: name + kind badge + status text -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NameWithVersion}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Border Style="{StaticResource BadgeStyle}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource BadgeStyle}"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="{Binding SignatureSummary}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="{Binding SignatureResult.Glyph, FallbackValue='&#xE9CE;'}" FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding SignatureResult.StatusBadge, FallbackValue='Checking signature…'}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Status label -->
                                        <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Progress bar section -->
                                    <StackPanel Spacing="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Downloading…"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="11">
                                                <Run Text="{Binding Progress, Mode=OneWay}" /><Run Text="%" />
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                     Height="4" CornerRadius="2" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding ActionLabel, Mode=OneWay}"
                                            Click="RunInstaller_Click"
                                            IsEnabled="{Binding IsDownloaded, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="14,6"
                                            MinWidth="110"
                                            HorizontalAlignment="Stretch" />

                                    <Button Click="Uninstall_Click"
                                            IsEnabled="{Binding IsInstalled, Mode=OneWay}"
                                            Visibility="{Binding SupportsUninstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{Binding UninstallLabel, Mode=OneWay}"
                                            CornerRadius="4" Padding="10,6"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            <TextBlock Text="{Binding UninstallLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ══════════════════════════════════ -->
            <!--  ACTIVITY LOG PANEL (Collapsible)  -->
            <!-- ══════════════════════════════════ -->
            <Border Grid.Row="1" x:Name="LogPanel"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="0"
                    Visibility="Collapsed">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Log header -->
                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Activity Log"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="ClearLog_Click" Padding="8,4" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE894;" FontSize="11" />
                                <TextBlock Text="Clear" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Log entries -->
                    <ListView Grid.Row="1" x:Name="LogList"
                              SelectionMode="None" IsItemClickEnabled="False"
                              MaxHeight="200"
                              Padding="4,0,4,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1" Glyph="{Binding SeverityGlyph}" FontSize="11"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ToolName}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  EMPTY STATE                       -->
        <!-- ══════════════════════════════════ -->
        <Grid
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            MaxWidth="380">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="36"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="No downloads queued"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Head over to the Tool Catalog to pick the DevOps tools you want on your workstation."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </StackPanel>

                <Button Content="Browse Tool Catalog"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="GoToCatalog_Click"
                        Padding="16,8" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
