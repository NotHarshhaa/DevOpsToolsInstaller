<Page
    x:Class="DevOpsToolsInstaller.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models">

    <Grid Padding="32,28,32,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <TextBlock Text="Tool Catalog" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Select the tools you need or pick a curated stack preset to download in one go."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Command bar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                x:Name="SearchBox"
                PlaceholderText="Search tools, categories, descriptions…"
                QueryIcon="Find"
                MaxWidth="420"
                HorizontalAlignment="Left"
                TextChanged="SearchBox_TextChanged" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Presets dropdown -->
                <DropDownButton x:Name="PresetsButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71D;" FontSize="13" />
                        <TextBlock Text="Presets" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Kubernetes Core" Tag="k8s" Click="Preset_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Cloud Foundation" Tag="cloud" Click="Preset_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE753;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Infrastructure as Code" Tag="iac" Click="Preset_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Security &amp; Secrets" Tag="sec" Click="Preset_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Modern Terminal &amp; CLI" Tag="cli" Click="Preset_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE756;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button x:Name="SelectAllButton" Click="SelectAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE762;" FontSize="13" />
                        <TextBlock Text="Select all" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearButton" Click="Clear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE894;" FontSize="13" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>

                <!-- Cancel Button when active -->
                <Button x:Name="CancelButton" Visibility="Collapsed" Click="CancelDownload_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>

                <Button x:Name="DownloadButton" Style="{StaticResource AccentButtonStyle}" Click="Download_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="13"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Download selected" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Category Filter Chips Bar -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
            <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="6" Padding="0,2,0,4">
                <Button Content="All Tools" Tag="All" Click="CategoryChip_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" />
                <Button Content="Cloud CLIs" Tag="Cloud CLIs" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Containerization" Tag="Containerization" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Kubernetes" Tag="Kubernetes" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Infrastructure as Code" Tag="Infrastructure as Code" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="CI/CD" Tag="CI/CD and Version Control" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Monitoring" Tag="Monitoring and Observability" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Security" Tag="Security" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Terminals &amp; Editors" Tag="Editors and Terminals" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Utilities" Tag="Utilities" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Tool list with fluid staggered transitions -->
        <ListView
            x:Name="ToolsList"
            Grid.Row="3"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,4,0,28">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <ReorderThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Padding="2,16,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Key}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding Count}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListViewCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinWidth="0"
                                VerticalAlignment="Center" />

                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="20"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image Width="26" Height="26" Stretch="Uniform"
                                           Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                           ImageFailed="LogoImage_ImageFailed" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NameWithVersion}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Style="{StaticResource AccentBadgeStyle}">
                                    <TextBlock Text="{Binding KindLabel}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeStyle}">
                                    <TextBlock Text="{Binding Category}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Tool Inspector Details Button -->
                            <Button Grid.Column="4" Click="ToolDetails_Click"
                                    ToolTipService.ToolTip="Inspect tool specifications and documentation"
                                    Padding="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
