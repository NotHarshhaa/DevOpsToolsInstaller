<Page
    x:Class="DevOpsToolsInstaller.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models">

    <Grid Padding="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  HEADER                            -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Tool Catalog" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderCountBadge" Text="All tools"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Select the tools you need or pick a curated stack preset to download in one go."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  COMMAND BAR                       -->
        <!-- ══════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <AutoSuggestBox
                    Grid.Column="0"
                    x:Name="SearchBox"
                    PlaceholderText="Search tools, categories, descriptions…"
                    QueryIcon="Find"
                    MaxWidth="400"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    TextChanged="SearchBox_TextChanged" />

                <!-- Right-side toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="18" Height="18" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,4,0"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Separator -->
                    <Border Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="2,0" />

                    <!-- Sort dropdown -->
                    <DropDownButton x:Name="SortButton" CornerRadius="4" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                            <TextBlock Text="Sort" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="A → Z" Tag="az" Click="Sort_Click" />
                                <MenuFlyoutItem Text="Z → A" Tag="za" Click="Sort_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="By Category" Tag="category" Click="Sort_Click" />
                                <MenuFlyoutItem Text="By Kind" Tag="kind" Click="Sort_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Downloaded first" Tag="downloaded" Click="Sort_Click" />
                                <MenuFlyoutItem Text="Favorites first" Tag="favorites" Click="Sort_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Downloaded-only toggle -->
                    <ToggleButton x:Name="DownloadedOnlyToggle" Click="DownloadedOnly_Click"
                                  CornerRadius="4" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="Downloaded" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Separator -->
                    <Border Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="2,0" />

                    <!-- Presets dropdown -->
                    <DropDownButton x:Name="PresetsButton" CornerRadius="4" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71D;" FontSize="13" />
                            <TextBlock Text="Presets" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Kubernetes Core" Tag="k8s" Click="Preset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Cloud Foundation" Tag="cloud" Click="Preset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE753;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="DevOps Essentials" Tag="essentials" Click="Preset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Security &amp; Scanning" Tag="security" Click="Preset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="CI/CD &amp; Git" Tag="cicd" Click="Preset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Infrastructure as Code" Tag="iac" Click="Preset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Select all -->
                    <Button x:Name="SelectAllButton" Click="SelectAll_Click" CornerRadius="4" Padding="10,6"
                            ToolTipService.ToolTip="Select all visible tools">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B3;" FontSize="13" />
                            <TextBlock Text="Select all" />
                        </StackPanel>
                    </Button>

                    <!-- Clear selection -->
                    <Button x:Name="ClearButton" Click="Clear_Click" CornerRadius="4" Padding="10,6"
                            ToolTipService.ToolTip="Deselect all tools">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontSize="13" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="2,0" />

                    <!-- Profile Export/Import menu -->
                    <DropDownButton x:Name="ProfileButton" CornerRadius="4" Padding="10,6"
                                    ToolTipService.ToolTip="Import or export tool selection profile">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="Profile" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Export Selection…" Click="Export_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;" />
                                    </MenuFlyoutItem.Icon>
                                								</MenuFlyoutItem>
                                <MenuFlyoutItem Text="Import Profile…" Click="Import_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Cancel button -->
                    <Button x:Name="CancelButton" Visibility="Collapsed" Click="CancelDownload_Click"
                            CornerRadius="4" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>

                    <!-- Download CTA button -->
                    <Button x:Name="DownloadButton" Style="{StaticResource AccentButtonStyle}"
                            Click="Download_Click" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="Download selected" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════ -->
        <!--  CATEGORY FILTER CHIPS             -->
        <!-- ══════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
            <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="4" Padding="0,2,0,2">
                <Button Content="All Tools"                  Tag="All"                          Click="CategoryChip_Click" Style="{StaticResource SelectedCategoryChipStyle}" />
                <Button Content="Favorites"                  Tag="Favorites"                    Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Cloud CLIs"                 Tag="Cloud CLIs"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Containerization"           Tag="Containerization"             Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Kubernetes"                 Tag="Kubernetes"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Infrastructure as Code"     Tag="Infrastructure as Code"      Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="CI/CD &amp; Version Control" Tag="CI/CD and Version Control"   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Monitoring &amp; Observability" Tag="Monitoring and Observability" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Security"                   Tag="Security"                     Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Editors &amp; Terminals"    Tag="Editors and Terminals"       Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                <Button Content="Utilities"                  Tag="Utilities"                    Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════ -->
        <!--  TOOL LIST                         -->
        <!-- ══════════════════════════════════ -->
        <ListView
            x:Name="ToolsList"
            Grid.Row="3"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,2,0,20">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <ReorderThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>

            <!-- Group headers -->
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Padding="0,14,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Key}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding Count}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <!-- Tool item template -->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListViewCardStyle}">
                        <Grid ColumnSpacing="10" Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Favorite star button -->
                            <Button Grid.Column="0" Click="ToggleFavorite_Click"
                                    Padding="4" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Toggle favorite">
                                <FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="15"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>

                            <!-- Checkbox -->
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinWidth="0"
                                VerticalAlignment="Center" />

                            <!-- Tool icon -->
                            <Border Grid.Column="2" Width="40" Height="40" CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="18"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image Width="28" Height="28" Stretch="Uniform"
                                           Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                           ImageFailed="LogoImage_ImageFailed" />
                                </Grid>
                            </Border>

                            <!-- Tool name + description -->
                            <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NameWithVersion}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Badges -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource BadgeStyle}">
                                    <TextBlock Text="{Binding KindLabel}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeStyle}">
                                    <TextBlock Text="{Binding Category}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Copy command button -->
                            <Button Grid.Column="5" Click="CopyCommand_Click"
                                    ToolTipService.ToolTip="Copy install command to clipboard"
                                    Padding="6" VerticalAlignment="Center"
                                    CornerRadius="4">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>

                            <!-- Details button -->
                            <Button Grid.Column="6" Click="ToolDetails_Click"
                                    ToolTipService.ToolTip="Inspect tool specifications"
                                    Padding="6,5" VerticalAlignment="Center"
                                    CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE946;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Details" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
