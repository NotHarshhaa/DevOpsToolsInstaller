<Page
    x:Class="DevOpsToolsInstaller.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models"
    xmlns:controls="using:DevOpsToolsInstaller.Controls">

    <Grid Padding="32,20,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  HEADER                            -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Tool Catalog" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderCountBadge" Text="All tools"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Select the tools you need or pick a curated stack preset to download in one go."
                           Style="{StaticResource PageSubtitleStyle}" />

                <!-- Active Curated Stack InfoBar -->
                <InfoBar
                    x:Name="ActiveStackInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Informational"
                    Title="Stack Filter Active"
                    Message="Showing only tools belonging to this curated stack. All tools in this stack are pre-selected for installation."
                    Margin="0,8,0,0"
                    CornerRadius="6"
                    Closed="ActiveStackInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Show All 90 Tools" Click="ClearStackFilter_Click" Padding="12,5" CornerRadius="4" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  COMMAND BAR                       -->
        <!-- ══════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8"
                SizeChanged="CommandBar_SizeChanged">
            <Grid x:Name="CommandBarGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="SecondRowDef" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SearchColDef" Width="*" />
                    <ColumnDefinition x:Name="ToolbarColDef" Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <AutoSuggestBox
                    Grid.Row="0" Grid.Column="0"
                    x:Name="SearchBox"
                    PlaceholderText="Search tools, categories, descriptions…"
                    QueryIcon="Find"
                    MinWidth="180"
                    MaxWidth="360"
                    HorizontalAlignment="Stretch"
                    CornerRadius="4"
                    TextChanged="SearchBox_TextChanged" />

                <!-- Dynamic responsive toolbar options -->
                <controls:WrapPanel
                    Grid.Row="0" Grid.Column="1"
                    x:Name="ToolbarPanel"
                    HorizontalSpacing="6"
                    VerticalSpacing="6">
                    <ProgressRing x:Name="BusyRing" Width="18" Height="18" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,4,0"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Separator 1 -->
                    <Border x:Name="Separator1" Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="2,0" />

                    <!-- Sort dropdown -->
                    <DropDownButton x:Name="SortButton" CornerRadius="4" Padding="10,6"
                                    ToolTipService.ToolTip="Sort tools">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                            <TextBlock x:Name="SortButtonText" Text="Sort" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="A → Z" Tag="az" Click="Sort_Click" />
                                <MenuFlyoutItem Text="Z → A" Tag="za" Click="Sort_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="By Category" Tag="category" Click="Sort_Click" />
                                <MenuFlyoutItem Text="By Kind" Tag="kind" Click="Sort_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Downloaded first" Tag="downloaded" Click="Sort_Click" />
                                <MenuFlyoutItem Text="Favorites first" Tag="favorites" Click="Sort_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Downloaded-only toggle -->
                    <ToggleButton x:Name="DownloadedOnlyToggle" Click="DownloadedOnly_Click"
                                  CornerRadius="4" Padding="10,6"
                                  ToolTipService.ToolTip="Filter downloaded tools only">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock x:Name="DownloadedToggleText" Text="Downloaded" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Separator 2 -->
                    <Border x:Name="Separator2" Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="2,0" />

                    <!-- Presets dropdown -->
                    <DropDownButton x:Name="PresetsButton" CornerRadius="4" Padding="10,6"
                                    ToolTipService.ToolTip="Curated tool preset stacks">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71D;" FontSize="13" />
                            <TextBlock x:Name="PresetsButtonText" Text="Presets" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="PresetsMenuFlyout" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Select all -->
                    <Button x:Name="SelectAllButton" Click="SelectAll_Click" CornerRadius="4" Padding="10,6"
                            ToolTipService.ToolTip="Select all visible tools">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B3;" FontSize="13" />
                            <TextBlock x:Name="SelectAllButtonText" Text="Select all" />
                        </StackPanel>
                    </Button>

                    <!-- Clear selection -->
                    <Button x:Name="ClearButton" Click="Clear_Click" CornerRadius="4" Padding="10,6"
                            ToolTipService.ToolTip="Deselect all tools">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontSize="13" />
                            <TextBlock x:Name="ClearButtonText" Text="Clear" />
                        </StackPanel>
                    </Button>

                    <!-- Separator 3 -->
                    <Border x:Name="Separator3" Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="2,0" />

                    <!-- Profile Export/Import menu -->
                    <DropDownButton x:Name="ProfileButton" CornerRadius="4" Padding="10,6"
                                    ToolTipService.ToolTip="Import or export tool selection profile">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock x:Name="ProfileButtonText" Text="Profile" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Export Selection…" Click="Export_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Import Profile…" Click="Import_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Cancel button -->
                    <Button x:Name="CancelButton" Visibility="Collapsed" Click="CancelDownload_Click"
                            CornerRadius="4" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>

                    <!-- Download CTA button -->
                    <Button x:Name="DownloadButton" Style="{StaticResource AccentButtonStyle}"
                            Click="Download_Click" Padding="12,6"
                            ToolTipService.ToolTip="Download and install selected tools">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock x:Name="DownloadButtonText" Text="Download selected" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </controls:WrapPanel>
        </Grid>
    </Border>

        <!-- ══════════════════════════════════ -->
        <!--  CATEGORY FILTER CHIPS             -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Scroll Left Button -->
            <Button Grid.Column="0" x:Name="ScrollLeftButton" Click="ScrollLeft_Click"
                    CornerRadius="4" Padding="6,6" VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Scroll left">
                <FontIcon Glyph="&#xE76B;" FontSize="11" />
            </Button>

            <!-- Scrollable Chips Container -->
            <ScrollViewer Grid.Column="1" x:Name="ChipsScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          ViewChanged="ChipsScrollViewer_ViewChanged"
                          SizeChanged="ChipsScrollViewer_SizeChanged">
                <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="6" Padding="0,2,0,2">
                    <Button Content="All Tools"                  Tag="All"                          Click="CategoryChip_Click" Style="{StaticResource SelectedCategoryChipStyle}" />
                    <Button Content="Favorites"                  Tag="Favorites"                    Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Cloud CLIs"                 Tag="Cloud CLIs"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Containerization"           Tag="Containerization"             Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Kubernetes"                 Tag="Kubernetes"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Infrastructure as Code"     Tag="Infrastructure as Code"      Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="CI/CD &amp; Version Control" Tag="CI/CD and Version Control"   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Monitoring &amp; Observability" Tag="Monitoring and Observability" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Security"                   Tag="Security"                     Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Networking"                 Tag="Networking"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Policy &amp; Compliance"    Tag="Policy and Compliance"        Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Database &amp; Data"        Tag="Database and Data"            Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Editors &amp; Terminals"    Tag="Editors and Terminals"       Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Utilities"                  Tag="Utilities"                    Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Scroll Right Button -->
            <Button Grid.Column="2" x:Name="ScrollRightButton" Click="ScrollRight_Click"
                    CornerRadius="4" Padding="6,6" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Scroll right">
                <FontIcon Glyph="&#xE76C;" FontSize="11" />
            </Button>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  REDESIGNED TOOL CARDS GRID        -->
        <!-- ══════════════════════════════════ -->
        <GridView
            x:Name="ToolsGridView"
            Grid.Row="3"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,6,0,8"
            HorizontalAlignment="Stretch"
            SizeChanged="ToolsGridView_SizeChanged">
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="ToolsItemsWrapGrid" Orientation="Horizontal" ItemWidth="360" ItemHeight="155" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="145" MaxHeight="155">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Tool Specifications…" Click="ToolDetails_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Switch Version…" Click="VersionPicker_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8EC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Copy Install Command" Click="CopyCommand_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Toggle Favorite" Click="ToggleFavorite_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{Binding FavoriteGlyph}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <!-- Card Background Surface (Midnight slate in Dark, White in Light) -->
                        <Border CornerRadius="12"
                                Background="{ThemeResource CatalogCardBackgroundBrush}" />

                        <!-- Cyan Glowing Border -->
                        <Border CornerRadius="12"
                                BorderThickness="1.5"
                                BorderBrush="{ThemeResource CatalogCardBorderCyanBrush}"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsAccentPurple, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                        <!-- Purple Glowing Border -->
                        <Border CornerRadius="12"
                                BorderThickness="1.5"
                                BorderBrush="{ThemeResource CatalogCardBorderPurpleBrush}"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsAccentPurple, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Card Content Grid -->
                        <Grid Padding="18,16,18,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- TOP SECTION: Logo + Title/Category + Glowing Tech Cube -->
                            <Grid Grid.Row="0" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Tool Brand Logo -->
                                <Border Grid.Column="0" Width="44" Height="44" VerticalAlignment="Top">
                                    <Grid>
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="24"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Width="44" Height="44" Stretch="Uniform"
                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                               ImageFailed="LogoImage_ImageFailed" />
                                    </Grid>
                                </Border>

                                <!-- Tool Name & Category Pill Badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="5">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Category Pill Badge -->
                                    <Border CornerRadius="10"
                                            Background="{ThemeResource CatalogCategoryPillBackgroundBrush}"
                                            BorderBrush="{ThemeResource CatalogCategoryPillBorderBrush}"
                                            BorderThickness="1"
                                            Padding="9,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource CatalogCategoryPillForegroundBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Glowing Tech Cube in top-right corner (Interactive specifications launcher) -->
                                <Button Grid.Column="2" VerticalAlignment="Top"
                                        Background="Transparent" BorderThickness="0" Padding="4"
                                        Click="ToolDetails_Click"
                                        ToolTipService.ToolTip="View tool specifications &amp; details">
                                    <Grid>
                                        <FontIcon Glyph="&#xF158;" FontSize="15"
                                                  Foreground="{ThemeResource CatalogCubeGlyphCyanBrush}"
                                                  Visibility="{Binding IsAccentPurple, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <FontIcon Glyph="&#xF158;" FontSize="15"
                                                  Foreground="{ThemeResource CatalogCubeGlyphPurpleBrush}"
                                                  Visibility="{Binding IsAccentPurple, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- BOTTOM SECTION: Version Tag (Left) + Action Button (Right) -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Version Tag (Clickable to switch versions) -->
                                <HyperlinkButton Grid.Column="0"
                                                 Padding="0"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 Click="VersionPicker_Click"
                                                 ToolTipService.ToolTip="Click to change or select release version">
                                    <TextBlock Text="{Binding DisplayVersionWithV}"
                                               FontSize="12"
                                               Foreground="{ThemeResource CatalogVersionForegroundBrush}" />
                                </HyperlinkButton>

                                <!-- Action Button Area -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Downloading Progress Indicator -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressRing Width="16" Height="16" IsActive="True" />
                                        <TextBlock Text="Installing…" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- 1-Click Install Button (Solid Cyan in Dark, Solid Azure in Light) -->
                                    <Button Style="{StaticResource CatalogInstallButtonStyle}"
                                            Click="InstallSingleTool_Click"
                                            ToolTipService.ToolTip="Download and install this tool"
                                            Visibility="{Binding IsDownloadedOrInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <TextBlock Text="Install" />
                                    </Button>

                                    <!-- Installed Button (Purple Pill matching Helm & Git in screenshot) -->
                                    <Button Style="{StaticResource CatalogInstalledButtonStyle}"
                                            Click="InstalledAction_Click"
                                            ToolTipService.ToolTip="Tool is installed. Click for options."
                                            Visibility="{Binding IsDownloadedOrInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Installed" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- ══════════════════════════════════ -->
        <!--  FOOTER STATUS BAR                 -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="0,6,0,14" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="FooterStatusText"
                       Text="90 Tools Available | Last Sync: Just now"
                       FontSize="12"
                       Foreground="{ThemeResource CatalogFooterForegroundBrush}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <HyperlinkButton Content="Refresh Catalog" Click="RefreshCatalog_Click"
                                 FontSize="11" Padding="4,2"
                                 Foreground="{ThemeResource CatalogFooterForegroundBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
