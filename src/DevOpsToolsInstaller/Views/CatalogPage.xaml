<Page
    x:Class="DevOpsToolsInstaller.Views.CatalogPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DevOpsToolsInstaller.Models"
    xmlns:controls="using:DevOpsToolsInstaller.Controls">

    <Grid Padding="32,20,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!--  HEADER                            -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Tool Catalog" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderCountBadge" Text="All tools"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Select the tools you need or pick a curated stack preset to download in one go."
                           Style="{StaticResource PageSubtitleStyle}" />

                <!-- Active Curated Stack InfoBar -->
                <InfoBar
                    x:Name="ActiveStackInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Informational"
                    Title="Stack Filter Active"
                    Message="Showing only tools belonging to this curated stack. All tools in this stack are pre-selected for installation."
                    Margin="0,8,0,0"
                    CornerRadius="6"
                    Closed="ActiveStackInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Show All 90 Tools" Click="ClearStackFilter_Click" Padding="12,5" CornerRadius="4" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  NATIVE COMMAND BAR                -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <AutoSuggestBox
                Grid.Column="0"
                x:Name="SearchBox"
                Width="340"
                PlaceholderText="Search tools, categories, descriptions…"
                QueryIcon="Find"
                VerticalAlignment="Center"
                TextChanged="SearchBox_TextChanged" />

            <!-- Native Win11 CommandBar: overflow, hover and keyboard handling for free -->
            <CommandBar
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right"
                IsOpen="False"
                OverflowButtonVisibility="Collapsed"
                Background="Transparent">
                <CommandBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ProgressRing x:Name="BusyRing" Width="18" Height="18" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CommandBar.Content>
                <CommandBar.PrimaryCommands>
                    <AppBarButton x:Name="SortButton" Label="Sort" ToolTipService.ToolTip="Sort tools">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8CB;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="A → Z" Tag="az" Click="Sort_Click" />
                                <MenuFlyoutItem Text="Z → A" Tag="za" Click="Sort_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="By Category" Tag="category" Click="Sort_Click" />
                                <MenuFlyoutItem Text="By Kind" Tag="kind" Click="Sort_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Downloaded first" Tag="downloaded" Click="Sort_Click" />
                                <MenuFlyoutItem Text="Favorites first" Tag="favorites" Click="Sort_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarToggleButton x:Name="DownloadedOnlyToggle" Label="Downloaded" Click="DownloadedOnly_Click"
                                        ToolTipService.ToolTip="Filter downloaded tools only">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>

                    <AppBarButton x:Name="PresetsButton" Label="Presets" ToolTipService.ToolTip="Curated tool preset stacks">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71D;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout x:Name="PresetsMenuFlyout" />
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton x:Name="SelectAllButton" Label="Select all" Click="SelectAll_Click"
                                  ToolTipService.ToolTip="Select all visible tools">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B3;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton x:Name="ClearButton" Label="Clear" Click="Clear_Click"
                                  ToolTipService.ToolTip="Deselect all tools">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE894;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton x:Name="ProfileButton" Label="Profile" ToolTipService.ToolTip="Import or export tool selection profile">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Export Selection…" Click="Export_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Import Profile…" Click="Import_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton x:Name="CancelButton" Label="Cancel" Visibility="Collapsed" Click="CancelDownload_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>

            <!-- Download CTA button -->
            <Button Grid.Column="2" x:Name="DownloadButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Download_Click" Padding="14,7"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Download and install selected tools">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                    <TextBlock x:Name="DownloadButtonText" Text="Download selected" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  CATEGORY FILTER CHIPS             -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Scroll Left Button -->
            <Button Grid.Column="0" x:Name="ScrollLeftButton" Click="ScrollLeft_Click"
                    CornerRadius="4" Padding="6,6" VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Scroll left">
                <FontIcon Glyph="&#xE76B;" FontSize="11" />
            </Button>

            <!-- Scrollable Chips Container -->
            <ScrollViewer Grid.Column="1" x:Name="ChipsScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          ViewChanged="ChipsScrollViewer_ViewChanged"
                          SizeChanged="ChipsScrollViewer_SizeChanged">
                <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="6" Padding="0,2,0,2">
                    <Button Content="All Tools"                  Tag="All"                          Click="CategoryChip_Click" Style="{StaticResource SelectedCategoryChipStyle}" />
                    <Button Content="Favorites"                  Tag="Favorites"                    Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Cloud CLIs"                 Tag="Cloud CLIs"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Containerization"           Tag="Containerization"             Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Kubernetes"                 Tag="Kubernetes"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Infrastructure as Code"     Tag="Infrastructure as Code"      Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="CI/CD &amp; Version Control" Tag="CI/CD &amp; Version Control" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Monitoring &amp; Observability" Tag="Monitoring &amp; Observability" Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Security"                   Tag="Security"                     Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Networking"                 Tag="Networking"                   Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Policy &amp; Compliance"    Tag="Policy &amp; Compliance"      Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Database &amp; Data"        Tag="Database &amp; Data"          Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Editors &amp; Terminals"    Tag="Editors &amp; Terminals"      Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                    <Button Content="Utilities"                  Tag="Utilities"                    Click="CategoryChip_Click" Style="{StaticResource CategoryChipStyle}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Scroll Right Button -->
            <Button Grid.Column="2" x:Name="ScrollRightButton" Click="ScrollRight_Click"
                    CornerRadius="4" Padding="6,6" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Scroll right">
                <FontIcon Glyph="&#xE76C;" FontSize="11" />
            </Button>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!--  REDESIGNED TOOL CARDS GRID        -->
        <!-- ══════════════════════════════════ -->
        <GridView
            x:Name="ToolsGridView"
            Grid.Row="3"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,6,0,8"
            HorizontalAlignment="Stretch"
            SizeChanged="ToolsGridView_SizeChanged">
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="ToolsItemsWrapGrid" Orientation="Horizontal" ItemWidth="360" ItemHeight="145" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <!-- Standard Windows 11 Card -->
                    <Border Style="{StaticResource CardStyle}" Padding="16,14">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Tool Specifications…" Click="ToolDetails_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Switch Version…" Click="VersionPicker_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8EC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Copy Install Command" Click="CopyCommand_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Toggle Favorite" Click="ToggleFavorite_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{Binding FavoriteGlyph}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>

                        <!-- Card Interior Content Grid -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- TOP SECTION: Logo + Title/Category + Details Button -->
                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Tool Brand Logo -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Width="28" Height="28" Stretch="Uniform"
                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                               ImageFailed="LogoImage_ImageFailed" />
                                    </Grid>
                                </Border>

                                <!-- Tool Name & Category Badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Category Badge -->
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Inspect Details Button -->
                                <Button Grid.Column="2" VerticalAlignment="Top"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6,5" CornerRadius="4"
                                        Click="ToolDetails_Click"
                                        ToolTipService.ToolTip="Inspect tool specifications">
                                    <FontIcon Glyph="&#xE946;" FontSize="13"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- BOTTOM SECTION: Version Badge (Left) + Action Button (Right) -->
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Version Badge (Clickable to switch versions) -->
                                <HyperlinkButton Grid.Column="0"
                                                 Padding="0"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 Click="VersionPicker_Click"
                                                 ToolTipService.ToolTip="Select specific or previous release version">
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8EC;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding DisplayVersionWithV}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </HyperlinkButton>

                                <!-- Action Buttons with Native Fluent Hover States -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Downloading Progress Indicator -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressRing Width="16" Height="16" IsActive="True" />
                                        <TextBlock Text="Installing…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Native Windows 11 Install Button (AccentButtonStyle) -->
                                    <Button Style="{StaticResource AccentButtonStyle}"
                                            Click="InstallSingleTool_Click"
                                            Padding="14,5" CornerRadius="4"
                                            ToolTipService.ToolTip="Download and install this tool"
                                            Visibility="{Binding IsDownloadedOrInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            <TextBlock Text="Install" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Native Windows 11 Installed Button (DefaultButtonStyle with checkmark) -->
                                    <Button Style="{StaticResource DefaultButtonStyle}"
                                            Click="InstalledAction_Click"
                                            Padding="12,5" CornerRadius="4"
                                            ToolTipService.ToolTip="Tool is installed. Click for options."
                                            Visibility="{Binding IsDownloadedOrInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="Installed" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- ══════════════════════════════════ -->
        <!--  FOOTER STATUS BAR                 -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="0,6,0,14" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="FooterStatusText"
                       Text="90 Tools Available | Last Sync: Just now"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <HyperlinkButton Content="Refresh Catalog" Click="RefreshCatalog_Click"
                                 FontSize="11" Padding="4,2"
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
