<Page
    x:Class="DevOpsToolsInstaller.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="32,28,32,36">
        <StackPanel Spacing="22" MaxWidth="1020">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Header -->
            <StackPanel Spacing="3">
                <TextBlock Text="DevOps Workstation Hub" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Curated tools, zero-fuss installation, and automatic PATH setup for Windows engineers."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Hero Banner -->
            <Border Style="{StaticResource HeroCardStyle}" Padding="26">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon Graphic -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;" FontSize="28"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Text description -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Ready to configure your machine?"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Border Style="{StaticResource AccentBadgeStyle}">
                                <TextBlock Text="Verified Safe" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Browse and download official DevOps installers and CLIs. Extracted CLI tools are automatically placed in your Tools\bin folder so you're ready to code immediately." />
                    </StackPanel>

                    <!-- Primary Quick Action -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Catalog_Click" Padding="18,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="15" />
                                <TextBlock Text="Browse Catalog" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Safety notice -->
            <controls:InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Success"
                Title="Transparent &amp; Safe"
                Message="No silent background installations and no unreviewed scripts. The app downloads official vendor binaries and gives you full control." />

            <!-- Stats Grid -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Available Tools -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="ToolCountText" Text="—" Style="{StaticResource MetricNumberStyle}" />
                            <TextBlock x:Name="ToolCountLabel" Text="Loading catalog…" Style="{StaticResource MetricLabelStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Downloaded Tools -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="DownloadedCountText" Text="0" Style="{StaticResource MetricNumberStyle}" />
                            <TextBlock x:Name="DownloadedCountLabel" Text="Downloaded" Style="{StaticResource MetricLabelStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Categories -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8EC;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="CategoriesCountText" Text="7" Style="{StaticResource MetricNumberStyle}" />
                            <TextBlock Text="Categories" Style="{StaticResource MetricLabelStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quick Links -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Quick Actions" Style="{StaticResource CardTitleStyle}" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource QuickLinkButtonStyle}" Click="Catalog_Click">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Explore Tool Catalog" FontWeight="SemiBold" />
                                    <TextBlock Text="Search, filter, and batch download tools"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource QuickLinkButtonStyle}" Click="Downloads_Click">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Manage Downloads" FontWeight="SemiBold" />
                                    <TextBlock Text="Track progress and run or remove installers"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- How it works -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Streamlined Workflow" Style="{StaticResource CardTitleStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <Border Grid.Column="0" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="1" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Select Your Stack" FontWeight="SemiBold" />
                                <TextBlock Text="Filter by categories like Kubernetes, Cloud CLIs, or IaC to pick tools."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Step 2 -->
                        <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="2" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Batch Download" FontWeight="SemiBold" />
                                <TextBlock Text="Concurrent downloads with real-time progress and integrity verification."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Step 3 -->
                        <Border Grid.Column="2" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="3" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Ready on PATH" FontWeight="SemiBold" />
                                <TextBlock Text="Installers launch vendor UIs; archives and binaries deploy straight to Tools\bin."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
