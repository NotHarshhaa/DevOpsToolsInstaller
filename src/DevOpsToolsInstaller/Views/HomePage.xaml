<Page
    x:Class="DevOpsToolsInstaller.Views.HomePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appControls="using:DevOpsToolsInstaller.Controls"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:DevOpsToolsInstaller.Helpers"
    xmlns:viewmodels="using:DevOpsToolsInstaller.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">

    <appControls:PageContainer>
        <Grid>
            <!-- ══════════════════════════════════ -->
            <!--  RESPONSIVE STATES                  -->
            <!-- ══════════════════════════════════ -->
            <VisualStateManager.VisualStateGroups>
                <!-- Hero: drop the artwork and give the copy the full width when
                     there is not enough room for a two-column banner. -->
                <VisualStateGroup x:Name="HomeHeroStates">
                    <VisualState x:Name="HeroNarrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeroArtwork.Visibility" Value="Collapsed" />
                            <Setter Target="HeroTextGrid.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="HeroWide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="880" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>

                <!-- Health / recents / trends: one column when narrow, side by side
                     once there is room for both cards. -->
                <VisualStateGroup x:Name="HomeDataStates">
                    <VisualState x:Name="DataStacked">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="DataSideBySide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1180" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HealthCard.(Grid.Row)" Value="0" />
                            <Setter Target="HealthCard.(Grid.Column)" Value="0" />
                            <Setter Target="HealthCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="RecentsCard.(Grid.Row)" Value="0" />
                            <Setter Target="RecentsCard.(Grid.Column)" Value="1" />
                            <Setter Target="RecentsCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="InstallsTrendCard.(Grid.Row)" Value="0" />
                            <Setter Target="InstallsTrendCard.(Grid.Column)" Value="0" />
                            <Setter Target="InstallsTrendCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="UpdatesTrendCard.(Grid.Row)" Value="0" />
                            <Setter Target="UpdatesTrendCard.(Grid.Column)" Value="1" />
                            <Setter Target="UpdatesTrendCard.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <ScrollViewer Padding="0,0,32,24">
                <StackPanel Spacing="24">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!-- ══════════════════════════════════ -->
                    <!--  1. HERO BANNER & VALUE PROP       -->
                    <!-- ══════════════════════════════════ -->
                    <Border CornerRadius="12"
                            BorderBrush="{ThemeResource InAppSurfaceStrokeBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource InAppSurfaceFillBrush}">
                        <Grid MinHeight="150">
                            <Grid.ColumnDefinitions>
                                <!-- Copy is capped at 55% of the banner so it can never
                                     run underneath the artwork, which owns the rest. -->
                                <ColumnDefinition Width="55*" />
                                <ColumnDefinition Width="45*" />
                            </Grid.ColumnDefinitions>

                            <!-- Subtle in-app acrylic surface -->
                            <controls:SystemBackdropElement
                                Grid.ColumnSpan="2"
                                SystemBackdrop="{StaticResource InAppAcrylicBackdrop}"
                                CornerRadius="12"
                                IsHitTestVisible="False" />

                            <!-- Hero Banner Illustration, left edge faded into the surface.
                                 It lives in its own column, so the fade never lands on text. -->
                            <Grid x:Name="HeroArtwork" Grid.Column="1" IsHitTestVisible="False">
                                <Image Source="ms-appx:///Assets/HeroBanner.jpg"
                                       Stretch="UniformToFill"
                                       Opacity="0.45"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="0.0" />
                                            <GradientStop Color="#401A1A1A" Offset="0.4" />
                                            <GradientStop Color="Transparent" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>

                            <!-- Hero Content Container (text column only) -->
                            <Grid x:Name="HeroTextGrid" Grid.Column="0" Padding="26,18" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top row: App Name & Version badge -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="DevOps Tools Installer" Style="{StaticResource PageTitleStyle}" />
                                    <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE770;" FontSize="10" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <TextBlock x:Name="HeroVersionChipText" Text="v3.1.0 • WinUI 3" FontSize="11" FontWeight="Medium"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Middle row: One-line Value Proposition -->
                                <TextBlock Grid.Row="1"
                                           Text="Discover and download official DevOps tool installers in one place. Vendor setup wizards run interactively with standard UAC prompts — no silent switches."
                                           Style="{StaticResource PageSubtitleStyle}"
                                           FontSize="13"
                                           HorizontalAlignment="Left"
                                           TextWrapping="Wrap" />

                                <!-- Bottom row: Primary and Secondary CTAs -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <Button x:Name="HeroBrowseCatalogButton"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="BrowseCatalog_Click"
                                            Padding="18,9"
                                            CornerRadius="6"
                                            helpers:Motion.HoverLift="True"
                                            AutomationProperties.Name="Browse tool catalog">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                            <TextBlock Text="Browse catalog" FontWeight="SemiBold" FontSize="13" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="HeroBuildStackButton"
                                            Click="BuildStack_Click"
                                            Padding="16,9"
                                            CornerRadius="6"
                                            helpers:Motion.HoverLift="True"
                                            AutomationProperties.Name="Build a custom stack">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                            <TextBlock Text="Build a stack" FontWeight="SemiBold" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Next best action: one concrete thing to do right now, so the
                                     banner carries signal instead of dead space. -->
                                <Border Grid.Row="3"
                                        Visibility="{Binding HasNextAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Padding="10,6"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                  Glyph="&#xE7BA;"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Visibility="{Binding IsNextActionWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                  Glyph="&#xE73E;"
                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  Visibility="{Binding IsNextActionWarning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                                        <TextBlock Grid.Column="1" Text="{Binding NextActionText}"
                                                   FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.Name="{Binding NextActionText}" />

                                        <Button Grid.Column="2" Click="NextAction_Click"
                                                Tag="{Binding NextActionTag}"
                                                Padding="12,5" CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasNextActionButton, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding NextActionButtonText}" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════ -->
                    <!--  30-SECOND TOUR CALLOUT            -->
                    <!-- ══════════════════════════════════ -->
                    <Border Visibility="{Binding ShowTourBanner, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FeatureCardStyle}"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            Padding="16,12"
                            helpers:Motion.HoverLift="True">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{ThemeResource CustomAccentPrimaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource CustomAccentForegroundBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="New here? Take a 30-second tour" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Learn how to find official tools, build custom stacks, and safely deploy software."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2" Click="StartTour_Click" Style="{StaticResource AccentButtonStyle}"
                                    Padding="12,6" CornerRadius="4" AutomationProperties.Name="Start 30-second tour">
                                <TextBlock Text="Start tour" FontSize="12" FontWeight="SemiBold" />
                            </Button>

                            <Button Grid.Column="3" Click="DismissTour_Click"
                                    Padding="10,6" CornerRadius="4" AutomationProperties.Name="Dismiss tour banner">
                                <TextBlock Text="Dismiss" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════ -->
                    <!--  SHIMMER PLACEHOLDERS (LOADING)    -->
                    <!-- ══════════════════════════════════ -->
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="20" helpers:Motion.Pulse="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,4">
                            <ProgressRing IsActive="True" Width="20" Height="20" AutomationProperties.Name="Scanning workstation" />
                            <TextBlock Text="Scanning workstation tools and health…" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Metric Skeletons (4 cards) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource FeatureCardStyle}" Height="84" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Border Grid.Column="1" Style="{StaticResource FeatureCardStyle}" Height="84" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Border Grid.Column="2" Style="{StaticResource FeatureCardStyle}" Height="84" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Border Grid.Column="3" Style="{StaticResource FeatureCardStyle}" Height="84" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                        </Grid>

                        <!-- Stepper Skeleton Strip -->
                        <Border Style="{StaticResource FeatureCardStyle}" Height="76" Background="{ThemeResource ControlFillColorDefaultBrush}" />

                        <!-- Health ring + recently installed skeletons -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="7*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource FeatureCardStyle}" Height="156" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Border Grid.Column="1" Style="{StaticResource FeatureCardStyle}" Height="156" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                        </Grid>

                        <!-- Trend sparkline skeletons -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource FeatureCardStyle}" Height="104" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Border Grid.Column="1" Style="{StaticResource FeatureCardStyle}" Height="104" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                        </Grid>
                    </StackPanel>

                    <!-- Inline Error Message with Retry -->
                    <controls:InfoBar
                        IsOpen="{Binding HasError}"
                        IsClosable="False"
                        Severity="Error"
                        Title="Scan failed"
                        Message="{Binding ErrorMessage}"
                        CornerRadius="6">
                        <controls:InfoBar.ActionButton>
                            <Button Content="Retry" Click="RetryScan_Click" Padding="12,5"
                                    AutomationProperties.Name="Retry scanning workstation tools" />
                        </controls:InfoBar.ActionButton>
                    </controls:InfoBar>

                    <!-- ══════════════════════════════════ -->
                    <!--  MAIN CONTENT (WHEN NOT LOADING)   -->
                    <!-- ══════════════════════════════════ -->
                    <StackPanel Spacing="24"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">

                        <!-- ══════════════════════════════════ -->
                        <!--  2. METRICS ROW                    -->
                        <!-- ══════════════════════════════════ -->
                        <Grid x:Name="MetricGrid"
                              ColumnSpacing="12" RowSpacing="12"
                              SizeChanged="MetricGrid_SizeChanged"
                              Visibility="{Binding HasInstalledTools, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" x:Name="MetricCol0" />
                                <ColumnDefinition Width="*" x:Name="MetricCol1" />
                                <ColumnDefinition Width="*" x:Name="MetricCol2" />
                                <ColumnDefinition Width="*" x:Name="MetricCol3" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" x:Name="MetricRow0" />
                                <RowDefinition Height="Auto" x:Name="MetricRow1" />
                            </Grid.RowDefinitions>

                            <!-- Metric 1: Installed Tools -->
                            <Button x:Name="MetricCardInstalled"
                                    helpers:Motion.HoverLift="True"
                                    Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource QuickActionCardStyle}"
                                    Click="InstalledMetric_Click"
                                    AutomationProperties.Name="{Binding InstalledMetricAutomationName}">
                                <Grid Padding="16,12" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <TextBlock Text="{Binding InstalledCount}"
                                                   x:Name="MetricInstalledNumber"
                                                   Style="{StaticResource MetricNumberStyle}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <StackPanel x:Name="MetricInstalledBars"
                                                    Orientation="Horizontal" Spacing="2"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right"
                                                    Height="26" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="Installed tools"
                                               Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Grid.Row="3" Text="Manage, update or uninstall installed tools"
                                               FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>

                            <!-- Metric 2: Updates Available -->
                            <Button x:Name="MetricCardUpdates"
                                    helpers:Motion.HoverLift="True"
                                    Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource QuickActionCardStyle}"
                                    Click="UpdatesMetric_Click"
                                    AutomationProperties.Name="{Binding UpdatesMetricAutomationName}">
                                <Grid Padding="16,12" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <FontIcon Glyph="&#xE895;" FontSize="14"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  HorizontalAlignment="Left"
                                                  Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE895;" FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Left"
                                                  Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <TextBlock Text="{Binding UpdateCount}"
                                                   x:Name="MetricUpdatesNumberCaution"
                                                   Style="{StaticResource MetricNumberStyle}"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding UpdateCount}"
                                                   x:Name="MetricUpdatesNumberPlain"
                                                   Style="{StaticResource MetricNumberStyle}"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <StackPanel x:Name="MetricUpdatesBars"
                                                    Orientation="Horizontal" Spacing="2"
                                                    Height="26"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="Updates available"
                                               Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Grid.Row="3" Text="Newer releases are waiting in the catalog"
                                               FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Grid.Row="3" Text="Everything is on the latest version"
                                               FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                </Grid>
                            </Button>

                            <!-- Metric 3: Active Downloads -->
                            <Button x:Name="MetricCardDownloads"
                                    helpers:Motion.HoverLift="True"
                                    Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource QuickActionCardStyle}"
                                    Click="DownloadsMetric_Click"
                                    AutomationProperties.Name="{Binding DownloadsMetricAutomationName}">
                                <Grid Padding="16,12" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <TextBlock Text="{Binding ActiveDownloadsCount}"
                                                   x:Name="MetricDownloadsNumber"
                                                   Style="{StaticResource MetricNumberStyle}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <StackPanel x:Name="MetricDownloadsBars"
                                                    Orientation="Horizontal" Spacing="2"
                                                    Height="26"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="Downloading"
                                               Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Grid.Row="3" Text="Live transfer speed and validation progress"
                                               FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>

                            <!-- Metric 4: Needs attention (deep-links to Doctor).
                                 The card always navigates, so the clickable affordance is
                                 unambiguous; the reason is shown inline instead of in a flyout. -->
                            <Button x:Name="MetricCardPath"
                                    helpers:Motion.HoverLift="True"
                                    Grid.Row="0" Grid.Column="3"
                                    Style="{StaticResource QuickActionCardStyle}"
                                    Click="PathMetric_Click"
                                    AutomationProperties.Name="{Binding PathMetricAutomationName}">
                                <Grid Padding="16,12" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left"
                                                  Visibility="{Binding IsPathHealthy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Left"
                                                  Visibility="{Binding IsPathHealthy, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding PathStatus}"
                                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Visibility="{Binding IsPathHealthy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Grid.Row="1" Text="{Binding PathStatus}"
                                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding IsPathHealthy, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                                    <TextBlock Grid.Row="2" Text="Workstation health"
                                               Style="{StaticResource MetricLabelStyle}" />

                                    <!-- The reason: why it needs attention, in the card itself -->
                                    <TextBlock Grid.Row="3" Text="{Binding PathReason}"
                                               FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               AutomationProperties.Name="{Binding PathReason}" />
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- ══════════════════════════════════ -->
                        <!--  3. CORE FEATURES (COLLAPSIBLE)    -->
                        <!-- ══════════════════════════════════ -->
                        <Expander x:Name="CoreFeaturesExpander"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  IsExpanded="False"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Expander.Header>
                                <StackPanel Spacing="2" Padding="0,6,0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="13" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <TextBlock Text="Core features" Style="{StaticResource SectionHeaderStyle}" FontSize="16" />
                                        <Border Style="{StaticResource BadgeStyle}">
                                            <TextBlock Text="9 capabilities" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Everything you need to provision and maintain a secure DevOps workstation"
                                               Style="{StaticResource PageSubtitleStyle}" />
                                </StackPanel>
                            </Expander.Header>

                            <ItemsRepeater ItemsSource="{Binding CoreFeatures}" Margin="0,6,0,4">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="310"
                                                       MinRowSpacing="12"
                                                       MinColumnSpacing="12"
                                                       MaximumRowsOrColumns="3"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:HomeFeatureCardViewModel">
                                        <Border Style="{StaticResource FeatureCardStyle}"
                                                helpers:Motion.HoverLift="True"
                                                AutomationProperties.Name="{x:Bind AutomationName}">
                                            <Grid RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Accent Icon Badge -->
                                                <Grid Grid.Row="0">
                                                    <Border Style="{StaticResource FeatureIconBadgeStyle}" HorizontalAlignment="Left">
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                                  Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>

                                                <!-- Card Title -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{x:Bind Title}"
                                                           Style="{StaticResource CardTitleStyle}"
                                                           FontSize="15" />

                                                <!-- Benefit Description -->
                                                <TextBlock Grid.Row="2"
                                                           Text="{x:Bind Benefit}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Top" />

                                                <!-- Action Button / Link -->
                                                <Button Grid.Row="3"
                                                        Click="FeatureCardAction_Click"
                                                        Tag="{x:Bind NavigationTarget}"
                                                        HorizontalAlignment="Stretch"
                                                        Padding="12,6"
                                                        CornerRadius="4"
                                                        AutomationProperties.Name="{x:Bind ActionLabel}">
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind ActionLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                        <FontIcon Glyph="&#xE76C;" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>

                        <!-- ══════════════════════════════════ -->
                        <!--  4. WORKSTATION HEALTH + RECENT     -->
                        <!-- ══════════════════════════════════ -->
                        <Grid x:Name="HealthRecentsGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Health ring, computed from the fast Doctor subset -->
                            <Border x:Name="HealthCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource CardStyle}" Padding="16,14">
                                <Grid ColumnSpacing="16" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0" Width="88" Height="88" VerticalAlignment="Top"
                                          AutomationProperties.Name="{Binding HealthRingAutomationName}">
                                        <ProgressRing IsActive="True" IsIndeterminate="False"
                                                      Minimum="0" Maximum="100" Value="{Binding HealthScore}"
                                                      Width="88" Height="88"
                                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                      Visibility="{Binding IsHealthHealthy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ProgressRing IsActive="True" IsIndeterminate="False"
                                                      Minimum="0" Maximum="100" Value="{Binding HealthScore}"
                                                      Width="88" Height="88"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      Visibility="{Binding IsHealthDegraded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ProgressRing IsActive="True" IsIndeterminate="False"
                                                      Minimum="0" Maximum="100" Value="{Binding HealthScore}"
                                                      Width="88" Height="88"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                      Visibility="{Binding IsHealthCritical, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding HealthScoreText}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Grid>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE95E;" FontSize="13" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <TextBlock Text="Workstation health" Style="{StaticResource CardTitleStyle}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding HealthHeadline}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                   Visibility="{Binding IsHealthHealthy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding HealthHeadline}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding IsHealthDegraded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding HealthHeadline}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding IsHealthCritical, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding HealthHeadline}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasHealthData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                                        <TextBlock Text="{Binding HealthCountsText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding HealthDetail}"
                                                   FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <!-- Actions get their own full-width row so they can never
                                         clip when the card is narrow. -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                        <Button Click="RunDoctor_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Padding="14,6" CornerRadius="4"
                                                AutomationProperties.Name="Run full workstation diagnostics">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE95E;" FontSize="11" />
                                                <TextBlock Text="Run Doctor" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Open tools folder" Click="OpenBinFolder_Click"
                                                Padding="12,6" CornerRadius="4"
                                                AutomationProperties.Name="Open tools bin folder in File Explorer" />
                                        <HyperlinkButton Content="Copy PATH folder" Click="CopyBinFolder_Click" FontSize="12"
                                                         AutomationProperties.Name="Copy binary folder path to clipboard" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Recently installed, from the local install history -->
                            <Border x:Name="RecentsCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource CardStyle}" Padding="16,14">
                                <Grid>
                                    <StackPanel Spacing="6"
                                                Visibility="{Binding HasRecentInstalls, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                                <TextBlock Text="Recently installed" Style="{StaticResource CardTitleStyle}" />
                                            </StackPanel>
                                            <HyperlinkButton Grid.Column="1" Content="Manage tools" FontSize="12"
                                                             Click="InstalledMetric_Click"
                                                             AutomationProperties.Name="Manage installed tools" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding RecentInstalls}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="10" Padding="0,7"
                                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                          BorderThickness="0,0,0,1"
                                                          AutomationProperties.Name="{Binding AutomationLabel}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="12"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                            <TextBlock Text="{Binding Version}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Style="{StaticResource BadgeStyle}">
                                                                <TextBlock Text="{Binding ActionLabel}" FontSize="10"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Friendly empty state until there is history -->
                                    <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Padding="0,10"
                                                Visibility="{Binding HasRecentInstalls, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="24"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center" />
                                        <TextBlock Text="No installs recorded yet" FontWeight="SemiBold" FontSize="13"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Install your first tool and it will show up here, newest first."
                                                   FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ══════════════════════════════════ -->
                        <!--  5. LOCAL ACTIVITY TRENDS          -->
                        <!-- ══════════════════════════════════ -->
                        <Grid x:Name="TrendGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Installs per day -->
                            <Border x:Name="InstallsTrendCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource CardStyle}" Padding="14,12">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <TextBlock Text="Installs by day" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding InstallsTrendTotalText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Height="72">
                                        <lvc:CartesianChart x:Name="InstallsTrendChart" Visibility="Collapsed"
                                                            Series="{x:Bind InstallsTrendSeries, Mode=OneTime}"
                                                            XAxes="{x:Bind InstallsTrendXAxes, Mode=OneTime}"
                                                            YAxes="{x:Bind InstallsTrendYAxes, Mode=OneTime}"
                                                            TooltipPosition="Hidden"
                                                            AutomationProperties.Name="Installs per day chart" />
                                        <TextBlock x:Name="InstallsTrendEmpty"
                                                   Text="No activity yet — installs are recorded locally and charted here."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding TrendRangeText}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Updates per day -->
                            <Border x:Name="UpdatesTrendCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource CardStyle}" Padding="14,12">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="Updates by day" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding UpdatesTrendTotalText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Height="72">
                                        <lvc:CartesianChart x:Name="UpdatesTrendChart" Visibility="Collapsed"
                                                            Series="{x:Bind UpdatesTrendSeries, Mode=OneTime}"
                                                            XAxes="{x:Bind UpdatesTrendXAxes, Mode=OneTime}"
                                                            YAxes="{x:Bind UpdatesTrendYAxes, Mode=OneTime}"
                                                            TooltipPosition="Hidden"
                                                            AutomationProperties.Name="Updates per day chart" />
                                        <TextBlock x:Name="UpdatesTrendEmpty"
                                                   Text="No activity yet — updates are recorded locally and charted here."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding TrendRangeText}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- 15-week activity heatmap (GitHub-style) -->
                            <Border x:Name="ActivityHeatmapCard" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource CardStyle}" Padding="14,12">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <TextBlock Text="Activity heatmap" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Lighter means a quieter day; each square is one weekday">
                                            <TextBlock Text="Less" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,2,0" />
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                                            <Border Width="10" Height="10" CornerRadius="2" Opacity="0.35" Background="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <Border Width="10" Height="10" CornerRadius="2" Opacity="0.55" Background="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <Border Width="10" Height="10" CornerRadius="2" Opacity="0.78" Background="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <TextBlock Text="More" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="HeatmapGrid" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="13" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="HeatmapEmptyText"
                                                   Text="No recorded activity yet — installs and updates show up here as colored weekdays."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Grid.RowSpan="7" Grid.ColumnSpan="15"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding ActivityHeatSummary, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- First-run search box (if no tools installed yet) -->
                        <StackPanel Spacing="8"
                                    Visibility="{Binding HasInstalledTools, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <AutoSuggestBox x:Name="SetupSearchBox"
                                            PlaceholderText="What are you setting up today? (e.g. Docker, Terraform, Kubernetes)"
                                            QueryIcon="Find"
                                            TextChanged="SetupSearchBox_TextChanged"
                                            QuerySubmitted="SetupSearchBox_QuerySubmitted"
                                            HorizontalAlignment="Stretch"
                                            MaxWidth="680"
                                            Padding="12,8"
                                            AutomationProperties.Name="Search tools or roles to set up" />
                        </StackPanel>

                        <!-- ══════════════════════════════════ -->
                        <!--  ACTIVE DOWNLOADS STRIP            -->
                        <!-- ══════════════════════════════════ -->
                        <Border CornerRadius="10" Padding="16,14,16,12"
                                BorderBrush="{ThemeResource InAppSurfaceStrokeBrush}"
                                BorderThickness="1"
                                Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid CornerRadius="10" Background="{ThemeResource InAppSurfaceFillBrush}">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Active downloads" Style="{StaticResource SectionHeaderStyle}" FontSize="15" />
                                            <Border Style="{StaticResource BadgeStyle}">
                                                <TextBlock Text="{Binding ActiveDownloadsCount}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="1" Content="View all in downloads"
                                                         Click="DownloadsMetric_Click" FontSize="12"
                                                         AutomationProperties.Name="View all items on Downloads page" />
                                    </Grid>

                                    <ListView ItemsSource="{Binding ActiveDownloads}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="False"
                                              Padding="0">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CardStyle}" Padding="14,10">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1" VerticalAlignment="Center">
                                                            <Grid>
                                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="16"
                                                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                                <Image Width="22" Height="22" Stretch="Uniform"
                                                                       Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                                <TextBlock Text="{Binding Version}" FontSize="12"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" CornerRadius="2"
                                                                         AutomationProperties.Name="{Binding AutomationLabel}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                            <TextBlock Text="{Binding ProgressPercentText}" FontWeight="SemiBold" FontSize="13"
                                                                       HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock Text="{Binding NextInQueueText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasNextInQueue, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ══════════════════════════════════ -->
                        <!--  3. QUICK START STEPPER            -->
                        <!-- ══════════════════════════════════ -->
                        <Border x:Name="StepperContainer" Style="{StaticResource FeatureCardStyle}" Padding="18,14">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                    <TextBlock Text="Quick start in 3 simple steps" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="• How DevOps Tools Installer works" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- 3 Horizontal Stepper Columns -->
                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Step 1: Pick tools -->
                                    <Border Grid.Column="0" Style="{StaticResource QuickStartStepCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource QuickStartBadgeStyle}">
                                                <TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource CustomAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Pick tools or stacks" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Select from 90 official tools or 1-click role bundles." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Step Divider 1 -->
                                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                    <!-- Step 2: Verify & download -->
                                    <Border Grid.Column="2" Style="{StaticResource QuickStartStepCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource QuickStartBadgeStyle}">
                                                <TextBlock Text="2" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource CustomAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Verify &amp; download" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Direct HTTPS transfers checked with SHA-256 &amp; Authenticode." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Step Divider 2 -->
                                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                    <!-- Step 3: Install -->
                                    <Border Grid.Column="4" Style="{StaticResource QuickStartStepCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource QuickStartBadgeStyle}">
                                                <TextBlock Text="3" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource CustomAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Install &amp; deploy" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Official wizards run interactively; CLI binaries land in PATH." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ══════════════════════════════════ -->
                        <!--  6. YOUR STACKS                    -->
                        <!-- ══════════════════════════════════ -->
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Your stacks" Style="{StaticResource SectionHeaderStyle}" FontSize="16" />
                                    <TextBlock Text="Role-based toolsets configured for specific architectures"
                                               Style="{StaticResource PageSubtitleStyle}" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="1" Click="SeeAllStacks_Click"
                                                 FontSize="12" VerticalAlignment="Center"
                                                 AutomationProperties.Name="See all tool stacks">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock x:Name="SeeAllStacksText" Text="See all" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="10" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>

                            <!-- Horizontal scrollable stack cards -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled"
                                          Padding="0,2,0,8">
                                <ItemsRepeater ItemsSource="{Binding Stacks}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}"
                                                    Width="230" MinHeight="170" Padding="14">
                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Stack Icon & Progress Badge -->
                                                    <Grid Grid.Row="0">
                                                        <Border Width="34" Height="34" CornerRadius="6"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                HorizontalAlignment="Left">
                                                            <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding InstalledProgressText}" FontSize="10"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Stack Title -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1" />

                                                    <!-- Description -->
                                                    <StackPanel Grid.Row="2" Spacing="6">
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding EstimatedSizeText}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Thin Progress Bar -->
                                                    <ProgressBar Grid.Row="3"
                                                                 Value="{Binding ProgressPercentage}"
                                                                 Maximum="100" Height="3" CornerRadius="1.5"
                                                                 AutomationProperties.Name="{Binding AutomationLabel}" />

                                                    <!-- Dynamic Action Button -->
                                                    <Button Grid.Row="4"
                                                            Click="StackAction_Click"
                                                            Tag="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            Padding="10,6" CornerRadius="4"
                                                            AutomationProperties.Name="{Binding AutomationLabel}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="{Binding ActionGlyph}" FontSize="11" />
                                                            <TextBlock Text="{Binding ActionText}" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- ══════════════════════════════════ -->
                        <!--  6. UPDATES AVAILABLE              -->
                        <!-- ══════════════════════════════════ -->
                        <Border Style="{StaticResource CardStyle}" Padding="0"
                                Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <!-- Header -->
                                <Grid Padding="16,12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="Updates available" Style="{StaticResource CardTitleStyle}" />
                                        <Border Style="{StaticResource BadgeStyle}" helpers:Motion.Pulse="True">
                                            <TextBlock Text="{Binding UpdateCount}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <HyperlinkButton Grid.Column="1"
                                                     Content="Update all"
                                                     Click="UpdateAll_Click"
                                                     Visibility="{Binding CanUpdateAll, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     FontSize="12" Padding="8,4"
                                                     AutomationProperties.Name="Update all outdated tools" />
                                </Grid>

                                <!-- Updates list -->
                                <ListView ItemsSource="{Binding Updates}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="False"
                                          Padding="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="16,10" ColumnSpacing="12"
                                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                  BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tool Icon -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" VerticalAlignment="Center">
                                                    <Grid>
                                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="16"
                                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                        <Image Width="22" Height="22" Stretch="Uniform"
                                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Version transition text -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding VersionTransitionText}"
                                                               FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="Newer version available in catalog"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- What's new + Update buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <HyperlinkButton Click="WhatsNew_Click"
                                                                     Tag="{Binding Tool}"
                                                                     Padding="4,5" FontSize="12"
                                                                     VerticalAlignment="Center"
                                                                     Content="What's new?"
                                                                     AutomationProperties.Name="Show release notes for the new version" />
                                                    <Button Click="UpdateTool_Click"
                                                            Tag="{Binding Tool}"
                                                            Padding="12,5" CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding AutomationLabel}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE895;" FontSize="11" />
                                                            <TextBlock Text="Update" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════ -->
                        <!--  7. POPULAR & ESSENTIAL TOOLS      -->
                        <!-- ══════════════════════════════════ -->
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Popular &amp; essential tools" Style="{StaticResource SectionHeaderStyle}" FontSize="15" />
                                <TextBlock Text="Core tools for container, cloud, and infrastructure workflows"
                                           Style="{StaticResource PageSubtitleStyle}" />
                            </StackPanel>

                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <ListView ItemsSource="{Binding PopularTools}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="True"
                                          ItemClick="PopularToolRow_Click"
                                          Padding="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="16,10" ColumnSpacing="12"
                                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                  BorderThickness="0,0,0,1"
                                                  AutomationProperties.Name="{Binding AutomationLabel}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tool Icon / Logo -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" VerticalAlignment="Center">
                                                    <Grid>
                                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="16"
                                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                        <Image Width="22" Height="22" Stretch="Uniform"
                                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Tool Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <Border Style="{StaticResource BadgeStyle}">
                                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Action Column: Installed badge or Install button -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource BadgeStyle}" Padding="8,4"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="11"
                                                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                            <TextBlock Text="Installed" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Click="InstallPopularTool_Click"
                                                            Tag="{Binding Tool}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                            Padding="12,5" CornerRadius="4"
                                                            AutomationProperties.Name="{Binding InstallButtonAutomationLabel}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE896;" FontSize="11" />
                                                            <TextBlock Text="Install" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════ -->
                        <!--  8. FOOTER ROW                     -->
                        <!-- ══════════════════════════════════ -->
                        <Border Margin="0,16,0,8" Padding="0,16,0,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="DevOps Tools Installer" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Zero bundled binaries • Zero silent installs • Zero telemetry"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <HyperlinkButton Content="GitHub repository"
                                                     NavigateUri="https://github.com/NotHarshhaa/DevOpsToolsInstaller"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Open GitHub repository" />
                                    <HyperlinkButton Content="Report an issue"
                                                     NavigateUri="https://github.com/NotHarshhaa/DevOpsToolsInstaller/issues"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Report an issue on GitHub" />
                                    <HyperlinkButton Content="Documentation"
                                                     NavigateUri="https://github.com/NotHarshhaa/DevOpsToolsInstaller#readme"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Open project documentation" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════ -->
            <!--  30-SECOND TOUR TEACHINGTIPS       -->
            <!-- ══════════════════════════════════ -->
            <controls:TeachingTip x:Name="TourStep1Tip"
                                  Target="{x:Bind HeroBrowseCatalogButton}"
                                  Title="1/3 • Official Tool Catalog"
                                  Subtitle="Direct from upstream vendors"
                                  PreferredPlacement="Bottom"
                                  ActionButtonContent="Next (1/3)"
                                  CloseButtonContent="Skip tour"
                                  ActionButtonClick="TourStep1_NextClick"
                                  CloseButtonClick="Tour_DismissClick"
                                  IsLightDismissEnabled="True">
                <controls:TeachingTip.Content>
                    <TextBlock Text="Browse 90+ developer tools across Cloud, Containers, Kubernetes, and IaC. Choose previous releases or filter by category."
                               TextWrapping="Wrap" FontSize="12" />
                </controls:TeachingTip.Content>
            </controls:TeachingTip>

            <controls:TeachingTip x:Name="TourStep2Tip"
                                  Target="{x:Bind HeroBuildStackButton}"
                                  Title="2/3 • Curated &amp; Custom Stacks"
                                  Subtitle="Fast-track workstation setup"
                                  PreferredPlacement="Bottom"
                                  ActionButtonContent="Next (2/3)"
                                  CloseButtonContent="Skip tour"
                                  ActionButtonClick="TourStep2_NextClick"
                                  CloseButtonClick="Tour_DismissClick"
                                  IsLightDismissEnabled="True">
                <controls:TeachingTip.Content>
                    <TextBlock Text="Install battle-tested bundles in 1-click, or use the drag-and-drop Custom Stack Builder to assemble and export your own toolset."
                               TextWrapping="Wrap" FontSize="12" />
                </controls:TeachingTip.Content>
            </controls:TeachingTip>

            <controls:TeachingTip x:Name="TourStep3Tip"
                                  Target="{x:Bind StepperContainer}"
                                  Title="3/3 • Verified &amp; Safe"
                                  Subtitle="No silent installs — vendor wizards run interactively"
                                  PreferredPlacement="Top"
                                  ActionButtonContent="Got it!"
                                  CloseButtonContent="Close"
                                  ActionButtonClick="Tour_DismissClick"
                                  CloseButtonClick="Tour_DismissClick"
                                  IsLightDismissEnabled="True">
                <controls:TeachingTip.Content>
                    <TextBlock Text="Downloads are verified with SHA-256 and Authenticode signatures. Vendor setup wizards run with native UAC prompts so you stay in control."
                               TextWrapping="Wrap" FontSize="12" />
                </controls:TeachingTip.Content>
            </controls:TeachingTip>
        </Grid>
    </appControls:PageContainer>
</Page>
