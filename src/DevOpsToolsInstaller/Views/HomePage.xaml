<Page
    x:Class="DevOpsToolsInstaller.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="20" MaxWidth="1060">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- ══════════════════════════════════ -->
            <!--  PAGE HEADER                       -->
            <!-- ══════════════════════════════════ -->
            <StackPanel Spacing="2">
                <TextBlock Text="DevOps Workstation Hub" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Curated tools, zero-fuss installation, and automatic PATH setup for Windows engineers."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- ══════════════════════════════════ -->
            <!--  UPDATE CHECKER BANNER             -->
            <!-- ══════════════════════════════════ -->
            <controls:InfoBar
                x:Name="UpdateInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Success"
                Title="Update Available"
                Message="A newer version is available."
                CornerRadius="6">
                <controls:InfoBar.ActionButton>
                    <Button Style="{StaticResource AccentButtonStyle}" Content="Update Now" Click="UpdateNow_Click" />
                </controls:InfoBar.ActionButton>
            </controls:InfoBar>

            <!-- ══════════════════════════════════ -->
            <!--  HERO BANNER                       -->
            <!-- ══════════════════════════════════ -->
            <Border Style="{StaticResource HeroCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image x:Name="HeroLogoImage" Source="ms-appx:///Assets/app.png"
                               Width="44" Height="44" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Text description -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Ready to configure your machine?"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="Verified Safe" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   Text="Browse and download official DevOps installers and CLIs. Extracted CLI tools are automatically placed in your Tools\bin folder so you're ready to code immediately." />
                        <!-- Feature pills -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <Border Style="{StaticResource BadgeStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE896;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Batch install" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE756;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Auto PATH" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Official binaries" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Primary Quick Actions -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8" MinWidth="160">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Catalog_Click"
                                Padding="16,8" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="Browse Catalog" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="Downloads_Click" Padding="16,8"
                                HorizontalAlignment="Stretch" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="View Downloads" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════ -->
            <!--  SAFETY NOTICE                     -->
            <!-- ══════════════════════════════════ -->
            <controls:InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Transparent &amp; Safe"
                Message="No silent background installations and no unreviewed scripts. The app downloads official vendor binaries and gives you full control."
                CornerRadius="6" />

            <!-- ══════════════════════════════════ -->
            <!--  STATS GRID                        -->
            <!-- ══════════════════════════════════ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Available Tools -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8F1;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Left" />
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="ToolCountText" Text="—" Style="{StaticResource MetricNumberStyle}" />
                            <TextBlock x:Name="ToolCountLabel" Text="Loading catalog…" Style="{StaticResource MetricLabelStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Downloaded Tools -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Left" />
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="DownloadedCountText" Text="0" Style="{StaticResource MetricNumberStyle}" />
                            <TextBlock x:Name="DownloadedCountLabel" Text="Downloaded" Style="{StaticResource MetricLabelStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Categories -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8EC;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Left" />
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="CategoriesCountText" Text="7" Style="{StaticResource MetricNumberStyle}" />
                            <TextBlock Text="Categories" Style="{StaticResource MetricLabelStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════ -->
            <!--  QUICK ACTIONS                     -->
            <!-- ══════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Quick Actions" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Jump directly to the section you need"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Catalog action card -->
                        <Button Grid.Column="0" Style="{StaticResource QuickActionCardStyle}"
                                Click="Catalog_Click">
                            <Grid Margin="14,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8F1;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Explore Tool Catalog" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Search, filter, and batch download tools"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Downloads action card -->
                        <Button Grid.Column="1" Style="{StaticResource QuickActionCardStyle}"
                                Click="Downloads_Click">
                            <Grid Margin="14,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Manage Downloads" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Track progress and run or remove installers"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════ -->
            <!--  CURATED TOOL STACKS               -->
            <!-- ══════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Curated Tool Stacks" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="1-click presets for popular developer &amp; DevOps workflows"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="BrowseAllBundles_Click"
                                CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F1;" FontSize="12" />
                                <TextBlock Text="Browse all 12 stacks" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Bundle 1: Kubernetes Starter -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource QuickActionCardStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="☸️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Kubernetes Starter Pack" FontWeight="SemiBold" FontSize="13" />
                                        <Border Style="{StaticResource BadgeStyle}">
                                            <TextBlock Text="7 tools" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="kubectl, Helm, k9s, Minikube, Stern, Kustomize, kubectx"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Tag="k8s-starter" Click="SelectBundle_Click"
                                        Style="{StaticResource AccentButtonStyle}" Padding="10,4" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Select this stack in catalog">
                                    <TextBlock Text="Select" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Bundle 2: Cloud Engineer Essentials -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource QuickActionCardStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="☁️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Cloud Engineer Essentials" FontWeight="SemiBold" FontSize="13" />
                                        <Border Style="{StaticResource BadgeStyle}">
                                            <TextBlock Text="8 tools" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="AWS, Azure, GCloud, Terraform, Terragrunt, Infracost, Vault"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Tag="cloud-engineer" Click="SelectBundle_Click"
                                        Style="{StaticResource AccentButtonStyle}" Padding="10,4" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Select this stack in catalog">
                                    <TextBlock Text="Select" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Bundle 3: DevSecOps Toolkit -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource QuickActionCardStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="DevSecOps Toolkit" FontWeight="SemiBold" FontSize="13" />
                                        <Border Style="{StaticResource BadgeStyle}">
                                            <TextBlock Text="8 tools" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Trivy, Gitleaks, SOPS, Cosign, Syft, Grype, OPA, Kyverno"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Tag="devops-security" Click="SelectBundle_Click"
                                        Style="{StaticResource AccentButtonStyle}" Padding="10,4" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Select this stack in catalog">
                                    <TextBlock Text="Select" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Bundle 4: Terminal Power User -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource QuickActionCardStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="💻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Terminal Power User" FontWeight="SemiBold" FontSize="13" />
                                        <Border Style="{StaticResource BadgeStyle}">
                                            <TextBlock Text="11 tools" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Windows Terminal, Starship, fzf, ripgrep, bat, fd, eza, zoxide"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Tag="terminal-poweruser" Click="SelectBundle_Click"
                                        Style="{StaticResource AccentButtonStyle}" Padding="10,4" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Select this stack in catalog">
                                    <TextBlock Text="Select" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════ -->
            <!--  HOW IT WORKS — WORKFLOW STEPS     -->
            <!-- ══════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Streamlined Workflow" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Three simple steps from zero to fully configured workstation"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <Border Grid.Column="0" CornerRadius="6"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="1" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Select Your Stack" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="Filter by categories like Kubernetes, Cloud CLIs, or IaC to pick the exact tools you need."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Connector arrow 1→2 -->
                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Center" />

                        <!-- Step 2 -->
                        <Border Grid.Column="2" CornerRadius="6"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="2" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Batch Download" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="Concurrent downloads with real-time progress tracking and integrity verification."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Connector arrow 2→3 -->
                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Center" />

                        <!-- Step 3 -->
                        <Border Grid.Column="4" CornerRadius="6"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="3" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Ready on PATH" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="Installers launch vendor UIs; archives and binaries deploy straight to Tools\bin automatically."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
