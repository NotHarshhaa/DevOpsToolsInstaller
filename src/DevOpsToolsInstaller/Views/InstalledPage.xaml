<Page
    x:Class="DevOpsToolsInstaller.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:DevOpsToolsInstaller.Models">

    <Grid Padding="32,28,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Installed Tools" Style="{StaticResource PageTitleStyle}" />
                <Border x:Name="InstalledCountBadge" Style="{StaticResource SuccessBadgeStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="10"
                                  Foreground="{ThemeResource CustomSuccessBadgeTextBrush}" />
                        <TextBlock x:Name="InstalledCountText" Text="Scanning…"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource CustomSuccessBadgeTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="Tools that have been deployed to your workstation, with version info and uninstall actions."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Command bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="Refresh_Click" CornerRadius="8" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" Width="1" Height="22"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" x:Name="StatusText" VerticalAlignment="Center"
                           Margin="4,0,0,0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Button Grid.Column="3" Click="OpenToolsFolder_Click" CornerRadius="8" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Open Tools folder" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Installed tools list -->
        <ListView
            x:Name="InstalledList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,4,0,28">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListViewCardStyle}">
                        <Grid>
                            <!-- Green left stripe for installed -->
                            <Border Width="4" CornerRadius="12,0,0,12"
                                    Background="{ThemeResource DownloadStripeDoneBrush}"
                                    HorizontalAlignment="Left" />

                            <Grid ColumnSpacing="14" Margin="16,13,14,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                        Background="{ThemeResource StatIconGreenBrush}"
                                        BorderBrush="{ThemeResource CustomSuccessBadgeBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="22"
                                                  Foreground="{ThemeResource CustomSuccessBadgeTextBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Width="32" Height="32" Stretch="Uniform"
                                               Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NameWithVersion}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Style="{StaticResource SuccessBadgeStyle}" Padding="8,2">
                                            <TextBlock Text="Installed" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource CustomSuccessBadgeTextBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource AccentBadgeStyle}" Padding="8,2">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource CustomAccentBadgeTextBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Padding="8,2">
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="{ThemeResource CustomNeutralBadgeTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Grid.Column="2" Text="{Binding Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="200"
                                           VerticalAlignment="Center" />

                                <!-- Remove button -->
                                <Button Grid.Column="3" Click="Remove_Click"
                                        CornerRadius="8" Padding="12,7"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{Binding UninstallLabel}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="{Binding UninstallLabel}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            MaxWidth="380"
            Visibility="Collapsed">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <Grid HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="40"
                        Background="{ThemeResource CustomSuccessBadgeBackgroundBrush}"
                        BorderBrush="{ThemeResource CustomSuccessBadgeBorderBrush}"
                        BorderThickness="1" />
                <FontIcon Glyph="&#xE73E;" FontSize="34"
                          Foreground="{ThemeResource CustomSuccessBadgeTextBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="No installed tools detected"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Download and deploy tools from the Catalog. Once installed, they'll appear here."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" FontSize="13" />
            <Button Content="Browse Tool Catalog"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="GoToCatalog_Click"
                    Padding="24,11" />
        </StackPanel>
    </Grid>
</Page>
