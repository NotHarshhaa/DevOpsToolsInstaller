<Page
    x:Class="DevOpsToolsInstaller.Views.InstalledPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appControls="using:DevOpsToolsInstaller.Controls"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:DevOpsToolsInstaller.Helpers"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">

    <appControls:PageContainer FullWidth="True">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════ -->
            <!--  HEADER                            -->
            <!-- ══════════════════════════════════ -->
            <appControls:PageHeader Grid.Row="0" x:Name="Header"
                                    Title="Installed Tools &amp; Updates"
                                    Subtitle="Tools deployed on your workstation with version tracking and lifecycle management.">
                <appControls:PageHeader.ActionsContent>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        PlaceholderText="Search installed tools…"
                        QueryIcon="Find"
                        Width="240"
                        CornerRadius="4"
                        TextChanged="SearchBox_TextChanged"
                        AutomationProperties.Name="Search installed tools" />
                </appControls:PageHeader.ActionsContent>
            </appControls:PageHeader>

            <!-- ══════════════════════════════════ -->
            <!--  COMMAND BAR                       -->
            <!-- ══════════════════════════════════ -->
            <!-- One stretched CommandBar owns every page-level action: the filter
                 segment sits at the left, the commands run to the right, and the
                 least important ones fold into the "…" overflow menu as the window
                 narrows. -->
            <CommandBar
                Grid.Row="1"
                x:Name="ToolsCommandBar"
                HorizontalAlignment="Stretch"
                DefaultLabelPosition="Right"
                OverflowButtonVisibility="Auto"
                Margin="0,0,32,0"
                Background="Transparent">
                <CommandBar.Content>
                    <!-- Just the filter segment: a single auto-sized control keeps
                         the toolbar's command row stable however long the status
                         line gets. The status itself lives in the footer bar.
                         NOTE: CommandBar does not stretch its content column, so
                         keeping this narrow is what stops commands from being
                         pushed into the "…" overflow as the text changes. -->
                    <tk:Segmented x:Name="FilterSegmented"
                                  Margin="0,0,12,0"
                                  AutomationProperties.Name="Installed tools filter">
                        <tk:SegmentedItem Content="All" Tag="All" IsSelected="True"
                                          ToolTipService.ToolTip="Every deployed tool" />
                        <tk:SegmentedItem Content="Updates" Tag="Updates"
                                          ToolTipService.ToolTip="Tools with a newer release available" />
                        <tk:SegmentedItem Content="Not on PATH" Tag="NotOnPath"
                                          ToolTipService.ToolTip="Installed, but not reachable from a terminal" />
                    </tk:Segmented>
                </CommandBar.Content>
                <CommandBar.PrimaryCommands>
                    <AppBarButton x:Name="UpdateAllButton" Label="Update all"
                                  Click="UpdateAll_Click"
                                  ToolTipService.ToolTip="Install the newer version of every tool with an update available">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton Label="Check updates" Click="Refresh_Click"
                                  ToolTipService.ToolTip="Re-scan the registry and filesystem and re-check every version">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton Label="Check CLIs" Click="RunAllHealthChecks_Click"
                                  ToolTipService.ToolTip="Verify execution of all command-line tools">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton Label="Shell completion" Click="ShellCompletion_Click"
                                  ToolTipService.ToolTip="Generate and configure shell completion snippets">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE756;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton Label="Open Tools folder" Click="OpenToolsFolder_Click"
                                  ToolTipService.ToolTip="Open the installed tools root folder in Windows Explorer">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE838;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton Label="Export" ToolTipService.ToolTip="Export workstation profile, audit report, and scripts">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xEDE1;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Export Audit Report (Markdown)" Click="ExportReport_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9F9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export Selection Profile (JSON)…" Click="ExportProfile_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Generate PowerShell Setup Script (.ps1)…" Click="ExportBootstrap_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE756;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export DevContainer &amp; Dockerfile (.zip)…" Click="ExportDevContainer_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>

            <!-- ══════════════════════════════════ -->
            <!--  CLI HEALTH LATENCY CHART           -->
            <!-- ══════════════════════════════════ -->
            <StackPanel Grid.Row="2" Spacing="10" Margin="0,0,32,0">

                <!-- Populated by "Check CLIs" -->
                <Border x:Name="LatencyChartCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10"
                        Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                <TextBlock Text="CLI health-check latency" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                                <TextBlock Text="probe execution time per tool, ms"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="CloseLatencyChart_Click" Padding="6,2"
                                    ToolTipService.ToolTip="Hide latency chart"
                                    AutomationProperties.Name="Hide latency chart">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>
                        <lvc:CartesianChart x:Name="LatencyChart" Height="170"
                                            Series="{x:Bind LatencySeries, Mode=OneTime}"
                                            XAxes="{x:Bind LatencyXAxes, Mode=OneTime}"
                                            YAxes="{x:Bind LatencyYAxes, Mode=OneTime}"
                                            AutomationProperties.Name="CLI health-check latency bar chart" />
                    </StackPanel>
                </Border>

                <!-- Latency chart empty state -->
                <Border x:Name="LatencyEmptyState"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No latency data yet — run “Check All CLIs” to measure the health-check response time of every installed command-line tool."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════════════════════════════ -->
            <!--  TABLE (scrolls horizontally when   -->
            <!--  the window is too narrow)          -->
            <!-- ══════════════════════════════════ -->
            <ScrollViewer x:Name="InstalledGridScroller" Grid.Row="3"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto" ZoomMode="Disabled">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="InstalledGridWidthStates">
                        <!-- Narrow: enable horizontal scrolling so no column ever clips. -->
                        <VisualState x:Name="NarrowGrid">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="InstalledGridScroller.HorizontalScrollMode" Value="Enabled" />
                            </VisualState.Setters>
                        </VisualState>
                        <!-- Wide: stretch the table to the full content width. -->
                        <VisualState x:Name="WideGrid">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1120" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="InstalledGridScroller.HorizontalScrollMode" Value="Disabled" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid MinWidth="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Loading overlay while the workstation scan runs -->
                    <Grid x:Name="InstalledLoading" Grid.Row="0" Grid.RowSpan="2"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="Collapsed" Margin="0,24">
                        <StackPanel Spacing="14" HorizontalAlignment="Center">
                            <ProgressRing x:Name="InstalledLoadingRing" Width="32" Height="32" IsActive="True" />
                            <TextBlock Text="Scanning installed tools…"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- ══════════════════════════════════ -->
                    <!--  TABLE HEADER ROW (sortable)       -->
                    <!-- ══════════════════════════════════ -->
                    <Border Grid.Row="0" Padding="16,4" Margin="0,4,32,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" MinWidth="210" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="196" />
                            </Grid.ColumnDefinitions>

                            <!-- Select every visible row -->
                            <CheckBox Grid.Column="0"
                                      x:Name="SelectAllCheckBox"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      Click="SelectAll_Click"
                                      ToolTipService.ToolTip="Select every row currently shown"
                                      AutomationProperties.Name="Select every row currently shown" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource ColumnHeaderButtonStyle}"
                                    Click="SortByName_Click"
                                    AutomationProperties.Name="Sort by name">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" />
                                    <FontIcon x:Name="SortGlyphName" Glyph="&#xE70D;" FontSize="10" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource ColumnHeaderButtonStyle}"
                                    Click="SortByStatus_Click"
                                    AutomationProperties.Name="Sort by status">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" />
                                    <FontIcon x:Name="SortGlyphStatus" Glyph="&#xE70D;" FontSize="10" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Style="{StaticResource ColumnHeaderButtonStyle}"
                                    Click="SortByVersion_Click"
                                    AutomationProperties.Name="Sort by version">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="Current Version" FontSize="12" FontWeight="SemiBold" />
                                    <FontIcon x:Name="SortGlyphVersion" Glyph="&#xE70D;" FontSize="10" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="4" Text="Actions"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════ -->
                    <!--  INSTALLED TOOLS LIST VIEW         -->
                    <!-- ══════════════════════════════════ -->
                    <ListView
                        x:Name="InstalledList"
                        Grid.Row="1"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Padding="0,0,32,12">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <ContentThemeTransition />
                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListViewCardStyle}" Padding="16,12" Margin="0,0,0,8" helpers:Motion.HoverLift="True">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" MinWidth="210" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="196" />
                                        </Grid.ColumnDefinitions>

                                        <!-- COL 0: Row selection -->
                                        <CheckBox Grid.Column="0"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="Select for bulk update or uninstall"
                                                  AutomationProperties.Name="Select this tool" />

                                        <!-- COL 1: Logo · Name · Category -->
                                        <Grid Grid.Column="1" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="18"
                                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                    <Image Width="26" Height="26" Stretch="Uniform"
                                                           Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- COL 2: Status chips — only exceptions are shown,
                                             never a badge for the ordinary case. -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                            <Border Style="{StaticResource BadgeStyle}" Padding="8,3" HorizontalAlignment="Left"
                                                    ToolTipService.ToolTip="A newer release is available in the catalog."
                                                    Visibility="{Binding HasActionableUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Update available" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource BadgeStyle}" Padding="8,3" HorizontalAlignment="Left"
                                                    ToolTipService.ToolTip="Installed, but its folder is not on the User or Machine PATH — the command will not resolve in a new terminal. Use Doctor → PATH to fix it."
                                                    Visibility="{Binding IsOnPath, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="Not on PATH" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource BadgeStyle}" Padding="8,3" HorizontalAlignment="Left"
                                                    ToolTipService.ToolTip="Your installed version is newer than the copy pinned in the tool catalog."
                                                    Visibility="{Binding IsNewerThanCatalog, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8FB;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="Newer than catalog" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- COL 3: Installed version -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding VersionColumnText}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- COL 4: One primary action plus an overflow menu. -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left">

                                            <!-- Primary: update when one is available … -->
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    Click="UpdateTool_Click"
                                                    CornerRadius="4" Padding="12,6"
                                                    Visibility="{Binding HasActionableUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="Download and install the newer version">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE896;" FontSize="12" />
                                                    <TextBlock Text="Update" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- … otherwise launch the CLI. -->
                                            <Button Click="LaunchCli_Click"
                                                    CornerRadius="4" Padding="12,6"
                                                    Visibility="{Binding HasActionableUpdate, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                    ToolTipService.ToolTip="Open an interactive CLI terminal session">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE756;" FontSize="12" />
                                                    <TextBlock Text="Launch CLI" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Everything else lives behind "…". -->
                                            <Button Padding="8,6" CornerRadius="4"
                                                    ToolTipService.ToolTip="More actions"
                                                    AutomationProperties.Name="More actions for this tool">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Check updates"
                                                                        Click="CheckSingleToolUpdate_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE72C;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding PinMenuText}"
                                                                        Click="PinVersion_Click"
                                                                        IsEnabled="{Binding HasDetectedVersion}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE718;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding IgnoreUpdateMenuText}"
                                                                        Click="IgnoreUpdate_Click"
                                                                        Visibility="{Binding CanToggleUpdateIgnore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8D8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Open installation folder"
                                                                        Click="OpenSingleToolFolder_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE838;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Run CLI health check…"
                                                                        Click="TestCli_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE9D9;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copy executable path"
                                                                        Click="CopyToolPath_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8C8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Open documentation"
                                                                        Click="OpenDoc_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8A7;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Uninstall…"
                                                                        Click="Remove_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- ══════════════════════════════════ -->
                    <!--  EMPTY STATE                       -->
                    <!-- ══════════════════════════════════ -->
                    <appControls:EmptyStateControl
                        x:Name="EmptyState"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Glyph="&#xE73E;"
                        Title="No deployed tools detected"
                        Message="Tools you download or install will appear here with automatic version tracking and lifecycle management."
                        ActionText="Browse tool catalog"
                        ActionClick="GoToCatalog_Click" />

                    <!-- No rows match the current filter -->
                    <appControls:EmptyStateControl
                        x:Name="NoMatchesState"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Glyph="&#xE721;"
                        Title="Nothing matches this filter"
                        Message="No installed tool matches the current filter or search text."
                        ActionText="Clear filters"
                        ActionClick="ClearFilters_Click" />
                </Grid>
            </ScrollViewer>

            <!-- ══════════════════════════════════ -->
            <!--  BULK SELECTION BAR                 -->
            <!-- ══════════════════════════════════ -->
            <!-- Floats over the bottom of the table whenever a row is checked. -->
            <Border Grid.Row="3" x:Name="SelectionBar"
                    Style="{StaticResource SelectionBarStyle}"
                    Margin="0,0,0,10"
                    Translation="0,0,32"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B3;" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SelectionCountText"
                               Text="0 selected"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <Rectangle Width="1" Height="18" Margin="4,0"
                               Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Button x:Name="SelectionUpdateButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="12,6" CornerRadius="4"
                            Click="BulkUpdate_Click"
                            ToolTipService.ToolTip="Install the newer version of every selected tool">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                            <TextBlock Text="Update selected" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SelectionUninstallButton"
                            Padding="12,6" CornerRadius="4"
                            Click="BulkUninstall_Click"
                            ToolTipService.ToolTip="Remove every selected tool from this workstation">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Uninstall selected" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Padding="12,6" CornerRadius="4"
                            Click="SelectionClear_Click"
                            ToolTipService.ToolTip="Deselect every row">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontSize="12" />
                            <TextBlock Text="Clear" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════ -->
            <!--  FOOTER STATUS BAR                 -->
            <!-- ══════════════════════════════════ -->
            <Grid Grid.Row="4" Margin="0,6,32,14" ColumnSpacing="16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Live status: the filter count at rest, or whatever the last
                     action did. Trims rather than pushing the summary off-screen. -->
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="Scanning installed tools…"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Catalog freshness summary. -->
                <TextBlock Grid.Column="1"
                           x:Name="FooterStatusText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </appControls:PageContainer>
</Page>
