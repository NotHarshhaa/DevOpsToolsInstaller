<Page
    x:Class="DevOpsToolsInstaller.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:DevOpsToolsInstaller.Models">

    <Grid Padding="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Installed Tools" Style="{StaticResource PageTitleStyle}" />
                <Border x:Name="InstalledCountBadge" Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                    <TextBlock x:Name="InstalledCountText" Text="Scanning…"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Text="Tools that have been deployed to your workstation, with version info and uninstall actions."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Command bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="Refresh_Click" CornerRadius="4" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" x:Name="StatusText" VerticalAlignment="Center"
                           Margin="4,0,0,0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Button Grid.Column="3" Click="OpenToolsFolder_Click" CornerRadius="4" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                        <TextBlock Text="Open Tools folder" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Installed tools list -->
        <ListView
            x:Name="InstalledList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,2,0,20">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListViewCardStyle}">
                        <Grid ColumnSpacing="12" Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="18"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image Width="28" Height="28" Stretch="Uniform"
                                           Source="{Binding LogoUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                                </Grid>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NameWithVersion}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="Installed" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Grid.Column="2" Text="{Binding Description}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"
                                       VerticalAlignment="Center" />

                            <!-- Remove button -->
                            <Button Grid.Column="3" Click="Remove_Click"
                                    CornerRadius="4" Padding="10,6"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{Binding UninstallLabel}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="{Binding UninstallLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            MaxWidth="380"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE73E;" FontSize="36"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />

            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="No deployed tools detected"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Tools you download and extract will appear here so you can easily manage or remove them."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13" />
            </StackPanel>

            <Button Content="Browse Tool Catalog"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="GoToCatalog_Click"
                    Padding="16,8" />
        </StackPanel>
    </Grid>
</Page>
