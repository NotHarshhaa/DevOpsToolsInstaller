<Page
    x:Class="DevOpsToolsInstaller.Views.CloudDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:appControls="using:DevOpsToolsInstaller.Controls"
    xmlns:services="using:DevOpsToolsInstaller.Services">

    <appControls:PageContainer>
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <appControls:PageHeader Grid.Row="0"
                                    Title="Cloud Connections &amp; Contexts"
                                    Subtitle="Monitor local AWS, Azure, and GCP CLI login states, and switch Kubernetes contexts in one click (like kubectx).">
                <appControls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Click="Refresh_Click"
                                AutomationProperties.Name="Refresh cloud connections">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </appControls:PageHeader.ActionsContent>
            </appControls:PageHeader>

            <!-- SECURITY & PRIVACY NOTICE -->
            <controls:InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"
                              Margin="0,0,32,0"
                              Title="Local CLI State Only"
                              Message="This dashboard reads local configuration files (~/.aws, ~/.azure, ~/.config/gcloud, ~/.kube/config). It never transmits credentials, tokens, or private secrets over the network." />

            <!-- CONTENT BODY -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,32,24">
                <StackPanel Spacing="20">

                    <!-- 1. KUBERNETES & KUBECTX SECTION -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CustomAccentSubtleBrush}">
                                        <Image x:Name="KubeLogoImage" Width="22" Height="22" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Source>
                                                <SvgImageSource UriSource="ms-appx:///Assets/logos/kubectl.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Kubernetes Contexts (kubectx)" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="KubeStatusSubtitle" Text="Scanning kubeconfig..."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="KubeActiveBadge"
                                        Background="{ThemeResource CustomAccentSubtleBrush}"
                                        CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="KubeActiveBadgeText" Text="No Context"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <!-- Active Context Overview -->
                            <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                  CornerRadius="8" Padding="14,10" ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ACTIVE CONTEXT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="KubeActiveContextText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CLUSTER" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="KubeClusterText" Text="—" Style="{StaticResource BodyTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NAMESPACE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="KubeNamespaceText" Text="default" Style="{StaticResource BodyTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Contexts List & Quick Switcher -->
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Available Contexts — Click to Switch (like kubectx):"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="KubeSearchBox"
                                             PlaceholderText="Filter contexts..."
                                             TextChanged="KubeSearchBox_TextChanged"
                                             FontSize="12" />
                                </Grid>

                                <ListView x:Name="KubeContextsList"
                                          MaxHeight="260"
                                          SelectionMode="None"
                                          IsItemClickEnabled="False">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="services:KubeContextInfo">
                                            <Grid Padding="8,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="14"
                                                          Visibility="{x:Bind ActiveVisibility, Mode=OneWay}"
                                                          Foreground="{ThemeResource CustomAccentPrimaryBrush}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="Cluster: " /><Run Text="{x:Bind Cluster}" /><Run Text="  |  Namespace: " /><Run Text="{x:Bind Namespace}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="{x:Bind SwitchButtonText, Mode=OneWay}"
                                                        IsEnabled="{x:Bind CanSwitch, Mode=OneWay}"
                                                        Tag="{x:Bind Name}"
                                                        Click="SwitchContext_Click"
                                                        FontSize="11" Padding="10,4" CornerRadius="4"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. CLOUD PROVIDERS GRID (AWS, AZURE, GCP) -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- AWS CARD -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="#1AEC7211">
                                            <Image x:Name="AwsLogoImage" Width="20" Height="20" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/logos/awscli.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="AWS CLI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="AwsStatusBadge" Text="Checking..." FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Grid>
                                        <TextBlock Text="Active Profile:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AwsProfileText" Text="default" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Region:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AwsRegionText" Text="—" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Credentials:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AwsAccountSummaryText" Text="—" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Button x:Name="AwsLoginButton" Click="AwsLogin_Click"
                                        HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE756;" FontSize="11" />
                                        <TextBlock Text="AWS SSO Login" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- AZURE CARD -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="#1A0078D4">
                                            <Image x:Name="AzureLogoImage" Width="20" Height="20" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/logos/azure-cli.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Azure CLI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="AzureStatusBadge" Text="Checking..." FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Grid>
                                        <TextBlock Text="Account:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AzureAccountText" Text="—" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Subscription:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AzureSubscriptionText" Text="—" FontSize="12"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Environment:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AzureEnvText" Text="AzureCloud" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Button x:Name="AzureLoginButton" Click="AzureLogin_Click"
                                        HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE756;" FontSize="11" />
                                        <TextBlock Text="Azure Login (az login)" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- GCP CARD -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="#1A4285F4">
                                            <Image x:Name="GcpLogoImage" Width="20" Height="20" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/logos/gcloud-cli.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Google Cloud SDK" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="GcpStatusBadge" Text="Checking..." FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Grid>
                                        <TextBlock Text="Account:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="GcpAccountText" Text="—" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Project ID:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="GcpProjectText" Text="—" FontSize="12"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Zone:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="GcpZoneText" Text="—" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Button x:Name="GcpLoginButton" Click="GcpLogin_Click"
                                        HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE756;" FontSize="11" />
                                        <TextBlock Text="GCloud Login" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </appControls:PageContainer>
</Page>
