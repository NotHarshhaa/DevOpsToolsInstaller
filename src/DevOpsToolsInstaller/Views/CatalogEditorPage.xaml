<Page
    x:Class="DevOpsToolsInstaller.Views.CatalogEditorPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:appControls="using:DevOpsToolsInstaller.Controls"
    xmlns:helpers="using:DevOpsToolsInstaller.Helpers">

    <Page.Resources>
        <!-- Inline, per-field validation message. Collapsed until a field is invalid. -->
        <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <appControls:PageContainer>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <appControls:PageHeader Grid.Row="0"
                                    Title="Custom Tools &amp; Catalog Editor"
                                    Subtitle="Add your own HTTPS-hosted tools to the catalog. Custom entries flow through the same SHA-256 and Authenticode pipeline as the shipped catalog." />

            <controls:InfoBar x:Name="NoticeInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                              Severity="Success" AutomationProperties.Name="Catalog editor status message" />

            <!-- Two columns, edge to edge: the form fills the left column so the
                 list never floats away from it on wide windows. -->
            <Grid Grid.Row="2" ColumnSpacing="16" x:Name="EditorLayoutGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FormColumn" Width="*" MinWidth="300" />
                    <ColumnDefinition x:Name="SideColumn" Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FormRow" Height="*" />
                    <RowDefinition x:Name="SideRow" Height="0" />
                </Grid.RowDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="LayoutStates">
                        <!-- Narrow: stack the form above the preview + list, full width. -->
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="FormColumn.Width" Value="*" />
                                <Setter Target="SideColumn.Width" Value="0" />
                                <Setter Target="FormRow.Height" Value="*" />
                                <Setter Target="SideRow.Height" Value="*" />
                                <Setter Target="EditorScroll.(Grid.Row)" Value="0" />
                                <Setter Target="EditorScroll.(Grid.Column)" Value="0" />
                                <Setter Target="EditorScroll.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                                <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                                <Setter Target="SidePanel.(Grid.ColumnSpan)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                        <!-- Wide: form on the left, preview + list in the right column. -->
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="FormColumn.Width" Value="*" />
                                <Setter Target="SideColumn.Width" Value="380" />
                                <Setter Target="FormRow.Height" Value="*" />
                                <Setter Target="SideRow.Height" Value="0" />
                                <Setter Target="EditorScroll.(Grid.Row)" Value="0" />
                                <Setter Target="EditorScroll.(Grid.Column)" Value="0" />
                                <Setter Target="EditorScroll.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="SidePanel.(Grid.Row)" Value="0" />
                                <Setter Target="SidePanel.(Grid.Column)" Value="1" />
                                <Setter Target="SidePanel.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- EDITOR -->
                <ScrollViewer x:Name="EditorScroll" Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Tool definition" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: id · display name -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBox x:Name="IdBox" Header="Tool id *"
                                                 PlaceholderText="my-tool"
                                                 TextChanged="IdBox_TextChanged"
                                                 AutomationProperties.Name="Custom tool id" />
                                        <TextBlock x:Name="IdError" Style="{StaticResource FieldErrorStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBox x:Name="NameBox" Header="Display name *"
                                                 PlaceholderText="My Tool"
                                                 TextChanged="NameBox_TextChanged"
                                                 AutomationProperties.Name="Custom tool name" />
                                        <TextBlock x:Name="NameError" Style="{StaticResource FieldErrorStyle}" />
                                    </StackPanel>

                                    <!-- Row 1: category (editable) · version -->
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <ComboBox x:Name="CategoryBox" Header="Category *"
                                                  IsEditable="True"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="Pick a category or type a new one"
                                                  SelectionChanged="CategoryBox_SelectionChanged"
                                                  LostFocus="CategoryBox_LostFocus"
                                                  AutomationProperties.Name="Custom tool category" />
                                        <TextBlock x:Name="CategoryError" Style="{StaticResource FieldErrorStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBox x:Name="VersionBox" Header="Version"
                                                 PlaceholderText="1.0.0"
                                                 TextChanged="VersionBox_TextChanged"
                                                 AutomationProperties.Name="Custom tool version" />
                                    </StackPanel>

                                    <!-- Row 2: artifact kind · launch args -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <ComboBox x:Name="KindBox" Header="Artifact kind *"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Custom tool artifact kind"
                                                  SelectionChanged="KindBox_SelectionChanged">
                                            <ComboBoxItem Content="Installer (.exe/.msi)" Tag="Installer" IsSelected="True" />
                                            <ComboBoxItem Content="Archive (.zip/.tar.gz)" Tag="Archive" />
                                            <ComboBoxItem Content="Binary (.exe)" Tag="Binary" />
                                            <ComboBoxItem Content="Script (.ps1)" Tag="Script" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBox x:Name="LaunchArgsBox" Header="Launch args"
                                                 PlaceholderText="Optional installer arguments"
                                                 AutomationProperties.Name="Custom tool launch arguments" />
                                    </StackPanel>

                                    <!-- Row 3: file name (auto-suggested) · homepage -->
                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <TextBox x:Name="FileNameBox" Header="File name *"
                                                 PlaceholderText="my-tool-1.0.0.exe"
                                                 TextChanged="FileNameBox_TextChanged"
                                                 AutomationProperties.Name="Custom tool file name" />
                                        <HyperlinkButton x:Name="UseSuggestedNameLink"
                                                         Padding="0" FontSize="12"
                                                         Margin="0,2,0,0"
                                                         Visibility="Collapsed"
                                                         Click="UseSuggestedName_Click"
                                                         AutomationProperties.Name="Use the suggested file name" />
                                        <TextBlock x:Name="FileNameError" Style="{StaticResource FieldErrorStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="1">
                                        <TextBox x:Name="HomepageBox" Header="Homepage"
                                                 PlaceholderText="https://example.com"
                                                 TextChanged="HomepageBox_TextChanged"
                                                 AutomationProperties.Name="Custom tool homepage" />
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="DescriptionBox" Header="Description"
                                         PlaceholderText="What does this tool do?"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                         TextChanged="DescriptionBox_TextChanged"
                                         AutomationProperties.Name="Custom tool description" />

                                <StackPanel>
                                    <TextBox x:Name="DownloadUrlBox" Header="Download URL * (HTTPS only)"
                                             PlaceholderText="https://github.com/owner/repo/releases/download/v1.0.0/tool.zip"
                                             TextChanged="DownloadUrlBox_TextChanged"
                                             AutomationProperties.Name="Custom tool download URL" />
                                    <TextBlock x:Name="UrlError" Style="{StaticResource FieldErrorStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBox x:Name="Sha256Box" Header="SHA-256 (recommended)"
                                             PlaceholderText="64 hex characters — recommended for integrity verification"
                                             TextChanged="Sha256Box_TextChanged"
                                             AutomationProperties.Name="Custom tool SHA-256" />
                                    <TextBlock x:Name="ShaError" Style="{StaticResource FieldErrorStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                        <Button x:Name="ComputeShaButton" Click="ComputeSha_Click"
                                                AutomationProperties.Name="Compute SHA-256 from the download URL">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="13" />
                                                <TextBlock Text="Compute SHA-256 from URL" />
                                            </StackPanel>
                                        </Button>
                                        <ProgressRing x:Name="ComputeShaProgress" Width="20" Height="20"
                                                      IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ComputeShaStatus" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Downloading to hash it proves the bytes are unchanged later — it does not make an unauthentic file authentic. The Authenticode signature check still runs at install time and is never skipped."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>

                                <TextBox x:Name="LogoUrlBox" Header="Logo URL (optional)"
                                         PlaceholderText="https://example.com/logo.svg"
                                         TextChanged="LogoUrlBox_TextChanged"
                                         AutomationProperties.Name="Custom tool logo URL" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="Save_Click" Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.Name="Save custom tool">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                            <TextBlock Text="Save tool" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Clear_Click" AutomationProperties.Name="Clear the editor form">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE894;" FontSize="13" />
                                            <TextBlock Text="New / Clear" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteButton" Click="Delete_Click" IsEnabled="False"
                                            AutomationProperties.Name="Delete selected custom tool">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Validation: the id must be lower-case (letters, digits, '-', '.', '_'); the download URL must be HTTPS; a 64-character SHA-256 is strongly recommended so downloads are integrity-checked."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- SIDEBAR: live preview + the user's custom tools -->
                <Grid x:Name="SidePanel" Grid.Column="1" Grid.Row="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- LIVE PREVIEW -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="Live preview" Style="{StaticResource SectionHeaderStyle}" />

                        <Border Style="{StaticResource ToolCardStyle}">
                            <Grid Padding="14,12" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: logo · name/vendor -->
                                <Grid Grid.Row="0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <FontIcon x:Name="PreviewGlyph" Glyph="&#xE74C;" FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="PreviewLogo" Width="24" Height="24" Stretch="Uniform"
                                                   Visibility="Collapsed"
                                                   ImageFailed="PreviewLogo_ImageFailed" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="PreviewName" Text="Tool name"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="PreviewVendor" Text="Custom source"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="PreviewDescription" Grid.Row="1"
                                           Text="What does this tool do?"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <TextBlock x:Name="PreviewCategory" Text="Uncategorised" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeStyle}">
                                        <TextBlock x:Name="PreviewKind" Text="Installer" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource BadgeStyle}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8EC;" FontSize="10"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="PreviewVersion" Text="v1.0.0" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="1" IsHitTestVisible="False"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Padding="12,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            <TextBlock Text="Install" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="This is how the card will look in the catalog."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- CUSTOM TOOLS LIST -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Text="Your custom tools" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ImportFeed_Click" AutomationProperties.Name="Import custom tools from JSON">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                                    <TextBlock Text="Import" />
                                </StackPanel>
                            </Button>
                            <Button Click="ExportFeed_Click" AutomationProperties.Name="Export custom tools as JSON">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE898;" FontSize="12" />
                                    <TextBlock Text="Export feed" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListView x:Name="CustomToolsList" SelectionMode="Single"
                                  SelectionChanged="CustomToolsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListViewCardStyle}" helpers:Motion.HoverLift="True">
                                        <Grid Padding="14,10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8F1;" FontSize="16" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource CustomAccentPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Id}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <appControls:EmptyStateControl x:Name="CustomToolsEmpty"
                                                       Glyph="&#xE70F;"
                                                       Title="No custom tools yet"
                                                       Message="Fill in the form to add your own HTTPS-hosted tool — it flows through the same SHA-256 and signature pipeline as the official catalog."
                                                       ActionText="Import from JSON…"
                                                       ActionClick="ImportFeed_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </appControls:PageContainer>
</Page>
