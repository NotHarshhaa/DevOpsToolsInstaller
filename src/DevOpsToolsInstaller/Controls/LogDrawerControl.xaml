<UserControl
    x:Class="DevOpsToolsInstaller.Controls.LogDrawerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:DevOpsToolsInstaller.ViewModels">

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Resize Grip -->
                <RowDefinition Height="Auto" />
                <!-- Toolbar / Controls -->
                <RowDefinition Height="Auto" />
                <!-- Virtualized Log List -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  RESIZE GRIP                                    -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border x:Name="ResizeGrip"
                    Grid.Row="0"
                    Height="8"
                    Background="Transparent"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    PointerPressed="ResizeGrip_PointerPressed"
                    PointerMoved="ResizeGrip_PointerMoved"
                    PointerReleased="ResizeGrip_PointerReleased"
                    PointerCaptureLost="ResizeGrip_PointerCaptureLost"
                    PointerEntered="ResizeGrip_PointerEntered"
                    PointerExited="ResizeGrip_PointerExited"
                    AutomationProperties.Name="Resize log drawer height">
                <Border Width="48" Height="3"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  DRAWER TOOLBAR                                 -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Padding="14,2,14,8" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Left: Title & Summary -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Middle: Level Segmented & Search -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Actions -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource CustomAccentPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Live Logs" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    <Border Style="{StaticResource BadgeStyle}" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.HeaderSummaryText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Middle: Level Filter Segmented & Search Box -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <tk:Segmented x:Name="LevelSegmented"
                                  Padding="0,1,0,1"
                                  VerticalAlignment="Center">
                        <tk:SegmentedItem Content="All" Tag="All" IsSelected="True" />
                        <tk:SegmentedItem Content="Info" Tag="Info" />
                        <tk:SegmentedItem Content="Warnings" Tag="Warning" />
                        <tk:SegmentedItem Content="Errors" Tag="Error" />
                    </tk:Segmented>

                    <AutoSuggestBox x:Name="LogSearchBox"
                                    Width="200"
                                    PlaceholderText="Filter events..."
                                    QueryIcon="Find"
                                    TextChanged="LogSearchBox_TextChanged"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Filter log events" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Auto-scroll Toggle -->
                    <ToggleButton x:Name="AutoScrollToggle"
                                  IsChecked="{x:Bind ViewModel.IsAutoScrollEnabled, Mode=TwoWay}"
                                  Click="AutoScrollToggle_Click"
                                  ToolTipService.ToolTip="Auto-scroll to latest entries (uncheck to pause)"
                                  AutomationProperties.Name="Pause auto-scroll">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE898;" FontSize="11" />
                            <TextBlock Text="{x:Bind GetAutoScrollLabel(ViewModel.IsAutoScrollEnabled), Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Copy Logs -->
                    <Button x:Name="CopyLogsButton"
                            Click="CopyLogs_Click"
                            ToolTipService.ToolTip="Copy filtered logs to clipboard"
                            AutomationProperties.Name="Copy log messages">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                            <TextBlock Text="Copy" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Clear Logs -->
                    <Button x:Name="ClearLogsButton"
                            Click="ClearLogs_Click"
                            ToolTipService.ToolTip="Clear activity log history"
                            AutomationProperties.Name="Clear activity logs">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                            <TextBlock Text="Clear" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Collapse Button -->
                    <Button x:Name="CollapseDrawerButton"
                            Click="CollapseDrawer_Click"
                            ToolTipService.ToolTip="Collapse log drawer (Ctrl+`)"
                            AutomationProperties.Name="Collapse log drawer">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  LOG LIST (VIRTUALIZED)                         -->
            <!-- ═══════════════════════════════════════════════ -->
            <ListView x:Name="LogListView"
                      Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="12,0,12,8"
                      Background="{ThemeResource LayerFillColorAltBrush}"
                      AutomationProperties.Name="Live log event list">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:LogEntryItemViewModel">
                        <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind AutomationName}">
                            <Grid.ColumnDefinitions>
                                <!-- Timestamp -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Level Badge -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Tool Tag -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Message -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Timestamp -->
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind TimeLabel}"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Level Badge -->
                            <Border Grid.Column="1"
                                    Background="{x:Bind SeverityBadgeBackground, Mode=OneWay}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    MinWidth="36">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind SeverityGlyph}"
                                              FontSize="9"
                                              Foreground="{x:Bind SeverityBadgeForeground, Mode=OneWay}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind SeverityBadgeText}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{x:Bind SeverityBadgeForeground, Mode=OneWay}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Tool Tag -->
                            <Border Grid.Column="2"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ToolName}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <!-- Message Content -->
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind Message}"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind Message}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
