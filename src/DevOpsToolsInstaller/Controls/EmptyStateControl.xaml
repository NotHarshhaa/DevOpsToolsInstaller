<UserControl
    x:Class="DevOpsToolsInstaller.Controls.EmptyStateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- A reusable "nothing here yet" placeholder: icon, title, message and an
         optional call-to-action button. Pages toggle Visibility based on whether
         their backing collection is empty. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="460" Spacing="10" Padding="24,32">
        <Border Width="60" Height="60" CornerRadius="30"
                HorizontalAlignment="Center"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <FontIcon x:Name="IconGlyph" Glyph="&#xE7C3;" FontSize="26"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="TitleText" Text="Nothing here yet"
                   Style="{StaticResource SectionHeaderStyle}"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Margin="0,4,0,0" />

        <TextBlock x:Name="MessageText" Text=""
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" />

        <Button x:Name="ActionButton" Click="ActionButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center" Margin="0,6,0,0"
                Visibility="Collapsed" />
    </StackPanel>
</UserControl>
