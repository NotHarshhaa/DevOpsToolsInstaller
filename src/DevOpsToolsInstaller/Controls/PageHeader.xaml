<UserControl
    x:Class="DevOpsToolsInstaller.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- Shared page header: title, optional count badge, optional subtitle and
         optional right-aligned actions. Below the wide breakpoint the actions
         drop onto their own row so nothing is squeezed out on narrow windows. -->
    <Grid x:Name="HeaderGrid" ColumnSpacing="16" RowSpacing="0" Margin="0,0,32,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderLayoutStates">
                <!-- Narrow: actions move to their own row, left aligned. -->
                <VisualState x:Name="NarrowHeader">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionsHost.(Grid.Row)" Value="1" />
                        <Setter Target="ActionsHost.(Grid.Column)" Value="0" />
                        <Setter Target="ActionsHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ActionsHost.HorizontalAlignment" Value="Left" />
                        <Setter Target="ActionsHost.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Wide: actions sit inline to the right of the title. -->
                <VisualState x:Name="WideHeader">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="780" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionsHost.(Grid.Row)" Value="0" />
                        <Setter Target="ActionsHost.(Grid.Column)" Value="1" />
                        <Setter Target="ActionsHost.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ActionsHost.HorizontalAlignment" Value="Right" />
                        <Setter Target="ActionsHost.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Page title"
                           Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Border x:Name="BadgeBorder" Style="{StaticResource BadgeStyle}"
                        VerticalAlignment="Center" Padding="8,3" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeTextBlock" Text=""
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <TextBlock x:Name="SubtitleText" Text=""
                       Style="{StaticResource PageSubtitleStyle}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <ContentPresenter x:Name="ActionsHost"
                          Grid.Row="0" Grid.Column="1"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</UserControl>
