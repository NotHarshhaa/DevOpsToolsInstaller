<Window
    x:Class="DevOpsToolsInstaller.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <!-- Lightweight startup splash: borderless, centered, closed as soon as
         the main window activates. Static content (no motion) so it is safe
         under the "reduce animations" setting. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <Border Width="96" Height="96" CornerRadius="20"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" HorizontalAlignment="Center">
                <Image x:Name="SplashLogo" Width="64" Height="64" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="DevOps Tools Installer" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Preparing your workstation toolbox…"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <ProgressRing Width="28" Height="28" IsActive="True" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
