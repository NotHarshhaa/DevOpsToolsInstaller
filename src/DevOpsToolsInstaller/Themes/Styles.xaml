<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Standard Native Windows 11 / Fluent Design System.
        Uses clean system theme resources for an authentic Windows desktop application appearance.
        All glowing borders, neon badge tints, and non-standard colors have been neutralized.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Neutral Windows Theme brushes (Dark) -->
            <SolidColorBrush x:Key="CustomAccentPrimaryBrush" Color="#1F6FEB" />
            <SolidColorBrush x:Key="CustomAccentHoverBrush" Color="#388BFD" />
            <SolidColorBrush x:Key="CustomAccentPressedBrush" Color="#1158C7" />
            <SolidColorBrush x:Key="CustomAccentForegroundBrush" Color="#FFFFFF" />

            <!-- Neutral Tags & Badges -->
            <SolidColorBrush x:Key="CustomAccentBadgeBackgroundBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="CustomAccentBadgeBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="CustomAccentBadgeTextBrush" Color="#D1D5DB" />

            <SolidColorBrush x:Key="CustomNeutralBadgeBackgroundBrush" Color="#262626" />
            <SolidColorBrush x:Key="CustomNeutralBadgeBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="CustomNeutralBadgeTextBrush" Color="#9CA3AF" />

            <SolidColorBrush x:Key="CustomSuccessBadgeBackgroundBrush" Color="#262626" />
            <SolidColorBrush x:Key="CustomSuccessBadgeBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="CustomSuccessBadgeTextBrush" Color="#D1D5DB" />

            <SolidColorBrush x:Key="CustomWarningBadgeBackgroundBrush" Color="#262626" />
            <SolidColorBrush x:Key="CustomWarningBadgeBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="CustomWarningBadgeTextBrush" Color="#D1D5DB" />

            <SolidColorBrush x:Key="CustomHeroBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="CustomGlowBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="CustomGlassBackgroundBrush" Color="#242424" />
            <SolidColorBrush x:Key="CustomHeroGradientBrush" Color="#242424" />

            <!-- Neutral Stat icon backgrounds -->
            <SolidColorBrush x:Key="StatIconBlueBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="StatIconGreenBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="StatIconAmberBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="StatIconPurpleBrush" Color="#2A2A2A" />

            <!-- Step card borders -->
            <SolidColorBrush x:Key="StepOneBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="StepTwoBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="StepThreeBorderBrush" Color="#383838" />

            <!-- Download status stripes -->
            <SolidColorBrush x:Key="DownloadStripeIdleBrush" Color="#383838" />
            <SolidColorBrush x:Key="DownloadStripeActiveBrush" Color="#1F6FEB" />
            <SolidColorBrush x:Key="DownloadStripeDoneBrush" Color="#383838" />
            <SolidColorBrush x:Key="DownloadStripeErrorBrush" Color="#E5484D" />

            <SolidColorBrush x:Key="SectionAccentLineBrush" Color="#383838" />

            <!-- Redesigned Catalog Glowing Brushes (Dark) -->
            <SolidColorBrush x:Key="CatalogCardBackgroundBrush" Color="#131924" />
            <SolidColorBrush x:Key="CatalogCardBorderCyanBrush" Color="#00D2FF" />
            <SolidColorBrush x:Key="CatalogCardBorderPurpleBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="CatalogCategoryPillBackgroundBrush" Color="#1A2333" />
            <SolidColorBrush x:Key="CatalogCategoryPillBorderBrush" Color="#2A374E" />
            <SolidColorBrush x:Key="CatalogCategoryPillForegroundBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="CatalogInstallButtonBackgroundBrush" Color="#00D2FF" />
            <SolidColorBrush x:Key="CatalogInstallButtonForegroundBrush" Color="#07151E" />
            <SolidColorBrush x:Key="CatalogInstallButtonHoverBrush" Color="#38E1FF" />
            <SolidColorBrush x:Key="CatalogInstalledButtonBackgroundBrush" Color="#25183E" />
            <SolidColorBrush x:Key="CatalogInstalledButtonBorderBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="CatalogInstalledButtonForegroundBrush" Color="#C084FC" />
            <SolidColorBrush x:Key="CatalogInstalledButtonHoverBrush" Color="#332152" />
            <SolidColorBrush x:Key="CatalogVersionForegroundBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="CatalogCubeGlyphCyanBrush" Color="#00D2FF" />
            <SolidColorBrush x:Key="CatalogCubeGlyphPurpleBrush" Color="#C084FC" />
            <SolidColorBrush x:Key="CatalogFooterForegroundBrush" Color="#64748B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Neutral Windows Theme brushes (Light) -->
            <SolidColorBrush x:Key="CustomAccentPrimaryBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="CustomAccentHoverBrush" Color="#1975C5" />
            <SolidColorBrush x:Key="CustomAccentPressedBrush" Color="#005BA1" />
            <SolidColorBrush x:Key="CustomAccentForegroundBrush" Color="#FFFFFF" />

            <!-- Neutral Tags & Badges -->
            <SolidColorBrush x:Key="CustomAccentBadgeBackgroundBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="CustomAccentBadgeBorderBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="CustomAccentBadgeTextBrush" Color="#4B5563" />

            <SolidColorBrush x:Key="CustomNeutralBadgeBackgroundBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="CustomNeutralBadgeBorderBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="CustomNeutralBadgeTextBrush" Color="#6B7280" />

            <SolidColorBrush x:Key="CustomSuccessBadgeBackgroundBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="CustomSuccessBadgeBorderBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="CustomSuccessBadgeTextBrush" Color="#4B5563" />

            <SolidColorBrush x:Key="CustomWarningBadgeBackgroundBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="CustomWarningBadgeBorderBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="CustomWarningBadgeTextBrush" Color="#4B5563" />

            <SolidColorBrush x:Key="CustomHeroBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="CustomGlowBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="CustomGlassBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CustomHeroGradientBrush" Color="#F9F9F9" />

            <!-- Neutral Stat icon backgrounds -->
            <SolidColorBrush x:Key="StatIconBlueBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="StatIconGreenBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="StatIconAmberBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="StatIconPurpleBrush" Color="#F3F3F3" />

            <!-- Step card borders -->
            <SolidColorBrush x:Key="StepOneBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="StepTwoBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="StepThreeBorderBrush" Color="#E5E5E5" />

            <!-- Download status stripes -->
            <SolidColorBrush x:Key="DownloadStripeIdleBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="DownloadStripeActiveBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="DownloadStripeDoneBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="DownloadStripeErrorBrush" Color="#C42B1C" />

            <SolidColorBrush x:Key="SectionAccentLineBrush" Color="#E5E5E5" />

            <!-- Redesigned Catalog Glowing Brushes (Light) -->
            <SolidColorBrush x:Key="CatalogCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CatalogCardBorderCyanBrush" Color="#0284C7" />
            <SolidColorBrush x:Key="CatalogCardBorderPurpleBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="CatalogCategoryPillBackgroundBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="CatalogCategoryPillBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="CatalogCategoryPillForegroundBrush" Color="#475569" />
            <SolidColorBrush x:Key="CatalogInstallButtonBackgroundBrush" Color="#0284C7" />
            <SolidColorBrush x:Key="CatalogInstallButtonForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CatalogInstallButtonHoverBrush" Color="#0369A1" />
            <SolidColorBrush x:Key="CatalogInstalledButtonBackgroundBrush" Color="#F3E8FF" />
            <SolidColorBrush x:Key="CatalogInstalledButtonBorderBrush" Color="#A855F7" />
            <SolidColorBrush x:Key="CatalogInstalledButtonForegroundBrush" Color="#7E22CE" />
            <SolidColorBrush x:Key="CatalogInstalledButtonHoverBrush" Color="#E9D5FF" />
            <SolidColorBrush x:Key="CatalogVersionForegroundBrush" Color="#64748B" />
            <SolidColorBrush x:Key="CatalogCubeGlyphCyanBrush" Color="#0284C7" />
            <SolidColorBrush x:Key="CatalogCubeGlyphPurpleBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="CatalogFooterForegroundBrush" Color="#64748B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  CARD STYLES (Standard Native Windows 11)                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Standard content card -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Hero Card -->
    <Style x:Key="HeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- Glass card fallback -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Stat tile card -->
    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Step card -->
    <Style x:Key="StepCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- List item card -->
    <Style x:Key="ListViewCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Download item card -->
    <Style x:Key="DownloadItemCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Quick action navigation card -->
    <Style x:Key="QuickActionCardStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  TEXT STYLES                                                -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MetricNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  BADGE STYLES (Subtle Windows Tags)                         -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SuccessBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WarningBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  BUTTON & FILTER STYLES                                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="QuickLinkButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Standard category filter button (Unselected) -->
    <Style x:Key="CategoryChipStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Standard category filter button (Selected) -->
    <Style x:Key="SelectedCategoryChipStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  REDESIGNED TOOL CATALOG CARD BUTTON STYLES                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Vibrant Install Button (Solid Cyan in Dark, Solid Azure in Light) -->
    <Style x:Key="CatalogInstallButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CatalogInstallButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CatalogInstallButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Muted Violet Installed Button (Purple pill matching screenshot) -->
    <Style x:Key="CatalogInstalledButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CatalogInstalledButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CatalogInstalledButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CatalogInstalledButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
