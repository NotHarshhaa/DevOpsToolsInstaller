<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Modern Windows 11 / Fluent 2 Design System.
        Trending Windows & cross-platform workstation styles:
        - Harmonious semantic pill tags with soft translucent tints and crisp micro-borders
        - Layered cards with refined 10px-12px corner radii and subtle elevation outlines
        - Distinctive stat widget containers with modern iconography
        - Smooth pill filter chips and spotlight-style command palettes
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Accent follows the user's Windows accent color (native Win11 behavior).
                 Dark theme: hover lightens, pressed darkens. -->
            <SolidColorBrush x:Key="CustomAccentPrimaryBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="CustomAccentHoverBrush" Color="{ThemeResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="CustomAccentPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="CustomAccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CustomAccentSubtleBrush" Color="#220078D4" />

            <!-- Trending Semantic Badges & Chips (Dark) -->
            <SolidColorBrush x:Key="CustomAccentBadgeBackgroundBrush" Color="#162842" />
            <SolidColorBrush x:Key="CustomAccentBadgeBorderBrush" Color="#254570" />
            <SolidColorBrush x:Key="CustomAccentBadgeTextBrush" Color="#60A5FA" />

            <SolidColorBrush x:Key="CustomNeutralBadgeBackgroundBrush" Color="#21252E" />
            <SolidColorBrush x:Key="CustomNeutralBadgeBorderBrush" Color="#343B4A" />
            <SolidColorBrush x:Key="CustomNeutralBadgeTextBrush" Color="#94A3B8" />

            <SolidColorBrush x:Key="CustomSuccessBadgeBackgroundBrush" Color="#142C1F" />
            <SolidColorBrush x:Key="CustomSuccessBadgeBorderBrush" Color="#225338" />
            <SolidColorBrush x:Key="CustomSuccessBadgeTextBrush" Color="#4ADE80" />

            <SolidColorBrush x:Key="CustomWarningBadgeBackgroundBrush" Color="#2F220B" />
            <SolidColorBrush x:Key="CustomWarningBadgeBorderBrush" Color="#5A3F13" />
            <SolidColorBrush x:Key="CustomWarningBadgeTextBrush" Color="#FBBF24" />

            <SolidColorBrush x:Key="CustomPurpleBadgeBackgroundBrush" Color="#251838" />
            <SolidColorBrush x:Key="CustomPurpleBadgeBorderBrush" Color="#462B6D" />
            <SolidColorBrush x:Key="CustomPurpleBadgeTextBrush" Color="#C084FC" />

            <SolidColorBrush x:Key="CustomHeroBorderBrush" Color="#384050" />
            <SolidColorBrush x:Key="CustomGlowBorderBrush" Color="#2D3B55" />
            <SolidColorBrush x:Key="CustomGlassBackgroundBrush" Color="#232733" />
            <SolidColorBrush x:Key="CustomHeroGradientBrush" Color="#252834" />

            <!-- Modern Stat icon backgrounds & foregrounds (Dark) -->
            <SolidColorBrush x:Key="StatIconBlueBrush" Color="#162842" />
            <SolidColorBrush x:Key="StatIconBlueFgBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="StatIconGreenBrush" Color="#142C1F" />
            <SolidColorBrush x:Key="StatIconGreenFgBrush" Color="#34D399" />
            <SolidColorBrush x:Key="StatIconAmberBrush" Color="#2F220B" />
            <SolidColorBrush x:Key="StatIconAmberFgBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="StatIconPurpleBrush" Color="#251838" />
            <SolidColorBrush x:Key="StatIconPurpleFgBrush" Color="#C084FC" />

            <!-- Step card borders -->
            <SolidColorBrush x:Key="StepOneBorderBrush" Color="#384050" />
            <SolidColorBrush x:Key="StepTwoBorderBrush" Color="#384050" />
            <SolidColorBrush x:Key="StepThreeBorderBrush" Color="#384050" />

            <!-- Download status stripes -->
            <SolidColorBrush x:Key="DownloadStripeIdleBrush" Color="#383838" />
            <SolidColorBrush x:Key="DownloadStripeActiveBrush" Color="#1F6FEB" />
            <SolidColorBrush x:Key="DownloadStripeDoneBrush" Color="#383838" />
            <SolidColorBrush x:Key="DownloadStripeErrorBrush" Color="#E5484D" />

            <SolidColorBrush x:Key="SectionAccentLineBrush" Color="#384050" />
            <SolidColorBrush x:Key="CustomAccentDividerBrush" Color="#33FFFFFF" />

            <!-- Catalog category row: fades the scrolling chip row into the page
                 background so it reads as scrollable rather than clipped. The
                 opaque stop matches SolidBackgroundFillColorBase for this theme;
                 the transparent stop keeps the same RGB so the blend never
                 produces a grey halo. -->
            <LinearGradientBrush x:Key="ChipEdgeFadeLeftBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#202020" />
                <GradientStop Offset="1" Color="#00202020" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ChipEdgeFadeRightBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00202020" />
                <GradientStop Offset="1" Color="#202020" />
            </LinearGradientBrush>

        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Accent follows the user's Windows accent color (native Win11 behavior).
                 Light theme: hover/pressed darken. -->
            <SolidColorBrush x:Key="CustomAccentPrimaryBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="CustomAccentHoverBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="CustomAccentPressedBrush" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="CustomAccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CustomAccentSubtleBrush" Color="#160078D4" />

            <!-- Trending Semantic Badges & Chips (Light) -->
            <SolidColorBrush x:Key="CustomAccentBadgeBackgroundBrush" Color="#EFF6FF" />
            <SolidColorBrush x:Key="CustomAccentBadgeBorderBrush" Color="#BFDBFE" />
            <SolidColorBrush x:Key="CustomAccentBadgeTextBrush" Color="#1D4ED8" />

            <SolidColorBrush x:Key="CustomNeutralBadgeBackgroundBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="CustomNeutralBadgeBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="CustomNeutralBadgeTextBrush" Color="#475569" />

            <SolidColorBrush x:Key="CustomSuccessBadgeBackgroundBrush" Color="#ECFDF5" />
            <SolidColorBrush x:Key="CustomSuccessBadgeBorderBrush" Color="#A7F3D0" />
            <SolidColorBrush x:Key="CustomSuccessBadgeTextBrush" Color="#15803D" />

            <SolidColorBrush x:Key="CustomWarningBadgeBackgroundBrush" Color="#FFFBEB" />
            <SolidColorBrush x:Key="CustomWarningBadgeBorderBrush" Color="#FDE68A" />
            <SolidColorBrush x:Key="CustomWarningBadgeTextBrush" Color="#B45309" />

            <SolidColorBrush x:Key="CustomPurpleBadgeBackgroundBrush" Color="#FAF5FF" />
            <SolidColorBrush x:Key="CustomPurpleBadgeBorderBrush" Color="#E9D5FF" />
            <SolidColorBrush x:Key="CustomPurpleBadgeTextBrush" Color="#7E22CE" />

            <SolidColorBrush x:Key="CustomHeroBorderBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="CustomGlowBorderBrush" Color="#E0E7FF" />
            <SolidColorBrush x:Key="CustomGlassBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CustomHeroGradientBrush" Color="#F8FAFC" />

            <!-- Modern Stat icon backgrounds & foregrounds (Light) -->
            <SolidColorBrush x:Key="StatIconBlueBrush" Color="#E0F2FE" />
            <SolidColorBrush x:Key="StatIconBlueFgBrush" Color="#0284C7" />
            <SolidColorBrush x:Key="StatIconGreenBrush" Color="#DCFCE7" />
            <SolidColorBrush x:Key="StatIconGreenFgBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="StatIconAmberBrush" Color="#FEF3C7" />
            <SolidColorBrush x:Key="StatIconAmberFgBrush" Color="#D97706" />
            <SolidColorBrush x:Key="StatIconPurpleBrush" Color="#F3E8FF" />
            <SolidColorBrush x:Key="StatIconPurpleFgBrush" Color="#9333EA" />

            <!-- Step card borders -->
            <SolidColorBrush x:Key="StepOneBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="StepTwoBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="StepThreeBorderBrush" Color="#E5E5E5" />

            <!-- Download status stripes -->
            <SolidColorBrush x:Key="DownloadStripeIdleBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="DownloadStripeActiveBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="DownloadStripeDoneBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="DownloadStripeErrorBrush" Color="#C42B1C" />

            <SolidColorBrush x:Key="SectionAccentLineBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="CustomAccentDividerBrush" Color="#33FFFFFF" />

            <!-- Catalog category row edge fades (light theme). -->
            <LinearGradientBrush x:Key="ChipEdgeFadeLeftBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#F3F3F3" />
                <GradientStop Offset="1" Color="#00F3F3F3" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ChipEdgeFadeRightBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00F3F3F3" />
                <GradientStop Offset="1" Color="#F3F3F3" />
            </LinearGradientBrush>

        </ResourceDictionary>

        <!-- High contrast: the page colour is a system colour, so no blending is
             attempted — the scroll buttons carry the "more to the side" cue. -->
        <ResourceDictionary x:Key="HighContrast">
            <LinearGradientBrush x:Key="ChipEdgeFadeLeftBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ChipEdgeFadeRightBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CustomAccentDividerBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CustomAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.2" />

            <SolidColorBrush x:Key="CustomAccentPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CustomAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CustomAccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CustomAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="CustomAccentBadgeBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CustomAccentBadgeBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CustomAccentBadgeTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="CustomNeutralBadgeBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CustomNeutralBadgeBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CustomNeutralBadgeTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="CustomSuccessBadgeBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CustomSuccessBadgeBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CustomSuccessBadgeTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="CustomWarningBadgeBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CustomWarningBadgeBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CustomWarningBadgeTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="CustomPurpleBadgeBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CustomPurpleBadgeBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CustomPurpleBadgeTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="CustomHeroBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CustomGlowBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CustomGlassBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CustomHeroGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="StatIconBlueBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="StatIconBlueFgBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="StatIconGreenBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="StatIconGreenFgBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="StatIconAmberBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="StatIconAmberFgBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="StatIconPurpleBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="StatIconPurpleFgBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="StepOneBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="StepTwoBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="StepThreeBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="DownloadStripeIdleBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DownloadStripeActiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DownloadStripeDoneBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DownloadStripeErrorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SectionAccentLineBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  CARD STYLES (Standard Native Windows 11)                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Standard content card -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Hero Card -->
    <Style x:Key="HeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- Glass card fallback -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Stat tile card -->
    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Step card -->
    <Style x:Key="StepCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- List item card -->
    <Style x:Key="ListViewCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Download item card -->
    <Style x:Key="DownloadItemCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Quick action navigation card -->
    <Style x:Key="QuickActionCardStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  TEXT STYLES                                                -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MetricNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  BADGE STYLES (Trending Modern Pill Tags)                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CustomNeutralBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CustomNeutralBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CustomAccentBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CustomAccentBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SuccessBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CustomSuccessBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CustomSuccessBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WarningBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CustomWarningBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CustomWarningBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PurpleBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CustomPurpleBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CustomPurpleBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CodeBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  BUTTON & FILTER STYLES                                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Split button whose primary action is an accent CTA (e.g. Install on tool and stack cards) -->
    <Style x:Key="AccentSplitButtonStyle" TargetType="SplitButton">
        <Setter Property="Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-1" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SplitButton">
                    <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.Resources>
                            <!-- Inner button style that resets backgrounds and forwards clicks cleanly -->
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid" Background="Transparent">
                                                <ContentPresenter x:Name="ContentPresenter"
                                                                  BorderBrush="Transparent"
                                                                  BorderThickness="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  AutomationProperties.AccessibilityView="Raw" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="{ThemeResource CustomAccentDividerBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Border.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="Transparent" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="Transparent" />
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="FlyoutOpen">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPressedBrush}" />
                                        <Setter Target="Border.BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="{ThemeResource CustomAccentDividerBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="TouchPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPressedBrush}" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPressedBrush}" />
                                        <Setter Target="Border.BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="{ThemeResource CustomAccentDividerBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="PrimaryPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentHoverBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="{ThemeResource CustomAccentDividerBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="PrimaryPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPressedBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="{ThemeResource CustomAccentDividerBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="SecondaryPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentHoverBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="{ThemeResource CustomAccentDividerBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="SecondaryPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
                                        <Setter Target="PrimaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="SecondaryBackgroundGrid.Background" Value="{ThemeResource CustomAccentPressedBrush}" />
                                        <Setter Target="SecondaryButton.Foreground" Value="{ThemeResource CustomAccentForegroundBrush}" />
                                        <Setter Target="DividerBackgroundGrid.Background" Value="{ThemeResource CustomAccentDividerBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SecondaryButtonPlacementStates">
                                <VisualState x:Name="SecondaryButtonRight" />
                                <VisualState x:Name="SecondaryButtonSpan">
                                    <VisualState.Setters>
                                        <Setter Target="SecondaryButton.(Grid.Column)" Value="0" />
                                        <Setter Target="SecondaryButton.(Grid.ColumnSpan)" Value="3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PrimaryButtonColumn" Width="*" MinWidth="32" />
                            <ColumnDefinition x:Name="Separator" Width="1" />
                            <ColumnDefinition x:Name="SecondaryButtonColumn" Width="32" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="PrimaryBackgroundGrid" Background="{ThemeResource CustomAccentPrimaryBrush}" Grid.ColumnSpan="2" CornerRadius="4,0,0,4" />
                        <Grid x:Name="DividerBackgroundGrid" Width="1" Background="{ThemeResource CustomAccentDividerBrush}" Grid.Column="1" />
                        <Grid x:Name="SecondaryBackgroundGrid" Background="{ThemeResource CustomAccentPrimaryBrush}" Grid.Column="2" CornerRadius="0,4,4,0" />

                        <Button x:Name="PrimaryButton" Grid.Column="0"
                                Foreground="{ThemeResource CustomAccentForegroundBrush}"
                                Background="Transparent"
                                BorderThickness="0" BorderBrush="Transparent"
                                Content="{TemplateBinding Content}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                IsTabStop="False"
                                AutomationProperties.AccessibilityView="Raw" />

                        <Button x:Name="SecondaryButton" Grid.Column="2"
                                Foreground="{ThemeResource CustomAccentForegroundBrush}"
                                Background="Transparent"
                                BorderThickness="0" BorderBrush="Transparent"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Padding="0" IsTabStop="False"
                                AutomationProperties.AccessibilityView="Raw">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="8" Glyph="&#xE96E;"
                                      Foreground="{ThemeResource CustomAccentForegroundBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <Grid x:Name="Border" Grid.ColumnSpan="3"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuickLinkButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Standard category filter button (Unselected) -->
    <Style x:Key="CategoryChipStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Standard category filter button (Selected) -->
    <Style x:Key="SelectedCategoryChipStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Sortable table column header. Transparent at rest so it reads as a plain
         label, with the button's own pointer-over fill providing the affordance.
         MinWidth is reset because the default button minimum (120px) would make
         every header cell needlessly wide. -->
    <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="-6,0,0,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  CATALOG TOOL CARDS                                         -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Catalog tool card. Zero padding: the card's own grid owns the spacing so
         the checkbox, description and action row line up across every card. -->
    <Style x:Key="ToolCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Accent ring drawn on top of a card whose checkbox is checked. Kept as a
         separate overlay so selection never re-flows the card contents. -->
    <Style x:Key="ToolCardSelectionRingStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Floating "N selected" action bar pinned to the bottom of the page. -->
    <Style x:Key="SelectionBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FlyoutPresenterBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  FEATURE CARD & QUICK START STEPPER STYLES                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="FeatureCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="FeatureIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="QuickStartStepCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="QuickStartBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{ThemeResource CustomAccentPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
